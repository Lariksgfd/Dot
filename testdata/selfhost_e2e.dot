// testdata/selfhost_e2e.dot — e2e self-hosting test: a Dot program that uses
// std.codegen to generate a complete, gcc-compilable C program and writes it
// to testdata/gen_out.c via std.io.
import std.codegen
import std.io

fn main() {
    b = new_builder()

    bwrite(b, "// generated by testdata/selfhost_e2e.dot via stdlib/codegen.dot\n")
    bwrite(b, "#include <stdio.h>\n")
    bwrite(b, "#include <math.h>\n")
    bwrite(b, "#include <stdint.h>\n")
    bwrite(b, "\n")

    bwrite(b, struct_to_c("DotPoint", []string{"x:float", "y:float"}))
    bwrite(b, "\n\n")

    bwrite(b, fndecl_to_c("add", "int", []string{"a:int", "b:int"}))
    bwrite(b, " {{\n")
    bwrite(b, "    ")
    bwrite(b, retstmt_to_c(binop_to_c("+", "a", "b")))
    bwrite(b, "\n}}\n\n")

    bwrite(b, method_to_c("Point", "distance", "float", []string{"other:Point"}))
    bwrite(b, " {{\n")
    bwrite(b, "    ")
    bwrite(b, vardecl_to_c("dx", "float", binop_to_c("-", "self->x", "other.x")))
    bwrite(b, "\n    ")
    bwrite(b, vardecl_to_c("dy", "float", binop_to_c("-", "self->y", "other.y")))
    bwrite(b, "\n    ")
    bwrite(b, retstmt_to_c("sqrt(" + binop_to_c("+", binop_to_c("*", "dx", "dx"), binop_to_c("*", "dy", "dy")) + ")"))
    bwrite(b, "\n}}\n\n")

    mname = generic_mangle("sum_to", []string{"int"})
    bwrite(b, fndecl_to_c(mname, "int", []string{"n:int"}))
    bwrite(b, " {{\n")
    bwrite(b, "    ")
    bwrite(b, vardecl_to_c("total", "int", "0"))
    bwrite(b, "\n    ")
    bwrite(b, for_to_c("int64_t i = 1", "i <= n", "i += 1", "        total = " + binop_to_c("+", "total", "i") + ";"))
    bwrite(b, "\n    ")
    bwrite(b, retstmt_to_c("total"))
    bwrite(b, "\n}}\n\n")

    bwrite(b, fndecl_to_c("classify", "int", []string{"x:int"}))
    bwrite(b, " {{\n    ")
    bwrite(b, match_to_c("x", "int", []string{"0", "1", "2", "_"}, []string{retstmt_to_c("0"), retstmt_to_c("1"), retstmt_to_c("2"), retstmt_to_c("-1")}))
    bwrite(b, "\n}}\n\n")

    bwrite(b, "int main(void) {{\n")
    bwrite(b, "    DotPoint p = ")
    bwrite(b, struct_literal_to_c("Point", []string{"x", "y"}, []string{"3.0", "4.0"}))
    bwrite(b, ";\n")
    bwrite(b, "    DotPoint q = ")
    bwrite(b, struct_literal_to_c("Point", []string{"x", "y"}, []string{"0.0", "0.0"}))
    bwrite(b, ";\n")
    bwrite(b, "    ")
    bwrite(b, vardecl_to_c("d", "float", "Dot_Point_distance(&p, q)"))
    bwrite(b, "\n    ")
    bwrite(b, vardecl_to_c("m", "int", ifexpr_to_c(binop_to_c(">", "d", "5.0"), "1", "0")))
    bwrite(b, "\n    ")
    bwrite(b, vardecl_to_c("k", "int", literal_to_c("42", "int")))
    bwrite(b, "\n")

    bwrite(b, "    printf(\"add(2,3)=%lld\\n\", (long long)Dot_add(2, 3));\n")
    bwrite(b, "    printf(\"dist=%f\\n\", d);\n")
    bwrite(b, "    printf(\"dist_big=%lld\\n\", (long long)m);\n")
    bwrite(b, "    printf(\"k=%lld\\n\", (long long)k);\n")
    bwrite(b, "    printf(\"sum_to(10)=%lld\\n\", (long long)Dot_")
    bwrite(b, mname)
    bwrite(b, "(")
    bwrite(b, int_to_str(10))
    bwrite(b, "));\n")
    bwrite(b, "    printf(\"classify(0)=%lld\\n\", (long long)Dot_classify(0));\n")
    bwrite(b, "    printf(\"classify(2)=%lld\\n\", (long long)Dot_classify(2));\n")
    bwrite(b, "    printf(\"classify(9)=%lld\\n\", (long long)Dot_classify(9));\n")
    bwrite(b, "    return 0;\n")
    bwrite(b, "}}\n")

    src = bfinish(b)
    f = open("testdata/gen_out.c", "w")
    n = write_all(f, src)
    close(f)
    print("wrote testdata/gen_out.c, bytes=")
    print(int_to_str(n))
    print("\n")
    print(src)
}
