import net.http
import math_utils as mu
from os.fs import read_file, write_file

const MAX_SIZE = 1024
const PI float = 3.14159265358979

struct Point {
    x float
    y float
}

struct User {
    name   string
    email  string
    age    int
    active bool = true
}

struct Dog {
    embed Animal
    breed string
}

struct Stack[T] {
    items []T
}

enum Color {
    Red
    Green
    Blue
}

enum Shape {
    Circle(radius float)
    Rectangle(width float, height float)
}

trait Printable {
    fn to_string(self) -> string
}

trait Comparable {
    fn compare(self, other Self) -> int
    fn less_than(self, other Self) -> bool = self.compare(other) < 0
}

impl Point {
    fn new(x float, y float) -> Point {
        return Point { x, y }
    }

    fn distance(self, other Point) -> float {
        dx = self.x - other.x
        dy = self.y - other.y
        return (dx ** 2 + dy ** 2).sqrt()
    }

    fn translate(mut self, dx float, dy float) {
        self.x += dx
        self.y += dy
    }

    fn origin() -> Point {
        return Point { x: 0.0, y: 0.0 }
    }
}

impl Printable for Point {
    fn to_string(self) -> string = "({self.x}, {self.y})"
}

impl[T] Stack[T] {
    fn push(mut self, item T) {
        self.items.push(item)
    }

    fn pop(mut self) -> Option[T] {
        if self.items.len == 0 {
            return None
        }
        return Some(self.items.remove_last())
    }

    fn is_empty(self) -> bool = self.items.len == 0
}

fn add(a int, b int) -> int {
    return a + b
}

fn double(x int) -> int = x * 2

fn greet(name string) {
    print("Hello, {name}!")
}

fn divide(a float, b float) -> (float, Error?) {
    if b == 0 {
        return 0, Error("division by zero")
    }
    return a / b, nil
}

fn connect(host string, port int = 8080, timeout int = 30) {
    print("{host}:{port} t={timeout}")
}

fn sum(nums ...int) -> int {
    total = 0
    for n in nums {
        total += n
    }
    return total
}

fn max[T: Comparable](a T, b T) -> T {
    if a.greater_than(b) { a } else { b }
}

fn process[T: Printable + Hashable](item T) {
    print(item.to_string())
}

fn show(item dyn Printable) {
    print(item.to_string())
}

fn classify(value int) -> string {
    return match value {
        0 => "zero"
        1 | 2 | 3 => "small"
        n if n > 100 => "big: {n}"
        _ => "other"
    }
}

fn describe(shape Shape) -> float {
    return match shape {
        Shape.Circle(r) => 3.14159 * r ** 2
        Shape.Rectangle(w, h) => w * h
    }
}

fn locate(point Point) -> string {
    return match point {
        Point { x: 0, y: 0 } => "origin"
        Point { x, y } if x == y => "diagonal"
        Point { x, y } => "({x}, {y})"
    }
}

fn loops() {
    for i in 0..10 {
        print(i)
    }
    for i, item in items {
        print("{i}: {item}")
    }
    for key, value in my_map {
        print("{key} = {value}")
    }
    x = 10
    for x > 0 {
        x -= 1
    }
    for {
        if done {
            break
        }
    }
    @outer for i in 0..10 {
        for j in 0..=10 {
            if i * j > 50 {
                break @outer
            }
            continue @outer
        }
    }
}

fn collections() {
    items = []int{1, 2, 3}
    items.push(4)
    sub = items[1..3]
    head = items[..2]
    tail = items[1..]
    first = items[0]
    scores = map[string]int{
        "alice": 95,
        "bob": 87,
    }
    grid [5]int = [1, 2, 3, 4, 5]
    point = (10, 20)
    named = (x: 10, y: 20)
    a = point.0
    b = named.x
    print(sub, head, tail, first, scores, grid, a, b)
}

fn pipeline(data []int) -> int {
    return data
        |> filter(fn(x) { x > 0 })
        |> map(fn(x) { x * 2 })
        |> reduce(0, fn(acc, x) { acc + x })
}

fn errors_demo(input string) -> Result[int, Error] {
    n = parse_int(input)?
    m = parse_int("42").unwrap_or(0)
    if user = find_user(42) {
        print(user.name)
    }
    return Ok(n * 2 + m)
}

async fn fetch(url string) -> Result[string, Error] {
    response = await http.get(url)
    return Ok(response.body)
}

fn concurrency() {
    ch = Channel[int].new(buffer: 10)
    spawn {
        for i in 0..100 {
            ch.send(i)
        }
        ch.close()
    }
    handle = spawn {
        return compute_result()
    }
    result = await handle
    print(result)
}

fn resources(path string) -> Result[string, Error] {
    file = os.open(path)?
    defer file.close()
    return file.read_all()
}

fn casting(x any) {
    n = x as int
    if x is Printable {
        print("printable")
    }
    f = 1_000_000
    h = 0xFF
    bits = 0b1010
    oct = 0o755
    sci = 1.0e10
    raw = `raw \n no escape`
    print(n, f, h, bits, oct, sci, raw)
}

fn perf_demo() {
    @perf {
        arena = Arena.new(1_mb)
        buf = arena.alloc[byte](4096)
        print(buf)
    }
}

