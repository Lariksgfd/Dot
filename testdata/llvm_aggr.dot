struct Point {
	x float
	y float
}

impl Point {
	fn new(x float, y float) -> Point {
		return Point { x, y }
	}

	fn magnitude(self) -> float {
		return self.x * self.x + self.y * self.y
	}

	fn translate(mut self, dx float, dy float) {
		self.x = self.x + dx
		self.y = self.y + dy
	}
}

fn main() {
	a = "hello"
	b = " world"
	c = a + b
	print(c)
	print(a == "hello")
	print(a != "hello")
	print("ab" + "cd")

	arr [5]int = [10, 20, 30, 40, 50]
	print(arr[2])
	print(arr.len)
	sum = 0
	for v in arr {
		sum = sum + v
	}
	print(sum)

	items = []int{1, 2, 3}
	print(items[1])
	print(items.len)

	names = []string{"bogdan", "marta"}
	print(names.len)
	print(names[0])

	p = Point.new(3.0, 4.0)
	print(p.magnitude())
	print(p.x)
	p.translate(1.0, 1.0)
	print(p.x)
	print(p.y)
}
