    stmts284.push(Stmt.ExprStmt(Expr.Assign([mkid("s")], TokenType.Assign, [mks("b")], s0()), s0()))
    emit_stmts(stmts284, []VarInfo{}, b284, 0)
    c284 = bfinish(b284)
    if str_eq(c284, "DotString* s = dot_string_from_lit(\"a\", 1);\ndot_release(s);\ns = dot_string_from_lit(\"b\", 1);\n") {
        print("OK: arc reassign release")
    } else {
        print("ERR: arc reassign release: " + c284)
    }

    b285 = new_builder()
    stmts285 = []Stmt{}
    stmts285.push(Stmt.Let("s", None, mks("a"), false, s0()))
    stmts285.push(Stmt.ExprStmt(Expr.Assign([mkid("s")], TokenType.PlusAssign, [mks("!")], s0()), s0()))
    emit_stmts(stmts285, []VarInfo{}, b285, 0)
    c285 = bfinish(b285)
    if str_eq(c285, "DotString* s = dot_string_from_lit(\"a\", 1);\ns += dot_string_from_lit(\"!\", 1);\n") {
        print("OK: arc compound no release")
    } else {
        print("ERR: arc compound no release: " + c285)
    }

    b286 = new_builder()
    blk286 = []Stmt{}
    blk286.push(Stmt.Let("a", None, mks("1"), false, s0()))
    blk286.push(Stmt.Let("b", None, mks("2"), false, s0()))
    emit_stmt(Stmt.Block(blk286, s0()), []VarInfo{}, b286, 0)
    c286 = bfinish(b286)
    if str_eq(c286, "{{\n    DotString* a = dot_string_from_lit(\"1\", 1);\n    DotString* b = dot_string_from_lit(\"2\", 1);\n    dot_release(b);\n    dot_release(a);\n}}\n") {
        print("OK: arc block reverse release")
    } else {
        print("ERR: arc block reverse release: " + c286)
    }

    b287 = new_builder()
    stmts287 = []Stmt{}
    stmts287.push(Stmt.Let("s", None, mks("a"), false, s0()))
    stmts287.push(Stmt.ExprStmt(Expr.Assign([mkid("s")], TokenType.Assign, [mkid("s")], s0()), s0()))
    emit_stmts(stmts287, []VarInfo{}, b287, 0)
    c287 = bfinish(b287)
    if str_eq(c287, "DotString* s = dot_string_from_lit(\"a\", 1);\ns = s;\n") {
        print("OK: arc self assign no release")
    } else {
        print("ERR: arc self assign no release: " + c287)
    }

    b288 = new_builder()
    body288 = []Stmt{}
    body288.push(Stmt.Let("s", None, mks("hi"), false, s0()))
    body288.push(Stmt.ExprStmt(mkid("s"), s0()))
    d288 = Decl.Fn("f", []Param{}, []string{}, Some(tn("string")), body288, s0())
    emit_fn_def(d288, b288, 0)
    c288 = bfinish(b288)
    if str_eq(c288, "DotString* Dot_f() {{\n    DotString* s = dot_string_from_lit(\"hi\", 2);\n    DotString* _dot_ret_tail_1 = s;\n    return _dot_ret_tail_1;\n}}\n\n") {
        print("OK: arc tail ident move")
    } else {
        print("ERR: arc tail ident move: " + c288)
    }

    b289 = new_builder()
    body289 = []Stmt{}
    body289.push(Stmt.Let("s", None, mks("hi"), false, s0()))
    body289.push(Stmt.ExprStmt(mkbin(mkid("s"), TokenType.Plus, mks("!")), s0()))
    d289 = Decl.Fn("f", []Param{}, []string{}, Some(tn("string")), body289, s0())
    emit_fn_def(d289, b289, 0)
    c289 = bfinish(b289)
    if str_eq(c289, "DotString* Dot_f() {{\n    DotString* s = dot_string_from_lit(\"hi\", 2);\n    DotString* _dot_ret_tail_1 = dot_string_concat(s, dot_string_from_lit(\"!\", 1));\n    dot_release(s);\n    return _dot_ret_tail_1;\n}}\n\n") {
        print("OK: arc tail complex temp")
    } else {
        print("ERR: arc tail complex temp: " + c289)
    }

    // --- ARC (T-051, stage 6b: array/struct lit retain) ---

    vars_s290 = []VarInfo{}
    vars_s290.push(VarInfo { name: "s", ty: Type.String })
    c290 = emit_expr(Expr.ArrayLit([mkid("s")], s0()), vars_s290)
    if str_eq(c290, "dot_slice_from_array(1, (DotAny[]){{dot_retain((DotRefcnt*)(s))}})") {
        print("OK: arc array lit ident retain")
    } else {
        print("ERR: arc array lit ident retain: " + c290)
    }

    c291 = emit_expr(Expr.ArrayLit([mks("abc")], s0()), []VarInfo{})
    if str_eq(c291, "dot_slice_from_array(1, (DotAny[]){{dot_string_from_lit(\"abc\", 3)}})") {
        print("OK: arc array lit literal no retain")
    } else {
        print("ERR: arc array lit literal no retain: " + c291)
    }

    vars_s292 = []VarInfo{}
    vars_s292.push(VarInfo { name: "s", ty: Type.String })
    c292 = emit_expr(Expr.ArrayLit([mkid("s"), mks("x")], s0()), vars_s292)
    if str_eq(c292, "dot_slice_from_array(2, (DotAny[]){{dot_retain((DotRefcnt*)(s)), dot_string_from_lit(\"x\", 1)}})") {
        print("OK: arc array lit mixed retain")
    } else {
        print("ERR: arc array lit mixed retain: " + c292)
    }

    vars_s293 = []VarInfo{}
    vars_s293.push(VarInfo { name: "s", ty: Type.String })
    slf293 = []StructLitField{}
    slf293.push(StructLitField { name: "name", value: mkid("s") })
    c293 = emit_expr(Expr.StructLit("User", slf293, s0()), vars_s293)
    if str_eq(c293, "dot_box_payload(dot_box_struct(sizeof(DotUser), &((DotUser){{ .dot_name = dot_retain((DotRefcnt*)(s)) }})))") {
        print("OK: arc struct lit ident retain")
    } else {
        print("ERR: arc struct lit ident retain: " + c293)
    }

    slf294 = []StructLitField{}
    slf294.push(StructLitField { name: "name", value: mks("abc") })
    c294 = emit_expr(Expr.StructLit("User", slf294, s0()), []VarInfo{})
    if str_eq(c294, "dot_box_payload(dot_box_struct(sizeof(DotUser), &((DotUser){{ .dot_name = dot_string_from_lit(\"abc\", 3) }})))") {
        print("OK: arc struct lit literal no retain")
    } else {
        print("ERR: arc struct lit literal no retain: " + c294)
    }

    vars_n295 = []VarInfo{}
    vars_n295.push(VarInfo { name: "n", ty: Type.Int })
    c295 = emit_expr(Expr.ArrayLit([mkid("n")], s0()), vars_n295)
    if str_eq(c295, "dot_slice_from_array(1, (DotAny[]){{(DotAny)(intptr_t)(n)}})") {
        print("OK: arc array lit int ident no retain")
    } else {
        print("ERR: arc array lit int ident no retain: " + c295)
    }

    // --- struct-lit boxing (stage 7a) ---

    c296 = emit_expr(Expr.StructLit("Empty", []StructLitField{}, s0()), []VarInfo{})
    if str_eq(c296, "dot_box_payload(dot_box_struct(sizeof(DotEmpty), &((DotEmpty){{  }})))") {
        print("OK: struct lit empty box")
    } else {
        print("ERR: struct lit empty box: " + c296)
    }

    slf297 = []StructLitField{}
    slf297.push(StructLitField { name: "x", value: mki(1) })
    slf297.push(StructLitField { name: "name", value: mks("hi") })
    c297 = emit_expr(Expr.StructLit("User", slf297, s0()), []VarInfo{})
    if str_eq(c297, "dot_box_payload(dot_box_struct(sizeof(DotUser), &((DotUser){{ .dot_x = 1, .dot_name = dot_string_from_lit(\"hi\", 2) }})))") {
        print("OK: struct lit multi field box")
    } else {
        print("ERR: struct lit multi field box: " + c297)
    }

    vars_s298 = []VarInfo{}
    vars_s298.push(VarInfo { name: "s", ty: Type.String })
    slf298 = []StructLitField{}
    slf298.push(StructLitField { name: "name", value: mkid("s") })
    slf298.push(StructLitField { name: "age", value: mki(14) })
    c298 = emit_expr(Expr.StructLit("User", slf298, s0()), vars_s298)
    if str_eq(c298, "dot_box_payload(dot_box_struct(sizeof(DotUser), &((DotUser){{ .dot_name = dot_retain((DotRefcnt*)(s)), .dot_age = 14 }})))") {
        print("OK: struct lit box retain inside init")
    } else {
        print("ERR: struct lit box retain inside init: " + c298)
    }

    slf299 = []StructLitField{}
    slf299.push(StructLitField { name: "x", value: mki(1) })
    c299 = emit_expr(Expr.Call([mkid("f")], [Expr.StructLit("User", slf299, s0())], s0()), []VarInfo{})
    if str_eq(c299, "Dot_f(dot_box_payload(dot_box_struct(sizeof(DotUser), &((DotUser){{ .dot_x = 1 }}))))") {
        print("OK: struct lit call arg box")
    } else {
        print("ERR: struct lit call arg box: " + c299)
    }

    b300 = new_builder()
    body300 = []Stmt{}
    slf300 = []StructLitField{}
    slf300.push(StructLitField { name: "x", value: mki(7) })
    body300.push(Stmt.ExprStmt(Expr.StructLit("Point", slf300, s0()), s0()))
    d300 = Decl.Fn("mk", []Param{}, []string{}, Some(tn("Point")), body300, s0())
    emit_fn_def(d300, b300, 0)
    c300 = bfinish(b300)
    if str_eq(c300, "DotPoint* Dot_mk() {{\n    DotPoint* _dot_ret_tail_1 = dot_box_payload(dot_box_struct(sizeof(DotPoint), &((DotPoint){{ .dot_x = 7 }})));\n    return _dot_ret_tail_1;\n}}\n\n") {
        print("OK: struct lit return tail box")
    } else {
        print("ERR: struct lit return tail box: " + c300)
    }

    // --- fn-sig registry (T-051, stage 7b: call type inference) ---

    sigs_f = []FnSig{}
    sigs_f.push(FnSig { name: "f", ret: Type.String })

    it301 = infer_type_full(Expr.Call([mkid("f")], [mki(1)], s0()), []VarInfo{}, sigs_f, []CodegenStructInfo{})
    if Type.String.equals(it301) {
        print("OK: infer call known sig")
    } else {
        print("ERR: infer call known sig")
    }

    it302 = infer_type_full(Expr.Call([mkid("zz")], [mki(1)], s0()), []VarInfo{}, sigs_f, []CodegenStructInfo{})
    is_unknown302 = match it302 { Type.Unknown => true, _ => false }
    if is_unknown302 {
        print("OK: infer call unknown sig")
    } else {
        print("ERR: infer call unknown sig")
    }

    it303 = infer_type(Expr.Call([mkid("f")], [mki(1)], s0()), []VarInfo{})
    is_unknown303 = match it303 { Type.Unknown => true, _ => false }
    if is_unknown303 {
        print("OK: infer call public wrapper unknown")
    } else {
        print("ERR: infer call public wrapper unknown")
    }

    it304 = infer_type_full(Expr.Call([Expr.Field([mkid("p")], "dist", s0())], [mki(3)], s0()), vars_p, sigs_f, []CodegenStructInfo{})
    is_unknown304 = match it304 { Type.Unknown => true, _ => false }
    if is_unknown304 {
        print("OK: infer method call unknown")
    } else {
        print("ERR: infer method call unknown")
    }

    b305 = new_builder()
    body305 = []Stmt{}
    body305.push(Stmt.Let("s", None, Expr.Call([mkid("g")], []Expr{}, s0()), false, s0()))
    d305 = Decl.Fn("main", []Param{}, []string{}, None, body305, s0())
    sigs_g = []FnSig{}
    sigs_g.push(FnSig { name: "g", ret: Type.String })
    emit_fn_def_full(d305, b305, 0, sigs_g, []CodegenStructInfo{})
    c305 = bfinish(b305)
    if str_contains(c305, "DotString* s = Dot_g();") {
        print("OK: emit let call known sig")
    } else {
        print("ERR: emit let call known sig: " + c305)
    }

    b306 = new_builder()
    d306 = Decl.Fn("main", []Param{}, []string{}, None, body305, s0())
    emit_fn_def(d306, b306, 0)
    c306 = bfinish(b306)
    if str_contains(c306, "void* s = Dot_g();") {
        print("OK: emit let call no sigs void ptr")
    } else {
        print("ERR: emit let call no sigs void ptr: " + c306)
    }

    decls_p307 = []Decl{}
    body_g307 = []Stmt{}
    body_g307.push(Stmt.ExprStmt(mks("hi"), s0()))
    decls_p307.push(Decl.Fn("g", []Param{}, []string{}, Some(tn("string")), body_g307, s0()))
    body_m307 = []Stmt{}
    body_m307.push(Stmt.Let("s", None, Expr.Call([mkid("g")], []Expr{}, s0()), false, s0()))
    body_m307.push(Stmt.ExprStmt(Expr.Call([mkid("print")], [mkid("s")], s0()), s0()))
    decls_p307.push(Decl.Fn("main", []Param{}, []string{}, None, body_m307, s0()))
    c307 = emit_program(decls_p307)
    if str_contains(c307, "DotString* s = Dot_g();") and str_contains(c307, "dot_release(s);") and str_contains(c307, "DotString* Dot_g(void);") {
        print("OK: emit program let call sig")
    } else {
        print("ERR: emit program let call sig: " + c307)
    }

    // --- extern decls (T-051, stage 7c1+7c2: @extern("C")) ---

    ext308 = "@extern(\"C\")\nfn print_str(s string)\n\nfn main() {{\n    print_str(\"extern-ok\")\n}}\n"
    c308 = compile_to_c(ext308)
    if str_contains(c308, "extern void Dot_print_str(DotString*);") and not str_contains(c308, "void Dot_print_str(DotString* s) {{") and str_contains(c308, "Dot_print_str(dot_string_from_lit(\"extern-ok\", 9));") {
        print("OK: extern fn decl no def")
    } else {
        print("ERR: extern fn decl no def: " + c308)
    }

    ext309 = "@extern(\"C\")\nstruct File {{}}\n\nfn get() -> *File {{}}\n"
    c309 = compile_to_c(ext309)
    if not str_contains(c309, "struct DotFile") and str_contains(c309, "void* Dot_get(void);") {
        print("OK: extern struct no def")
    } else {
        print("ERR: extern struct no def: " + c309)
    }

    ext310 = "@extern(\"C++\")\nfn f() -> int {{\n    return 7\n}}\n\nfn main() {{\n    print(f())\n}}\n"
    c310 = compile_to_c(ext310)
    if str_contains(c310, "int64_t Dot_f(void);") and str_contains(c310, "int64_t Dot_f() {{") and not str_contains(c310, "extern int64_t Dot_f") {
        print("OK: extern non-C arg parsed as normal fn")
    } else {
        print("ERR: extern non-C arg parsed as normal fn: " + c310)
    }

    ext311 = "@extern(\"C\")\nfn add(a int, b int) -> int\n\nfn main() {{\n    print(add(2, 3))\n}}\n"
    c311 = compile_to_c(ext311)
    if str_contains(c311, "extern int64_t Dot_add(int64_t, int64_t);") and not str_contains(c311, "int64_t Dot_add(int64_t a, int64_t b) {{") and str_contains(c311, "Dot_add(2, 3)") {
        print("OK: extern fn params ret int")
    } else {
        print("ERR: extern fn params ret int: " + c311)
    }

    ext312 = "@extern(\"C\")\nfn get_num() -> int\n\nfn main() {{\n    print(get_num())\n}}\n"
    c312 = compile_to_c(ext312)
    if c312.len > 0 and str_contains(c312, "extern int64_t Dot_get_num(void);") {
        print("OK: extern fn ret int no missing return")
    } else {
        print("ERR: extern fn ret int no missing return: " + c312)
    }

    // --- escape handling (T-051, stage 7e: lexer read_escape) ---

    esc313 = "fn main() {{\n    s = \"a\\nb\"\n    print(s)\n}}\n"
    c313 = compile_to_c(esc313)
    if str_contains(c313, "dot_string_from_lit(\"a\\nb\", 3)") {
        print("OK: escape nl decoded len3")
    } else {
        print("ERR: escape nl decoded len3: " + c313)
    }

    esc314 = "fn main() {{\n    s = \"x\\t\\ry\\0z\\\\q\\\"w\\x42\"\n    print(s)\n}}\n"
    c314 = compile_to_c(esc314)
    if str_contains(c314, "dot_string_from_lit(\"x\\t\\ry\\000z\\\\q\\\"wB\", 11)") {
        print("OK: escape combo decoded len11")
    } else {
        print("ERR: escape combo decoded len11: " + c314)
    }

    esc315 = "fn main() {{\n    s = \"\\q\"\n    print(s)\n}}\n"
    c315 = compile_to_c(esc315)
    if str_contains(c315, "dot_string_from_lit(\"q\", 1)") {
        print("OK: escape unknown drops slash")
    } else {
        print("ERR: escape unknown drops slash: " + c315)
    }

    esc316 = "fn main() {{\n    s = \"\\u{{1F600}}\"\n    print(s)\n}}\n"
    c316 = compile_to_c(esc316)
    if str_contains(c316, "dot_string_from_lit(\"\\360\\237\\230\\200\", 4)") {
        print("OK: escape unicode utf8 4bytes")
    } else {
        print("ERR: escape unicode utf8 4bytes: " + c316)
    }

    esc317 = "fn main() {{\n    print(\"hi\")\n}}\n"
    c317 = compile_to_c(esc317)
    if str_contains(c317, "dot_string_from_lit(\"hi\", 2)") {
        print("OK: escape plain regression len2")
    } else {
        print("ERR: escape plain regression len2: " + c317)
    }

    // --- match block arms (Expr.Block arm bodies): parser + checker ---

    c318 = Compiler.new()
    c318.compile("fn m() -> int {{\n    n = 5\n    x = match n {{\n        0 => {{\n            a = 1\n            a + 1\n        }},\n        _ => 42\n    }}\n    return x\n}}\n")
    if c318.errors.len == 0 {
        print("OK: match block arm value")
    } else {
        print("ERR: match block arm value: " + c318.errors[0])
    }

    c319 = Compiler.new()
    c319.compile("fn m() {{\n    n = 5\n    match n {{\n        1 => {{\n            b = 7\n            print(b)\n        }},\n        _ => {{\n            print(0)\n        }}\n    }}\n}}\n")
    if c319.errors.len == 0 {
        print("OK: match block arm statement")
    } else {
        print("ERR: match block arm statement: " + c319.errors[0])
    }

    c320 = Compiler.new()
    c320.compile("fn m() -> int {{\n    n = 5\n    x = match n {{\n        v => {{\n            w = v * 2\n            w\n        }},\n        _ => 0\n    }}\n    return x\n}}\n")
    if c320.errors.len == 0 {
        print("OK: match block arm binding")
    } else {
        print("ERR: match block arm binding: " + c320.errors[0])
    }

    c321 = Compiler.new()
    c321.compile("fn m() -> int {{\n    n = 5\n    x = match n {{\n        _ => {{\n            c = 3\n            c + 1\n        }}\n    }}\n    return x\n}}\n")
    if c321.errors.len == 0 {
        print("OK: match block arm catch all")
    } else {
        print("ERR: match block arm catch all: " + c321.errors[0])
    }

    c322 = Compiler.new()
    c322.compile("fn m() -> int {{\n    n = 5\n    x = match n {{\n        v if v > 0 => {{\n            d = v + 1\n            d\n        }},\n        _ => 0\n    }}\n    return x\n}}\n")
    if c322.errors.len == 0 {
        print("OK: match block arm guard")
    } else {
        print("ERR: match block arm guard: " + c322.errors[0])
    }

    c323 = Compiler.new()
    c323.compile("fn m() -> int {{\n    n = 5\n    x = match n {{\n        0 => {{\n            e = 10\n            e\n        }},\n        5 => 20,\n        _ => 30\n    }}\n    return x\n}}\n")
    if c323.errors.len == 0 {
        print("OK: match block arm mixed")
    } else {
        print("ERR: match block arm mixed: " + c323.errors[0])
    }

    c324 = Compiler.new()
    c324.compile("fn m() -> int {{\n    n = 5\n    x = match n {{\n        _ => {{\n            y = match n {{\n                0 => 1,\n                _ => 2\n            }}\n            y + 1\n        }}\n    }}\n    return x\n}}\n")
    if c324.errors.len == 0 {
        print("OK: match block arm nested")
    } else {
        print("ERR: match block arm nested: " + c324.errors[0])
    }

    c325 = Compiler.new()
    c325.compile("struct Point {{ x int }}\nfn m() -> int {{\n    p = match 5 {{\n        _ => Point {{ x: 1 }}\n    }}\n    return 1\n}}\n")
    if c325.errors.len == 0 {
        print("OK: match arm struct lit not block")
    } else {
        print("ERR: match arm struct lit not block: " + c325.errors[0])
    }

    // Unclosed brace of a block arm: the arm swallows the rest of the arms
    // as statements, the parser must report errors (and not hang/panic).
    c326 = Compiler.new()
    c326.compile("fn m() -> int {{\n    n = 5\n    x = match n {{\n        0 => {{\n            a = 1\n        _ => 42\n    }}\n    return x\n}}\n")
    if c326.errors.len > 0 {
        print("OK: match block arm unclosed brace")
    } else {
        print("ERR: match block arm unclosed brace")
    }

    // Syntax error inside a block arm: the bad token is skipped, the block
    // closes and the next arms still parse (single error, no cascade).
    c327 = Compiler.new()
    c327.compile("fn m() -> int {{\n    n = 5\n    x = match n {{\n        0 => {{\n            a = 1\n            @@\n        }},\n        _ => 42\n    }}\n    return x\n}}\n")
    if c327.errors.len > 0 {
        print("OK: match block arm syntax error recovered")
    } else {
        print("ERR: match block arm syntax error recovered")
    }

    c328 = Compiler.new()
    c328.compile("fn m() {{\n    n = 5\n    x = match n {{\n        _ => {{}}\n    }}\n}}\n")
    if c328.errors.len == 0 {
        print("OK: match block arm empty")
    } else {
        print("ERR: match block arm empty: " + c328.errors[0])
    }

    // --- codegen_expr / codegen_stmt: Expr.Block in match-arm position ---

    mb_body = []Stmt{}
    mb_body.push(Stmt.Let("a", None, mki(1), false, s0()))
    mb_body.push(Stmt.ExprStmt(mkbin(mkid("a"), TokenType.Plus, mki(1)), s0()))
    mb_arms = []MatchArm{}
    mb_arms.push(MatchArm { pattern: Pattern.IntLit(0), guard: None, body: Expr.Block(mb_body, s0()) })
    mb_arms.push(MatchArm { pattern: Pattern.CatchAll, guard: None, body: mki(42) })
    c329 = emit_expr(Expr.Match([mki(0)], mb_arms, s0()), []VarInfo{})
    if str_eq(c329, "(((0 == 0)) ? (({{ int64_t a = 1;\nint64_t blktmp = (a + 1);\n blktmp; }})) : (42))") {
        print("OK: emit match block arm value")
    } else {
        print("ERR: emit match block arm value: " + c329)
    }

    vb_body = []Stmt{}
    vb_body.push(Stmt.Let("w", None, mkbin(mkid("v"), TokenType.Star, mki(2)), false, s0()))
    vb_body.push(Stmt.ExprStmt(mkid("w"), s0()))
    vb_arms = []MatchArm{}
    vb_arms.push(MatchArm { pattern: Pattern.Ident("v"), guard: None, body: Expr.Block(vb_body, s0()) })
    c330 = emit_expr(Expr.Match([mki(5)], vb_arms, s0()), []VarInfo{})
    if str_eq(c330, "((true) ? (({{ double w = ((5) * 2);\ndouble blktmp = w;\n blktmp; }})) : (0))") {
        print("OK: emit match block arm binding")
    } else {
        print("ERR: emit match block arm binding: " + c330)
    }

    // CatchAll `_` must NOT be substituted into the body: with the old
    // Ident("_") bug every underscore of the emitted body would be replaced
    // by "(1)" (my_var -> my_(1)var). CatchAll arms substitute nothing.
    ca_body = []Stmt{}
    ca_body.push(Stmt.ExprStmt(mkid("my_var"), s0()))
    ca_arms = []MatchArm{}
    ca_arms.push(MatchArm { pattern: Pattern.CatchAll, guard: None, body: Expr.Block(ca_body, s0()) })
    c331 = emit_expr(Expr.Match([mki(1)], ca_arms, s0()), []VarInfo{})
    if str_eq(c331, "({{ my_var;\n (void)0; }})") {
        print("OK: emit match block arm catch all")
    } else {
        print("ERR: emit match block arm catch all: " + c331)
    }

    // Empty block `=> {}`: no tail value -> (void)0 statement expression.
    c332 = emit_expr(Expr.Block([]Stmt{}, s0()), []VarInfo{})
    if str_eq(c332, "({{ (void)0; }})") {
        print("OK: emit match block arm empty")
    } else {
        print("ERR: emit match block arm empty: " + c332)
    }

    gb_body = []Stmt{}
    gb_body.push(Stmt.ExprStmt(mki(7), s0()))
    gb_arms = []MatchArm{}
    gb_arms.push(MatchArm { pattern: Pattern.IntLit(0), guard: Some(mkbin(mki(0), TokenType.Gt, mki(-1))), body: Expr.Block(gb_body, s0()) })
    gb_arms.push(MatchArm { pattern: Pattern.CatchAll, guard: None, body: mki(9) })
    c333 = emit_expr(Expr.Match([mki(0)], gb_arms, s0()), []VarInfo{})
    if str_contains(c333, "((0 == 0) && ((0 > -1)))") and str_contains(c333, "int64_t blktmp = 7;") and str_contains(c333, " : (9))") {
        print("OK: emit match block arm guard")
    } else {
        print("ERR: emit match block arm guard: " + c333)
    }

    mix_body = []Stmt{}
    mix_body.push(Stmt.ExprStmt(mki(22), s0()))
    mix_arms = []MatchArm{}
    mix_arms.push(MatchArm { pattern: Pattern.IntLit(1), guard: None, body: mki(11) })
    mix_arms.push(MatchArm { pattern: Pattern.IntLit(2), guard: None, body: Expr.Block(mix_body, s0()) })
    mix_arms.push(MatchArm { pattern: Pattern.CatchAll, guard: None, body: Expr.Block([]Stmt{}, s0()) })
    c334 = emit_expr(Expr.Match([mki(5)], mix_arms, s0()), []VarInfo{})
    if str_contains(c334, "(((5 == 1)) ? (11)") and str_contains(c334, "int64_t blktmp = 22;") and str_contains(c334, " (void)0; }}))") {
        print("OK: emit match block arm mixed")
    } else {
        print("ERR: emit match block arm mixed: " + c334)
    }

    nst_inner = []MatchArm{}
    nst_inner.push(MatchArm { pattern: Pattern.IntLit(0), guard: None, body: mki(1) })
    nst_inner.push(MatchArm { pattern: Pattern.CatchAll, guard: None, body: mki(2) })
    nst_body = []Stmt{}
    nst_body.push(Stmt.Let("y", None, Expr.Match([mki(0)], nst_inner, s0()), false, s0()))
    nst_body.push(Stmt.ExprStmt(mkbin(mkid("y"), TokenType.Plus, mki(1)), s0()))
    nst_arms = []MatchArm{}
    nst_arms.push(MatchArm { pattern: Pattern.CatchAll, guard: None, body: Expr.Block(nst_body, s0()) })
    c335 = emit_expr(Expr.Match([mki(9)], nst_arms, s0()), []VarInfo{})
    if str_eq(c335, "({{ int64_t y = (((0 == 0)) ? (1) : (2));\nint64_t blktmp = (y + 1);\n blktmp; }})") {
        print("OK: emit match block arm nested")
    } else {
        print("ERR: emit match block arm nested: " + c335)
    }

    b_mb = new_builder()
    emit_stmts([Stmt.ExprStmt(Expr.Match([mki(1)], mix_arms, s0()), s0())], []VarInfo{}, b_mb, 0)
    c336 = bfinish(b_mb)
    if str_contains(c336, "(((1 == 1)) ? (11)") and str_contains(c336, " (void)0; }})") and str_contains(c336, ";\n") {
        print("OK: emit match block arm statement")
    } else {
        print("ERR: emit match block arm statement: " + c336)
    }

    if Type.Int.equals(infer_type(Expr.Match([mki(0)], mb_arms, s0()), []VarInfo{})) {
        print("OK: infer match block arm")
    } else {
        print("ERR: infer match block arm")
    }

    if Type.Int.equals(infer_type(Expr.Block(mb_body, s0()), []VarInfo{})) {
        print("OK: infer block tail local")
    } else {
        print("ERR: infer block tail local")
    }

    eb_ty = infer_type(Expr.Block([]Stmt{}, s0()), []VarInfo{})
    is_eb_unknown = match eb_ty { Type.Unknown => true, _ => false }
    if is_eb_unknown {
        print("OK: infer block empty unknown")
    } else {
        print("ERR: infer block empty unknown")
    }

    // A1 regression end to end: `_ => Point { x: 1 }` must parse the body as
    // a struct literal (not a block); `_` is CatchAll, so no "_" substitution
    // corrupts the emitted ".dot_x" (old bug: ".dot(5)x").
    src_sl = "struct Point {{ x int }}\nfn m() -> int {{\n    p = match 5 {{\n        _ => Point {{ x: 1 }}\n    }}\n    return 1\n}}\n"
    c337 = compile_to_c(src_sl)
    if str_contains(c337, "dot_box_payload(dot_box_struct(sizeof(DotPoint)") and str_contains(c337, ".dot_x") and not str_contains(c337, ".dot(5)x") {
        print("OK: match arm struct lit codegen")
    } else {
        print("ERR: match arm struct lit codegen: " + c337)
    }

    src_st = "fn m() {{\n    n = 5\n    match n {{\n        1 => {{\n            b = 7\n            print(b)\n        }},\n        _ => {{\n            print(0)\n        }}\n    }}\n}}\n"
    c338 = compile_to_c(src_st)
    if c338.len > 0 and str_contains(c338, "int64_t b = 7;") and str_contains(c338, " (void)0;") {
        print("OK: match block arm statement codegen")
    } else {
        print("ERR: match block arm statement codegen: " + c338)
    }

    // Binding arm with a void-tailed block in statement position: the
    // binding substitution must NOT corrupt `(void)0` / `int64_t` / `void*`
    // (str_replace_ident regression, previously `(n)oid`).
    src_bind_st = "fn m() {{\n    n = 5\n    match n {{\n        v => {{\n            print(v)\n        }},\n        _ => {{\n            print(0)\n        }}\n    }}\n}}\n"
    c339 = Compiler.new()
    c339.compile(src_bind_st)
    if c339.errors.len == 0 {
        print("OK: match block arm binding statement")
    } else {
        print("ERR: match block arm binding statement: " + c339.errors[0])
    }

    c340 = Compiler.new()
    c340.compile("fn m() {{\n    n = 5\n    match n {{\n        v if v > 0 => {{\n            print(v)\n        }},\n        _ => {{\n            print(0)\n        }}\n    }}\n}}\n")
    if c340.errors.len == 0 {
        print("OK: match block arm binding guard")
    } else {
        print("ERR: match block arm binding guard: " + c340.errors[0])
    }

    c341 = compile_to_c(src_bind_st)
    if c341.len > 0 and str_contains(c341, "((true) ?") and str_contains(c341, "(intptr_t)((n))") and str_contains(c341, " (void)0;") and not str_contains(c341, "(n)oid") and not str_contains(c341, "int64(n)t") {
        print("OK: match block arm binding codegen")
    } else {
        print("ERR: match block arm binding codegen: " + c341)
    }

    // Unit-level: Ident-pattern guard gets the subject substitution (D53
    // fix in match_guard_cond) and the block body is substituted with
    // identifier boundaries.
    gb2_body = []Stmt{}
    gb2_body.push(Stmt.ExprStmt(Expr.Call([mkid("print")], [mkid("v")], s0()), s0()))
    gb2_arms = []MatchArm{}
    gb2_arms.push(MatchArm { pattern: Pattern.Ident("v"), guard: Some(mkbin(mkid("v"), TokenType.Gt, mki(0))), body: Expr.Block(gb2_body, s0()) })
    gb2_arms.push(MatchArm { pattern: Pattern.CatchAll, guard: None, body: mki(0) })
    c342 = emit_expr(Expr.Match([mki(5)], gb2_arms, s0()), []VarInfo{})
    if str_eq(c342, "((true && (((5) > 0))) ? (({{ dot_print(dot_slice_pack(1, (DotAny[]){{(DotAny)(intptr_t)((5))}}));\n (void)0; }})) : (0))") {
        print("OK: emit match block arm binding guard")
    } else {
        print("ERR: emit match block arm binding guard: " + c342)
    }
}