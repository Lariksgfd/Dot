import "../stdlib/compiler.dot"
import std.codegen

pub fn main() {
    c = Compiler.new()
    ast = c.compile("x = 42")
    if c.errors.len == 0 {
        print("OK: happy path")
    } else {
        print("ERR: " + c.errors[0])
    }

    c2 = Compiler.new()
    c2.compile("x int = \"hello\"")
    if c2.errors.len > 0 {
        print("OK: caught type error")
    } else {
        print("ERR: missed type error")
    }

    c3 = Compiler.new()
    c3.compile("x = ;")
    if c3.errors.len > 0 {
        print("OK: caught syntax error")
    } else {
        print("ERR: missed syntax error")
    }

    c4 = Compiler.new()
    c4.compile("fn f() -> int {{ return 1 }}")
    if c4.errors.len == 0 {
        print("OK: fn ret ok")
    } else {
        print("ERR: fn ret ok: " + c4.errors[0])
    }

    c5 = Compiler.new()
    c5.compile("fn fib(n int) -> int {{ if n < 2 {{ return n }} return fib(n - 1) + fib(n - 2) }}")
    if c5.errors.len == 0 {
        print("OK: fib recursion")
    } else {
        print("ERR: fib recursion: " + c5.errors[0])
    }

    c6 = Compiler.new()
    c6.compile("fn inc(a int) -> int {{ return a + 1 }}\nfn apply(f fn(int) -> int, v int) -> int {{ return f(v) }}\nfn m() -> int {{ return apply(inc, 5) }}")
    if c6.errors.len == 0 {
        print("OK: fn as value")
    } else {
        print("ERR: fn as value: " + c6.errors[0])
    }

    c7 = Compiler.new()
    c7.compile("fn inc(a int) -> int {{ return a + 1 }}\nfn m() -> int {{ f = inc return f(41) }}")
    if c7.errors.len == 0 {
        print("OK: fn var")
    } else {
        print("ERR: fn var: " + c7.errors[0])
    }

    c8 = Compiler.new()
    c8.compile("fn t() -> int {{ x = 1 x }}")
    if c8.errors.len == 0 {
        print("OK: tail expr")
    } else {
        print("ERR: tail expr: " + c8.errors[0])
    }

    c9 = Compiler.new()
    c9.compile("import strings\nfn f() -> int {{ return 1 }}")
    if c9.errors.len == 0 {
        print("OK: import skip")
    } else {
        print("ERR: import skip: " + c9.errors[0])
    }

    c10 = Compiler.new()
    c10.compile("fn g() -> int {{ x = 1 }}")
    if c10.errors.len > 0 {
        print("OK: missing return")
    } else {
        print("ERR: missing return")
    }

    c11 = Compiler.new()
    c11.compile("fn bad() -> int {{ return \"str\" }}")
    if c11.errors.len > 0 {
        print("OK: ret mismatch")
    } else {
        print("ERR: ret mismatch")
    }

    c12 = Compiler.new()
    c12.compile("fn t() -> int {{ x = 1 \"str\" }}")
    if c12.errors.len > 0 {
        print("OK: tail mismatch")
    } else {
        print("ERR: tail mismatch")
    }

    c13 = Compiler.new()
    c13.compile("fn add(a int, b int) -> int {{ return a + b }}\nfn m() -> int {{ return add(1, 2, 3) }}")
    if c13.errors.len > 0 {
        print("OK: arity")
    } else {
        print("ERR: arity")
    }

    c14 = Compiler.new()
    c14.compile("fn add(a int, b int) -> int {{ return a + b }}\nfn m() -> int {{ return add(1, \"x\") }}")
    if c14.errors.len > 0 {
        print("OK: arg type")
    } else {
        print("ERR: arg type")
    }

    c15 = Compiler.new()
    c15.compile("fn add(a int, b int) -> int {{ return a + b }}\nfn apply(f fn(int) -> int, v int) -> int {{ return f(v) }}\nfn m() -> int {{ return apply(add, 5) }}")
    if c15.errors.len > 0 {
        print("OK: fn type mismatch")
    } else {
        print("ERR: fn type mismatch")
    }

    c16 = Compiler.new()
    c16.compile("fn identity[T](x T) -> T {{ return x }}\nfn m() -> int {{ return identity(5) }}")
    if c16.errors.len == 0 {
        print("OK: generic identity")
    } else {
        print("ERR: generic identity: " + c16.errors[0])
    }

    c17 = Compiler.new()
    c17.compile("fn f[T](a T, b T) -> bool {{ return true }}\nfn m() -> bool {{ return f(1, 2) }}")
    if c17.errors.len == 0 {
        print("OK: generic two params")
    } else {
        print("ERR: generic two params: " + c17.errors[0])
    }

    c18 = Compiler.new()
    c18.compile("fn wrap[T](x T) -> []T {{ return [x] }}\nfn m() -> []int {{ return wrap(5) }}")
    if c18.errors.len == 0 {
        print("OK: generic subst")
    } else {
        print("ERR: generic subst: " + c18.errors[0])
    }

    c19 = Compiler.new()
    c19.compile("fn id[T](x T) -> T {{ return x }}\nfn m() -> int {{ a = 1 return id(a) }}")
    if c19.errors.len == 0 {
        print("OK: generic var arg")
    } else {
        print("ERR: generic var arg: " + c19.errors[0])
    }

    c20 = Compiler.new()
    c20.compile("enum Option {{ None Some }}\nfn find() -> Option {{ return None }}")
    if c20.errors.len == 0 {
        print("OK: none return")
    } else {
        print("ERR: none return: " + c20.errors[0])
    }

    c21 = Compiler.new()
    c21.compile("enum Option {{ None Some(x int) }}\nfn m() -> Option {{ x = Some(5) return x }}")
    if c21.errors.len == 0 {
        print("OK: some ctor")
    } else {
        print("ERR: some ctor: " + c21.errors[0])
    }

    c22 = Compiler.new()
    c22.compile("enum Option {{ None Some(x int) }}\nfn m() -> bool {{ o = Some(5) return o.is_some() }}")
    if c22.errors.len == 0 {
        print("OK: option is_some")
    } else {
        print("ERR: option is_some: " + c22.errors[0])
    }

    c23 = Compiler.new()
    c23.compile("enum Result {{ Ok(x int) Err(e string) }}\nfn f() -> Result {{ return Ok(1) }}\nfn m() -> bool {{ r = f() return r.is_ok() }}")
    if c23.errors.len == 0 {
        print("OK: result is_ok")
    } else {
        print("ERR: result is_ok: " + c23.errors[0])
    }

    c24 = Compiler.new()
    c24.compile("enum Option {{ None Some(x int) }}\nfn inc(n int) -> int {{ return n + 1 }}\nfn m() -> Option {{ o = Some(5) return o.map(inc) }}")
    if c24.errors.len == 0 {
        print("OK: option map")
    } else {
        print("ERR: option map: " + c24.errors[0])
    }

    c25 = Compiler.new()
    c25.compile("fn identity[T](x T) -> T {{ return x }}\nfn m() -> int {{ return identity(\"s\") }}")
    if c25.errors.len > 0 {
        print("OK: generic ret mismatch")
    } else {
        print("ERR: generic ret mismatch")
    }

    c26 = Compiler.new()
    c26.compile("fn f[T](a T, b T) -> bool {{ return true }}\nfn m() -> bool {{ return f(1, \"x\") }}")
    if c26.errors.len > 0 {
        print("OK: generic conflict")
    } else {
        print("ERR: generic conflict")
    }

    c27 = Compiler.new()
    c27.compile("enum Option {{ None Some(x int) }}\nfn m() -> int {{ o = Some(5) return o.nope() }}")
    if c27.errors.len > 0 {
        print("OK: unknown method")
    } else {
        print("ERR: unknown method")
    }

    c28 = Compiler.new()
    c28.compile("fn m() -> int {{ f = fn(x int) -> int {{ return x * 2 }} return f(5) }}")
    if c28.errors.len == 0 {
        print("OK: closure basic")
    } else {
        print("ERR: closure basic: " + c28.errors[0])
    }

    c29 = Compiler.new()
    c29.compile("fn m() -> int {{ add = fn(a int, b int) -> int {{ return a + b }} return add(1, 2) }}")
    if c29.errors.len == 0 {
        print("OK: closure two params")
    } else {
        print("ERR: closure two params: " + c29.errors[0])
    }

    c30 = Compiler.new()
    c30.compile("fn m() -> int {{ x = 10 f = fn() -> int {{ return x }} return f() }}")
    if c30.errors.len == 0 {
        print("OK: closure capture")
    } else {
        print("ERR: closure capture: " + c30.errors[0])
    }

    c31 = Compiler.new()
    c31.compile("fn apply(f fn(int) -> int, v int) -> int {{ return f(v) }}\nfn m() -> int {{ return apply(fn(x int) -> int {{ return x + 1 }}, 5) }}")
    if c31.errors.len == 0 {
        print("OK: closure as arg")
    } else {
        print("ERR: closure as arg: " + c31.errors[0])
    }

    c32 = Compiler.new()
    c32.compile("struct Point {{ x int y int }}\nfn m() -> int {{ p = Point {{ x: 1, y: 2 }} return p.x }}")
    if c32.errors.len == 0 {
        print("OK: struct lit")
    } else {
        print("ERR: struct lit: " + c32.errors[0])
    }

    c33 = Compiler.new()
    c33.compile("enum Option {{ None Some(x int) }}\nfn m() -> Option {{ x = Some(5) return x }}")
    if c33.errors.len == 0 {
        print("OK: payload ctor")
    } else {
        print("ERR: payload ctor: " + c33.errors[0])
    }

    c34 = Compiler.new()
    c34.compile("enum Option {{ None Some(x int) }}\nfn m() -> bool {{ o = Some(5) return o.is_some() }}")
    if c34.errors.len == 0 {
        print("OK: payload is_some")
    } else {
        print("ERR: payload is_some: " + c34.errors[0])
    }

    c35 = Compiler.new()
    c35.compile("fn m() -> int {{ f = fn(x int) -> int {{ return x * 2 }} return f(\"s\") }}")
    if c35.errors.len > 0 {
        print("OK: closure arg type")
    } else {
        print("ERR: closure arg type")
    }

    c36 = Compiler.new()
    c36.compile("fn m() -> int {{ f = fn(x int) -> string {{ return \"a\" }} return f(5) }}")
    if c36.errors.len > 0 {
        print("OK: closure ret mismatch")
    } else {
        print("ERR: closure ret mismatch")
    }

    c37 = Compiler.new()
    c37.compile("struct Point {{ x int y int }}\nfn m() -> Point {{ p = Point {{ x: 1, y: \"s\" }} return p }}")
    if c37.errors.len > 0 {
        print("OK: struct field mismatch")
    } else {
        print("ERR: struct field mismatch")
    }

    c38 = Compiler.new()
    c38.compile("struct Point {{ x int y int }}\nfn m() -> Point {{ p = Point {{ x: 1, z: 2 }} return p }}")
    if c38.errors.len > 0 {
        print("OK: struct unknown field")
    } else {
        print("ERR: struct unknown field")
    }

    c39 = Compiler.new()
    c39.compile("enum Option {{ None Some(x int) }}\nfn m() -> Option {{ x = Some(\"s\") return x }}")
    if c39.errors.len > 0 {
        print("OK: payload type")
    } else {
        print("ERR: payload type")
    }

    c40 = Compiler.new()
    c40.compile("fn m() -> int {{ m = {{ \"a\": 1, \"b\": 2 }} return 1 }}")
    if c40.errors.len == 0 {
        print("OK: map lit")
    } else {
        print("ERR: map lit: " + c40.errors[0])
    }

    c41 = Compiler.new()
    c41.compile("fn m() -> map[string]int {{ m = {{ \"a\": 1 }} return m }}")
    if c41.errors.len == 0 {
        print("OK: typed map")
    } else {
        print("ERR: typed map: " + c41.errors[0])
    }

    c42 = Compiler.new()
    c42.compile("fn m() -> int {{ m = {{}} return 1 }}")
    if c42.errors.len == 0 {
        print("OK: empty map")
    } else {
        print("ERR: empty map: " + c42.errors[0])
    }

    c43 = Compiler.new()
    c43.compile("fn m() {{ m = {{ \"a\": 1, \"b\": \"x\" }} }}")
    if c43.errors.len > 0 {
        print("OK: map val mismatch")
    } else {
        print("ERR: map val mismatch")
    }

    c44 = Compiler.new()
    c44.compile("fn m() {{ m = {{ 1: \"a\", \"b\": \"x\" }} }}")
    if c44.errors.len > 0 {
        print("OK: map key mismatch")
    } else {
        print("ERR: map key mismatch")
    }

    c45 = Compiler.new()
    c45.compile("fn m() -> int {{ t = (x: 1, y: 2) return 1 }}")
    if c45.errors.len == 0 {
        print("OK: named tuple")
    } else {
        print("ERR: named tuple: " + c45.errors[0])
    }

    c46 = Compiler.new()
    c46.compile("fn m() -> int {{ t = (a: 1, 2) return 1 }}")
    if c46.errors.len == 0 {
        print("OK: mixed tuple")
    } else {
        print("ERR: mixed tuple: " + c46.errors[0])
    }

    c47 = Compiler.new()
    c47.compile("fn m() -> int {{ t = (x: 1,) return 1 }}")
    if c47.errors.len == 0 {
        print("OK: tuple trailing comma")
    } else {
        print("ERR: tuple trailing comma: " + c47.errors[0])
    }

    c48 = Compiler.new()
    c48.compile("enum Type {{ Func(oparams string, oret string) }}\nfn m() -> string {{ t = Func(\"ab\", \"cd\") return match t {{ Type.Func(oparams, oret) => oret + oparams, _ => \"\" }} }}")
    if c48.errors.len == 0 {
        print("OK: match payload qualified")
    } else {
        print("ERR: match payload qualified: " + c48.errors[0])
    }

    c49 = Compiler.new()
    c49.compile("enum MyOpt {{ None Some(n int) }}\nfn m() -> int {{ o = Some(7) return match o {{ Some(n) => n, None => 0 }} }}")
    if c49.errors.len == 0 {
        print("OK: match payload unqualified")
    } else {
        print("ERR: match payload unqualified: " + c49.errors[0])
    }

    c50 = Compiler.new()
    c50.compile("enum MyOpt {{ None Some(n int) }}\nfn m() -> int {{ o = Some(3) return match o {{ Some(_) => 0, None => 1 }} }}")
    if c50.errors.len == 0 {
        print("OK: match payload underscore")
    } else {
        print("ERR: match payload underscore: " + c50.errors[0])
    }

    c51 = Compiler.new()
    c51.compile("enum Type {{ Func(oparams string, oret string) }}\nfn m() -> string {{ t = Func(\"ab\", \"cd\") return match t {{ Type.Func(a, b) if a.len > 0 => b, _ => \"\" }} }}")
    if c51.errors.len == 0 {
        print("OK: match payload guard")
    } else {
        print("ERR: match payload guard: " + c51.errors[0])
    }

    c52 = Compiler.new()
    c52.compile("enum Shape {{ Circle(r int) Rect(w int, h int) Point }}\nfn m() -> int {{ s = Rect(2, 3) return match s {{ Shape.Circle(r) => r, Shape.Rect(w, h) => w + h, Shape.Point => 0, _ => -1 }} }}")
    if c52.errors.len == 0 {
        print("OK: match payload multi")
    } else {
        print("ERR: match payload multi: " + c52.errors[0])
    }

    c53 = Compiler.new()
    c53.compile("enum Shape {{ Rect(w int, h int) }}\nfn m() -> int {{ s = Rect(1, 2) return match s {{ Shape.Rect(w) => w, _ => 0 }} }}")
    if c53.errors.len > 0 {
        print("OK: match payload arity")
    } else {
        print("ERR: match payload arity")
    }

    c54 = Compiler.new()
    c54.compile("enum Shape {{ Circle(r int) }}\nfn m() -> int {{ s = Circle(1) return match s {{ Shape.Triangle(x) => x, _ => 0 }} }}")
    if c54.errors.len > 0 {
        print("OK: match payload unknown variant")
    } else {
        print("ERR: match payload unknown variant")
    }

    c55 = Compiler.new()
    c55.compile("fn m() -> int {{ x = 5 return match x {{ Some(v) => v, _ => 0 }} }}")
    if c55.errors.len > 0 {
        print("OK: match payload non-enum")
    } else {
        print("ERR: match payload non-enum")
    }

    c56 = str_concat("hello ", "world")
    if str_eq(c56, "hello world") {
        print("OK: str_concat")
    } else {
        print("ERR: str_concat")
    }

    c57 = str_concat("", "abc")
    if str_eq(c57, "abc") {
        print("OK: str_concat empty lhs")
    } else {
        print("ERR: str_concat empty lhs")
    }

    c58 = str_concat("abc", "")
    if str_eq(c58, "abc") {
        print("OK: str_concat empty rhs")
    } else {
        print("ERR: str_concat empty rhs")
    }

    c59 = str_concat("", "")
    if str_eq(c59, "") {
        print("OK: str_concat both empty")
    } else {
        print("ERR: str_concat both empty")
    }

    if str_starts_with("hello", "hel") {
        print("OK: starts true")
    } else {
        print("ERR: starts true")
    }

    if not str_starts_with("hello", "hex") {
        print("OK: starts false")
    } else {
        print("ERR: starts false")
    }

    if not str_starts_with("hi", "hello") {
        print("OK: starts prefix longer")
    } else {
        print("ERR: starts prefix longer")
    }

    if str_starts_with("hi", "") {
        print("OK: starts empty prefix")
    } else {
        print("ERR: starts empty prefix")
    }

    if str_starts_with("hi", "hi") {
        print("OK: starts equal")
    } else {
        print("ERR: starts equal")
    }

    if str_ends_with("hello", "llo") {
        print("OK: ends true")
    } else {
        print("ERR: ends true")
    }

    if not str_ends_with("hello", "oll") {
        print("OK: ends false")
    } else {
        print("ERR: ends false")
    }

    if not str_ends_with("hi", "hello") {
        print("OK: ends suffix longer")
    } else {
        print("ERR: ends suffix longer")
    }

    if str_ends_with("hi", "") {
        print("OK: ends empty suffix")
    } else {
        print("ERR: ends empty suffix")
    }

    if str_ends_with("hi", "hi") {
        print("OK: ends equal")
    } else {
        print("ERR: ends equal")
    }

    if str_contains("hello", "ell") {
        print("OK: contains true")
    } else {
        print("ERR: contains true")
    }

    if not str_contains("hello", "xyz") {
        print("OK: contains false")
    } else {
        print("ERR: contains false")
    }

    if str_contains("hello", "") {
        print("OK: contains empty sub")
    } else {
        print("ERR: contains empty sub")
    }

    if not str_contains("ab", "abc") {
        print("OK: contains sub longer")
    } else {
        print("ERR: contains sub longer")
    }

    if str_contains("hello", "o") {
        print("OK: contains at end")
    } else {
        print("ERR: contains at end")
    }

    if str_index_of("hello", "l") == 2 {
        print("OK: index_of found")
    } else {
        print("ERR: index_of found")
    }

    if str_index_of("hello", "x") == -1 {
        print("OK: index_of not found")
    } else {
        print("ERR: index_of not found")
    }

    if str_index_of("hello", "") == 0 {
        print("OK: index_of empty sub")
    } else {
        print("ERR: index_of empty sub")
    }

    if str_index_of("banana", "na") == 2 {
        print("OK: index_of second occurrence")
    } else {
        print("ERR: index_of second occurrence")
    }

    if str_index_of("ab", "abc") == -1 {
        print("OK: index_of sub longer")
    } else {
        print("ERR: index_of sub longer")
    }

    if str_index_of("hello", "o") == 4 {
        print("OK: index_of at end")
    } else {
        print("ERR: index_of at end")
    }

    if str_index_of("", "") == 0 {
        print("OK: index_of both empty")
    } else {
        print("ERR: index_of both empty")
    }

    if str_index_of("aaaa", "aa") == 0 {
        print("OK: index_of first of many")
    } else {
        print("ERR: index_of first of many")
    }

    b_esc = new_builder()
    c_escape_into(b_esc, "a\"b\\c")
    esc_q = bfinish(b_esc)
    if str_eq(esc_q, "a\\\"b\\\\c") {
        print("OK: escape quote backslash")
    } else {
        print("ERR: escape quote backslash")
    }

    b_esc2 = new_builder()
    c_escape_into(b_esc2, "a\nb\tc\rd")
    esc_ws = bfinish(b_esc2)
    if str_eq(esc_ws, "a\\nb\\tc\\rd") {
        print("OK: escape ws")
    } else {
        print("ERR: escape ws")
    }

    b_esc3 = new_builder()
    c_escape_into(b_esc3, "\0")
    esc_nul = bfinish(b_esc3)
    if str_eq(esc_nul, "\\000") {
        print("OK: escape nul")
    } else {
        print("ERR: escape nul")
    }

    b_raw = new_builder()
    b_raw.buf.push(128 as uint8)
    raw128 = bfinish(b_raw)
    b_esc4 = new_builder()
    c_escape_into(b_esc4, raw128)
    esc_h80 = bfinish(b_esc4)
    if str_eq(esc_h80, "\\200") {
        print("OK: escape byte128")
    } else {
        print("ERR: escape byte128")
    }

    b_esc5 = new_builder()
    c_escape_into(b_esc5, "\x7f")
    esc_h7f = bfinish(b_esc5)
    if str_eq(esc_h7f, "\\177") {
        print("OK: escape byte127")
    } else {
        print("ERR: escape byte127")
    }

    b_esc6 = new_builder()
    c_escape_into(b_esc6, "\x01")
    esc_h01 = bfinish(b_esc6)
    if str_eq(esc_h01, "\\001") {
        print("OK: escape byte1")
    } else {
        print("ERR: escape byte1")
    }

    b_esc7 = new_builder()
    c_escape_into(b_esc7, "\x1f")
    esc_h1f = bfinish(b_esc7)
    if str_eq(esc_h1f, "\\037") {
        print("OK: escape byte31")
    } else {
        print("ERR: escape byte31")
    }

    b_esc8 = new_builder()
    c_escape_into(b_esc8, "plain")
    esc_plain = bfinish(b_esc8)
    if str_eq(esc_plain, "plain") {
        print("OK: escape plain")
    } else {
        print("ERR: escape plain")
    }

    if str_eq(int_to_str(-123), "-123") {
        print("OK: int_to_str neg")
    } else {
        print("ERR: int_to_str neg")
    }

    if str_eq(int_to_str(0), "0") {
        print("OK: int_to_str zero")
    } else {
        print("ERR: int_to_str zero")
    }

    if str_eq(int_to_str(1000), "1000") {
        print("OK: int_to_str pos")
    } else {
        print("ERR: int_to_str pos")
    }
}