import "../stdlib/compiler.dot"
import "../stdlib/codegen.dot"
import "../stdlib/codegen_types.dot"
import "../stdlib/codegen_expr.dot"
import "../stdlib/codegen_stmt.dot"
import "../stdlib/codegen_decl.dot"

fn s0() -> Span {
    p = Position.new("", 0, 0, 0)
    return Span.new(p, p)
}

fn mki(v int) -> Expr {
    return Expr.IntLit(v, s0())
}

fn mkf(v float) -> Expr {
    return Expr.FloatLit(v, s0())
}

fn mks(v string) -> Expr {
    return Expr.StringLit(v, s0())
}

fn mkb(v bool) -> Expr {
    return Expr.BoolLit(v, s0())
}

fn mkid(name string) -> Expr {
    return Expr.Ident(name, s0())
}

fn mkbin(l Expr, op TokenType, r Expr) -> Expr {
    return Expr.Binary([l], op, [r], s0())
}

fn mkun(op TokenType, r Expr) -> Expr {
    return Expr.Unary(op, [r], s0())
}

fn mkif(c Expr, t Expr, e Expr) -> Expr {
    return Expr.If([c], [Stmt.ExprStmt(t, s0())], [e], s0())
}

fn tn(name string) -> TypeNode {
    return TypeNode.Named(name, s0())
}

fn mkparam(n string, ty string) -> Param {
    return Param { name: n, ty: tn(ty) }
}

pub fn main() {
    c = Compiler.new()
