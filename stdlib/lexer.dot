pub enum TokenType {
    Illegal
    EOF
    Newline
    Ident
    Underscore
    Int
    Float
    String
    RawString
    Fn
    Struct
    Trait
    Impl
    Enum
    If
    Else
    For
    In
    Match
    Return
    Break
    Continue
    Import
    From
    Const
    Mut
    SelfKw
    SelfType
    Spawn
    Async
    Await
    Defer
    Embed
    Pub
    TrueKw
    FalseKw
    NilKw
    And
    Or
    Not
    As
    Is
    Dyn
    Weak
    Macro
    Where
    Yield
    TypeKw
    Module
    Unsafe
    Extern
    Static
    Virtual
    Override
    Plus
    Minus
    Star
    Slash
    Percent
    StarStar
    EqEq
    BangEq
    Lt
    Gt
    LtEq
    GtEq
    Amp
    Pipe
    Caret
    Tilde
    Shl
    Shr
    Assign
    PlusAssign
    MinusAssign
    StarAssign
    SlashAssign
    PercentAssign
    AmpAssign
    PipeAssign
    CaretAssign
    ShlAssign
    ShrAssign
    PipeArrow
    DotDot
    DotDotEq
    Ellipsis
    Arrow
    FatArrow
    Question
    Dot
    Comma
    Colon
    At
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comment
}

pub enum StringPartKind {
    Literal
    Expr
}

pub struct StringPart {
    kind StringPartKind
    value string
    pos Position
}

pub struct Position {
    file string
    line int
    column int
    offset int
}

impl Position {
    pub fn new(file string, line int, column int, offset int) -> Position {
        return Position { file, line, column, offset }
    }
}

pub struct Token {
    type TokenType
    lexeme string
    value string
    base int
    suffix string
    parts []StringPart
    pos Position
    end Position
}

pub struct Lexer {
    src string
    file string
    offset int
    line int
    col int
    ch int
}

impl Lexer {
    pub fn new(src string, file string) -> Lexer {
        mut l = Lexer {
            src,
            file,
            offset: 0,
            line: 1,
            col: 1,
            ch: -1
        }
        l.advance()
        return l
    }

    fn advance(mut self) {
        if self.offset >= self.src.len() {
            self.ch = -1
            return
        }
        self.ch = self.src[self.offset] as int
        self.offset += 1
        if self.ch == 10 { // \n
            self.line += 1
            self.col = 1
        } else {
            self.col += 1
        }
    }

    fn skip_whitespace(mut self) {
        for self.ch == 32 or self.ch == 9 or self.ch == 13 { // ' ', '\t', '\r'
            self.advance()
        }
    }

    pub fn next_token(mut self) -> Token {
        self.skip_whitespace()

        pos = Position.new(self.file, self.line, self.col, self.offset)
        ch = self.ch

        if ch == -1 {
            return Token {
                type: TokenType.EOF,
                lexeme: "",
                value: "",
                base: 0,
                suffix: "",
                parts: nil,
                pos,
                end: pos
            }
        }

        self.advance()

        // Very basic single-character tokens for demonstration
        type = match ch {
            10 => TokenType.Newline // \n
            43 => TokenType.Plus    // +
            45 => TokenType.Minus   // -
            42 => TokenType.Star    // *
            47 => TokenType.Slash   // /
            40 => TokenType.LParen  // (
            41 => TokenType.RParen  // )
            123 => TokenType.LBrace // {
            125 => TokenType.RBrace // }
            _ => TokenType.Illegal
        }

        end_pos = Position.new(self.file, self.line, self.col, self.offset)

        return Token {
            type,
            lexeme: "",
            value: "",
            base: 0,
            suffix: "",
            parts: nil,
            pos,
            end: end_pos
        }
    }
}
