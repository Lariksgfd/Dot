// stdlib/codegen_stmt.dot - T-051 stage 4: statement emitter for the
// self-hosted C codegen. Port of Go codegen/emit_stmt.go (emitStmt,
// emitVarDecl, emitAssignStmt, emitExprStmt) and codegen/emit_stmt_extra.go
// (emitReturnStmt, emitBlockStmt, emitForStmt, emitForRange, emitForIterator,
// emitBreakStmt, emitContinueStmt). Covered: ExprStmt, Let (var decl),
// Assign in statement position, Return, Block (stage 4a); While, For in
// three forms (infinite / counted range / for-in over slice+array+map),
// Break, Continue (stage 4b).
//
// NOTE: ast.dot has no If/Match STATEMENT nodes — Expr.If/Expr.Match used
// in statement position fall through the generic ExprStmt path and render
// as the ternary chain of codegen_expr.dot plus ";", like any other
// expression statement.
//
// [РЕШЕНИЕ] Indentation: emit_stmt/emit_stmts thread a depth int (CBuilder
// has no indent field, and a mutable indent counter would break the
// functional D53 style). 4 spaces per level, same as Go generator.line().
//
// [РЕШЕНИЕ] Scope/vars: declarations APPEND to vars and are never removed
// on block exit (monotonic growth) — C sees every local for the rest of
// the function body. Real scope cleanup arrives with ARC on stage 6.
//
// [РЕШЕНИЕ] Assign: plain "<target> op <value>;" with NO retain/release
// (ARC is stage 6). Index targets do not lower to dot_slice_set yet (Go
// emitAssignStmt does; deferred with the stage-4b statement pass).
import ast
import types
import codegen
import codegen_types
import codegen_expr

// emit_stmt renders one statement into out at the given depth and returns
// the updated vars (Let appends its VarInfo). Functional style: the vars
// slice flows in and out, nothing is rebound (D53).
pub fn emit_stmt(st Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    return match st {
        Stmt.ExprStmt(e, _) => emit_expr_stmt(e, vars, out, depth)
        Stmt.Let(name, ty_opt, value, _, _) => emit_let(name, ty_opt, value, vars, out, depth)
        Stmt.Return(v_opt, _) => emit_return_stmt(v_opt, vars, out, depth)
        Stmt.Block(stmts, _) => emit_block(stmts, vars, out, depth)
        Stmt.For(pattern, iterable, body, _) => emit_for_stmt(pattern, iterable, body, vars, out, depth)
        Stmt.While(condition, body, _) => emit_while_stmt(condition, body, vars, out, depth)
        Stmt.Break(label_opt, _) => emit_break_stmt(label_opt, vars, out, depth)
        Stmt.Continue(label_opt, _) => emit_continue_stmt(label_opt, vars, out, depth)
    }
}

// emit_stmts renders a list of statements in order, threading vars through.
pub fn emit_stmts(stmts []Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    return emit_stmts_from(stmts, 0, vars, out, depth)
}

fn emit_stmts_from(stmts []Stmt, i int, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    if i >= stmts.len {
        return vars
    }
    next = emit_stmt(stmts[i], vars, out, depth)
    return emit_stmts_from(stmts, i + 1, next, out, depth)
}

// emit_expr_stmt renders an expression in statement position. Assignments
// take the Go emitAssignStmt form (no parenthesised emit_assign from
// codegen_expr); every other expression is emit_expr + ";".
fn emit_expr_stmt(e Expr, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    if is_assign_expr(e) {
        emit_assign_stmt(e, vars, out, depth)
        return vars
    }
    bwriteln(out, depth, emit_expr(e, vars) + ";")
    return vars
}

fn is_assign_expr(e Expr) -> bool {
    return match e {
        Expr.Assign(_, _, _, _) => true
        _ => false
    }
}

// [РЕШЕНИЕ]: Go emitAssignStmt guards heap targets with release/retain and
// lowers slice-index targets to dot_slice_set; the MVP emits the plain C
// assignment only. Both arrive with ARC (stage 6) / the 4b pass.
// NOTE: the match is the body tail, NOT `return match` — a value-position
// match in a void fn makes the Go codegen emit `void _match_res` and marks
// every initialiser inside as heap-escaping (dot_alloc path), so
// statement-position dispatch is used like checker_stmt.check_stmt does.
fn emit_assign_stmt(e Expr, vars []VarInfo, out CBuilder, depth int) {
    match e {
        Expr.Assign(left, op, right, _) => {
            if left.len == 0 or right.len == 0 {
                bwriteln(out, depth, "/* bad assign */;")
                return
            }
            op_s = assign_op_str(op)
            if op_s.len == 0 {
                bwriteln(out, depth, emit_expr(e, vars) + ";")
                return
            }
            bwriteln(out, depth, emit_expr(left[0], vars) + " " + op_s + " " + emit_expr(right[0], vars) + ";")
        }
        _ => bwriteln(out, depth, emit_expr(e, vars) + ";")
    }
}

// emit_let renders a var declaration. The declared C type is the Let
// annotation when present (TypeNode -> checker Type -> C), else the
// inferred value type. Dot's Stmt.Let always carries an initialiser (the
// parser unwraps the value), so the no-init zero-value path of Go
// emitVarDecl does not exist here; heap values are plain pointer
// assignments (DotString* s = <expr>;). Multi-name declarations are not
// representable either: the parser keeps only the first name and folds the
// rest into a TupleLit value (parser.dot parse_multi_let).
fn emit_let(name string, ty_opt Option[TypeNode], value Expr, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    v_ty = let_decl_ty(ty_opt, value, vars)
    init = emit_expr(value, vars)
    bwriteln(out, depth, ty_to_c(v_ty) + " " + name + " = " + init + ";")
    vars.push(VarInfo { name, ty: v_ty })
    return vars
}

// let_decl_ty picks the declaration type: the annotation wins when present
// and resolvable, otherwise the inferred value type.
fn let_decl_ty(ty_opt Option[TypeNode], value Expr, vars []VarInfo) -> Type {
    if ty_node = ty_opt {
        ann_ty = tynode_to_ty(ty_node)
        if not is_unknown_ty(ann_ty) {
            return ann_ty
        }
    }
    return infer_type(value, vars)
}

// [РЕШЕНИЕ]: plain `return <expr>;`. Go emitReturnStmt materialises the
// value into a temp BEFORE scope cleanup and applies move/retain rules;
// without ARC (stage 6) there is no cleanup to order against, so the
// expression is returned in place.
fn emit_return_stmt(v_opt Option[Expr], vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    if v = v_opt {
        bwriteln(out, depth, "return " + emit_expr(v, vars) + ";")
    } else {
        bwriteln(out, depth, "return;")
    }
    return vars
}

// emit_block renders a brace block with +1 depth. Nested declarations are
// folded into vars (never removed — see header).
fn emit_block(stmts []Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    bwriteln(out, depth, "{{")
    inner_vars = emit_stmts(stmts, vars, out, depth + 1)
    bwriteln(out, depth, "}}")
    return inner_vars
}

// --- Stage 4b: While / For / Break / Continue ---

// emit_while_stmt renders `while (<cond>) { <body> }` (Go emitForStmt Kind
// ForCond). ast.dot has a dedicated Stmt.While because the self-hosted
// parser folds `for cond {...}` into it (parser.dot parse_for_stmt).
fn emit_while_stmt(condition Expr, body []Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    cond = emit_expr(condition, vars)
    bwriteln(out, depth, "while (" + cond + ") {{")
    inner_vars = emit_stmts(body, vars, out, depth + 1)
    bwriteln(out, depth, "}}")
    return inner_vars
}

// emit_for_stmt dispatches the two For shapes the self-hosted parser
// builds: Pattern.CatchAll is the infinite loop `for {}` (parse_for_stmt
// writes CatchAll + BoolLit(true)), Pattern.Ident is `for name in iterable`.
fn emit_for_stmt(pattern Pattern, iterable Expr, body []Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    match pattern {
        Pattern.CatchAll => { return emit_for_infinite(body, vars, out, depth) }
        Pattern.Ident(name) => { return emit_for_in(name, iterable, body, vars, out, depth) }
        _ => {}
    }
    bwriteln(out, depth, "/* <TODO 4b: for with unsupported pattern> */")
    return vars
}

// emit_for_infinite renders `for (;;) { <body> }` (Go emitForStmt Kind
// ForInfinite).
fn emit_for_infinite(body []Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    bwriteln(out, depth, "for (;;) {{")
    inner_vars = emit_stmts(body, vars, out, depth + 1)
    bwriteln(out, depth, "}}")
    return inner_vars
}

// emit_for_in picks the for-in form from the iterable: a Binary with
// DotDot/DotDotEq is the range `for x in lo..hi` (counted loop), slices
// and arrays go through dot_iter_slice, maps through dot_iter_map. Strings
// have no iterator runtime helper ([РЕШЕНИЕ]: dot_iter_slice takes
// DotSlice* only and DotString* has a different layout) — the stdlib never
// iterates strings, so the TODO covers it.
fn emit_for_in(name string, iterable Expr, body []Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    if for_is_range_expr(iterable) {
        return emit_for_range(name, iterable, body, vars, out, depth)
    }
    iter_ty = infer_type(iterable, vars)
    match iter_ty {
        Type.Slice(_) => { return emit_for_iter(name, iterable, iter_ty, body, vars, out, depth) }
        Type.Array(_) => { return emit_for_iter(name, iterable, iter_ty, body, vars, out, depth) }
        Type.Map(_, _) => { return emit_for_map(name, iterable, iter_ty, body, vars, out, depth) }
        _ => {}
    }
    bwriteln(out, depth, "/* <TODO 4b: for-in over unsupported iterable> */")
    return vars
}

// emit_for_range renders `for x in lo..hi` (DotDot) / `lo..=hi` (DotDotEq)
// as a counted C for loop with a private counter (Go emitForRange). The
// loop variable is a fresh declaration per iteration, so reassigning it in
// the body does not affect iteration (D63). Counter names embed depth, so
// nested and sibling loops cannot collide in C scope.
fn emit_for_range(name string, range_e Expr, body []Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    parts = for_range_parts(range_e, vars)
    counter = "_dot_range_" + int_to_str(depth)
    bwriteln(out, depth, "for (int64_t " + counter + " = " + parts[0] + "; " + counter + " " + parts[1] + " " + parts[2] + "; " + counter + "++) {{")
    bwriteln(out, depth + 1, "int64_t " + name + " = " + counter + ";")
    inner_vars = vars
    inner_vars.push(VarInfo { name, ty: Type.Int })
    inner = emit_stmts(body, inner_vars, out, depth + 1)
    bwriteln(out, depth, "}}")
    return inner
}

// for_range_parts extracts [lo, cmp, hi] from the DotDot binary. cmp is
// "<=" for inclusive ranges (DotDotEq), "<" otherwise. Missing bounds
// default to 0 (the parser always builds a full binary, so this is only a
// safety net).
fn for_range_parts(range_e Expr, vars []VarInfo) -> []string {
    match range_e {
        Expr.Binary(lo, op, hi, _) => {
            if for_is_inclusive_op(op) {
                return []string{for_range_bound(lo, vars), "<=", for_range_bound(hi, vars)}
            }
            return []string{for_range_bound(lo, vars), "<", for_range_bound(hi, vars)}
        }
        _ => {}
    }
    return []string{"0", "<", "0"}
}

fn for_range_bound(es []Expr, vars []VarInfo) -> string {
    if es.len > 0 {
        return emit_expr(es[0], vars)
    }
    return "0"
}

fn for_is_range_expr(e Expr) -> bool {
    match e {
        Expr.Binary(_, op, _, _) => { return for_is_range_op(op) }
        _ => {}
    }
    return false
}

fn for_is_range_op(op TokenType) -> bool {
    match op {
        TokenType.DotDot => { return true }
        TokenType.DotDotEq => { return true }
        _ => {}
    }
    return false
}

fn for_is_inclusive_op(op TokenType) -> bool {
    match op {
        TokenType.DotDotEq => { return true }
        _ => {}
    }
    return false
}

// emit_for_iter renders `for x in xs` for slice/array iterables as the Go
// emitForIterator runtime loop: a DotIter over dot_iter_slice and a
// while (dot_iter_next(...)) that copies each DotAny slot into the loop
// variable with a C cast. The whole thing is wrapped in a block so the
// iterator names cannot clash across sibling loops.
// [РЕШЕНИЕ] struct elements are NOT boxed on this MVP (no dot_box on
// slice stores yet — see emit_array_lit), so the Go dot_box_payload
// dereference branch is not needed; every element is a plain cast.
fn emit_for_iter(name string, iterable Expr, iter_ty Type, body []Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    elem = for_elem_ty(iter_ty)
    it = "_dot_it_" + int_to_str(depth)
    iv = "_dot_iv_" + int_to_str(depth)
    src = emit_expr(iterable, vars)
    bwriteln(out, depth, "{{")
    bwriteln(out, depth + 1, "DotIter " + it + " = dot_iter_slice(" + src + ");")
    bwriteln(out, depth + 1, "DotAny " + iv + " = NULL;")
    bwriteln(out, depth + 1, "while (dot_iter_next(&" + it + ", NULL, &" + iv + ")) {{")
    bwriteln(out, depth + 2, ty_to_c(elem) + " " + name + " = (" + ty_to_c(elem) + ")" + iv + ";")
    inner_vars = vars
    inner_vars.push(VarInfo { name, ty: elem })
    inner = emit_stmts(body, inner_vars, out, depth + 2)
    bwriteln(out, depth + 1, "}}")
    bwriteln(out, depth, "}}")
    return inner
}

// emit_for_map renders `for k, v in m` as a map iterator loop. ast.dot has
// a single pattern slot, and parse_for_stmt folds `for k, v in m` down to
// the FIRST binding (k), so the loop variable binds the map KEY
// ([РЕШЕНИЕ]: Go's single-variable form would bind the value, but the AST
// cannot tell the two spellings apart). The value lands in the DotAny slot
// and is discarded.
fn emit_for_map(name string, iterable Expr, iter_ty Type, body []Stmt, vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    key_ty = for_map_key_ty(iter_ty)
    it = "_dot_it_" + int_to_str(depth)
    iv = "_dot_iv_" + int_to_str(depth)
    src = emit_expr(iterable, vars)
    bwriteln(out, depth, "{{")
    bwriteln(out, depth + 1, "DotIter " + it + " = dot_iter_map(" + src + ");")
    bwriteln(out, depth + 1, ty_to_c(key_ty) + " " + name + " = " + zero_c_value(key_ty) + ";")
    bwriteln(out, depth + 1, "DotAny " + iv + " = NULL;")
    bwriteln(out, depth + 1, "while (dot_iter_next(&" + it + ", &" + name + ", &" + iv + ")) {{")
    inner_vars = vars
    inner_vars.push(VarInfo { name, ty: key_ty })
    inner = emit_stmts(body, inner_vars, out, depth + 2)
    bwriteln(out, depth + 1, "}}")
    bwriteln(out, depth, "}}")
    return inner
}

fn for_elem_ty(t Type) -> Type {
    match t {
        Type.Array(elem) => { return for_first_ty(elem) }
        Type.Slice(elem) => { return for_first_ty(elem) }
        _ => {}
    }
    return Type.Unknown
}

fn for_map_key_ty(t Type) -> Type {
    match t {
        Type.Map(key, _) => { return for_first_ty(key) }
        _ => {}
    }
    return Type.Unknown
}

fn for_first_ty(es []Type) -> Type {
    if es.len > 0 {
        return es[0]
    }
    return Type.Unknown
}

// emit_break_stmt renders `break;`. Labels are ignored: the self-hosted
// parser drops the loop label itself (parse_stmt consumes `@label` but
// stores nothing), so there is no C label a labeled break could goto —
// plain break is the only sound form ([РЕШЕНИЕ]; revisit if labels ever
// land in ast.dot).
fn emit_break_stmt(label_opt Option[string], vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    bwriteln(out, depth, "break;")
    return vars
}

// emit_continue_stmt renders `continue;`, labels ignored like break above.
fn emit_continue_stmt(label_opt Option[string], vars []VarInfo, out CBuilder, depth int) -> []VarInfo {
    bwriteln(out, depth, "continue;")
    return vars
}

// tynode_to_ty maps an AST TypeNode to the checker Type the annotation
// describes (mirror of Checker.resolve_type without type params; the
// codegen has no generic context). Pointer stays Unknown, same as the
// checker.
fn tynode_to_ty(node TypeNode) -> Type {
    return match node {
        TypeNode.Named(name, _) => named_ty(name)
        TypeNode.Array(elem_ty, _) => {
            if elem_ty.len > 0 {
                return Type.Array([]Type{tynode_to_ty(elem_ty[0])})
            }
            return Type.Unknown
        }
        TypeNode.Slice(elem_ty, _) => {
            if elem_ty.len > 0 {
                return Type.Slice([]Type{tynode_to_ty(elem_ty[0])})
            }
            return Type.Unknown
        }
        TypeNode.Map(key_ty, val_ty, _) => {
            if key_ty.len > 0 and val_ty.len > 0 {
                return Type.Map([]Type{tynode_to_ty(key_ty[0])}, []Type{tynode_to_ty(val_ty[0])})
            }
            return Type.Unknown
        }
        TypeNode.Func(params, ret_ty, _) => node_func_ty(params, ret_ty)
        TypeNode.Pointer(_, _) => Type.Unknown
    }
}

// named_ty resolves a Named TypeNode the way Checker.resolve_type does:
// builtins map to primitives, everything else is treated as a struct type.
fn named_ty(name string) -> Type {
    if str_eq(name, "int") {
        return Type.Int
    }
    if str_eq(name, "float") {
        return Type.Float
    }
    if str_eq(name, "bool") {
        return Type.Bool
    }
    if str_eq(name, "string") {
        return Type.String
    }
    return Type.Struct(name)
}

fn node_func_ty(params []TypeNode, ret_ty Option[TypeNode]) -> Type {
    p_types = []Type{}
    for p in params {
        p_types.push(tynode_to_ty(p))
    }
    r_ty = Type.Void
    if r = ret_ty {
        r_ty = tynode_to_ty(r)
    }
    return Type.Func(p_types, []Type{r_ty})
}

// bwrite_indent writes depth * 4 spaces (Go generator.line()).
fn bwrite_indent(b CBuilder, depth int) {
    i = 0
    for i < depth {
        bwrite(b, "    ")
        i += 1
    }
}

// bwriteln writes an indented line terminated by "\n".
fn bwriteln(b CBuilder, depth int, s string) {
    bwrite_indent(b, depth)
    bwrite(b, s)
    bwrite(b, "\n")
}
