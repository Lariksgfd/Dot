// stdlib/codegen_expr.dot - T-051 stages 3a+3b: expression emitter for the
// self-hosted C codegen. Port of Go codegen/emit_expr.go. Covered: literals,
// ident, unary, binary, if-expr (3a) and Call (plain + builtins), Index,
// Slice s[a..b] (Index with a DotDot range, see parser_pratt.dot), Field
// with .len/.cap builtin props (3b).
// ArrayLit/TupleLit/Match/Assign/FnLit/StructLit/MapLit land in stage 3c
// and emit a "<TODO>" marker for now.
//
// NOTE [РЕШЕНИЕ]: vars is a []VarInfo of name/type pairs, NOT map[string]Type.
// The stdlib stays map-free so the self-hosted codegen never has to emit map
// operations (T-052 self-compile); types.dot Scope emulates a map with a
// []Symbol the same way. Linear lookup is fine for an MVP.
import ast
import types
import codegen
import codegen_types

pub struct VarInfo {
    name string
    ty   Type
}

// infer_type is minimal expression type inference. The self-hosted codegen
// has no checker side-table, so operand types are recomputed on demand
// (T-051 design decision). Unknown propagates where a rule gives no answer.
pub fn infer_type(e Expr, vars []VarInfo) -> Type {
    return match e {
        Expr.IntLit(_, _) => Type.Int
        Expr.FloatLit(_, _) => Type.Float
        Expr.StringLit(_, _) => Type.String
        Expr.BoolLit(_, _) => Type.Bool
        Expr.NilLit(_) => Type.Nil
        Expr.Ident(name, _) => var_type(vars, name)
        Expr.Unary(op, right, _) => infer_unary_type(right, op, vars)
        Expr.Binary(left, op, right, _) => infer_binary_type(left, op, right, vars)
        Expr.If(_, then_branch, _, _) => infer_if_type(then_branch, vars)
        Expr.Call(_, _, _) => Type.Unknown
        Expr.Index(left, index, _) => infer_index_type(left, index, vars)
        Expr.Field(_, _, _) => Type.Unknown
        _ => Type.Unknown
    }
}

// infer_index_type: an index yields the element type of its container;
// a range expression s[a..b] yields the container type itself (slice of
// slice / string of string), mirroring checker.check_index/slice_type.
fn infer_index_type(left []Expr, index []Expr, vars []VarInfo) -> Type {
    if left.len == 0 or index.len == 0 {
        return Type.Unknown
    }
    left_ty = infer_type(left[0], vars)
    if is_range_index(index[0]) {
        return left_ty
    }
    return match left_ty {
        Type.Array(elem) => elem_of(elem)
        Type.Slice(elem) => elem_of(elem)
        Type.String => Type.Int
        _ => Type.Unknown
    }
}

fn elem_of(elem []Type) -> Type {
    if elem.len > 0 {
        return elem[0]
    }
    return Type.Unknown
}

// var_type returns the inferred type of name, or Type.Unknown when the
// name is not in vars.
fn var_type(vars []VarInfo, name string) -> Type {
    i = 0
    for i < vars.len {
        if vars[i].name == name {
            return vars[i].ty
        }
        i += 1
    }
    return Type.Unknown
}

fn infer_unary_type(right []Expr, op TokenType, vars []VarInfo) -> Type {
    if right.len == 0 {
        return Type.Unknown
    }
    return match op {
        TokenType.Not => Type.Bool
        TokenType.Minus => infer_type(right[0], vars)
        _ => infer_type(right[0], vars)
    }
}

fn infer_binary_type(left []Expr, op TokenType, right []Expr, vars []VarInfo) -> Type {
    if left.len == 0 or right.len == 0 {
        return Type.Unknown
    }
    l_ty = infer_type(left[0], vars)
    r_ty = infer_type(right[0], vars)
    return match op {
        TokenType.EqEq => Type.Bool
        TokenType.BangEq => Type.Bool
        TokenType.Lt => Type.Bool
        TokenType.Gt => Type.Bool
        TokenType.LtEq => Type.Bool
        TokenType.GtEq => Type.Bool
        TokenType.And => Type.Bool
        TokenType.Or => Type.Bool
        TokenType.Plus => {
            if is_string_ty(l_ty) or is_string_ty(r_ty) {
                return Type.String
            }
            return l_ty
        }
        TokenType.Minus => num_ty(l_ty, r_ty)
        TokenType.Star => num_ty(l_ty, r_ty)
        TokenType.Slash => num_ty(l_ty, r_ty)
        TokenType.Percent => num_ty(l_ty, r_ty)
        TokenType.StarStar => num_ty(l_ty, r_ty)
        TokenType.Amp => Type.Int
        TokenType.Pipe => Type.Int
        TokenType.Caret => Type.Int
        TokenType.Shl => Type.Int
        TokenType.Shr => Type.Int
        _ => Type.Unknown
    }
}

// num_ty: arithmetic result is Int only when both operands are Int, Float
// otherwise (mirrors the T-051 rule for -,*,/,**,%).
fn num_ty(l_ty Type, r_ty Type) -> Type {
    if is_int_ty(l_ty) and is_int_ty(r_ty) {
        return Type.Int
    }
    return Type.Float
}

fn is_string_ty(t Type) -> bool {
    return match t {
        Type.String => true
        _ => false
    }
}

fn is_int_ty(t Type) -> bool {
    return match t {
        Type.Int => true
        _ => false
    }
}

// The value type of an if-expr is the type of the then-branch's last
// expression statement (same rule as checker.check_if_then).
fn infer_if_type(then_branch []Stmt, vars []VarInfo) -> Type {
    return if_then_type(then_branch, 0, Type.Unknown, vars)
}

fn if_then_type(stmts []Stmt, i int, acc Type, vars []VarInfo) -> Type {
    if i >= stmts.len {
        return acc
    }
    return match stmts[i] {
        Stmt.ExprStmt(e, _) => if_then_type(stmts, i + 1, infer_type(e, vars), vars)
        _ => if_then_type(stmts, i + 1, acc, vars)
    }
}

// emit_expr renders a Dot expression as a C expression string. Unsupported
// nodes (stages 3b/3c) yield a "<TODO>" marker.
pub fn emit_expr(e Expr, vars []VarInfo) -> string {
    return match e {
        Expr.IntLit(value, _) => int_to_str(value)
        Expr.FloatLit(value, _) => float_to_str(value)
        Expr.StringLit(value, _) => literal_to_c(value, "string")
        Expr.BoolLit(value, _) => {
            if value {
                return "true"
            }
            return "false"
        }
        Expr.NilLit(_) => "NULL"
        Expr.Ident(name, _) => name
        Expr.Unary(op, right, _) => emit_unary(right, op, vars)
        Expr.Binary(left, op, right, _) => emit_binary(left, op, right, vars)
        Expr.If(condition, then_branch, else_branch, _) => emit_if_expr(condition, then_branch, else_branch, vars)
        Expr.Call(callee, args, _) => emit_call(callee, args, vars)
        Expr.Index(left, index, _) => emit_index(left, index, vars)
        Expr.Field(left, name, _) => emit_field(left, name, vars)
        _ => "<TODO>"
    }
}

fn emit_unary(right []Expr, op TokenType, vars []VarInfo) -> string {
    if right.len == 0 {
        return "<TODO>"
    }
    inner = emit_expr(right[0], vars)
    return match op {
        TokenType.Not => "!(" + inner + ")"
        TokenType.Minus => "-(" + inner + ")"
        _ => "<TODO>"
    }
}

// emit_binary reuses the стаб's binop_typed_to_c: it already picks the
// right C for string concat/eq and pow_int/pow_float from the operand
// type tags, so no operator logic is duplicated here.
fn emit_binary(left []Expr, op TokenType, right []Expr, vars []VarInfo) -> string {
    if left.len == 0 or right.len == 0 {
        return "<TODO>"
    }
    lhs = emit_expr(left[0], vars)
    rhs = emit_expr(right[0], vars)
    l_ty = infer_type(left[0], vars)
    r_ty = infer_type(right[0], vars)
    op_str = binop_str(op)
    if op_str.len == 0 {
        return "<TODO>"
    }
    return binop_typed_to_c(op_str, lhs, rhs, ty_tag(l_ty), ty_tag(r_ty))
}

// binop_str maps a TokenType operator to the string the стаб understands.
fn binop_str(op TokenType) -> string {
    return match op {
        TokenType.Plus => "+"
        TokenType.Minus => "-"
        TokenType.Star => "*"
        TokenType.Slash => "/"
        TokenType.Percent => "%"
        TokenType.StarStar => "**"
        TokenType.EqEq => "=="
        TokenType.BangEq => "!="
        TokenType.Lt => "<"
        TokenType.Gt => ">"
        TokenType.LtEq => "<="
        TokenType.GtEq => ">="
        TokenType.And => "and"
        TokenType.Or => "or"
        TokenType.Amp => "&"
        TokenType.Pipe => "|"
        TokenType.Caret => "^"
        TokenType.Shl => "<<"
        TokenType.Shr => ">>"
        _ => ""
    }
}

// ty_tag renders a checker Type as the small tag that the стаб's
// binop_typed_to_c understands: "string", "float", "int", "" otherwise.
fn ty_tag(t Type) -> string {
    return match t {
        Type.Int => "int"
        Type.Float => "float"
        Type.String => "string"
        _ => ""
    }
}

// The then-branch value is the last expression statement; the else-branch
// value is the last element of the else slice (checker.check_else_branch
// rule). Both fall back to a marker when absent.
fn emit_if_expr(condition []Expr, then_branch []Stmt, else_branch []Expr, vars []VarInfo) -> string {
    if condition.len == 0 {
        return "<TODO>"
    }
    cond = emit_expr(condition[0], vars)
    then_e = then_value(then_branch, vars)
    else_e = else_value(else_branch, vars)
    return ifexpr_to_c(cond, then_e, else_e)
}

fn then_value(stmts []Stmt, vars []VarInfo) -> string {
    return then_value_of(stmts, 0, "<TODO>", vars)
}

fn then_value_of(stmts []Stmt, i int, acc string, vars []VarInfo) -> string {
    if i >= stmts.len {
        return acc
    }
    return match stmts[i] {
        Stmt.ExprStmt(e, _) => then_value_of(stmts, i + 1, emit_expr(e, vars), vars)
        _ => then_value_of(stmts, i + 1, acc, vars)
    }
}

fn else_value(else_branch []Expr, vars []VarInfo) -> string {
    if else_branch.len > 0 {
        return emit_expr(else_branch[else_branch.len - 1], vars)
    }
    return "<TODO>"
}

// float_to_str prints a float64 as the shortest plain decimal C literal:
// no exponent, trailing fraction zeros stripped, integer values without a
// dot. Fraction digits are extracted by repeated multiply-by-10 truncation
// capped at 15 digits, with round-half-up + carry at the cutoff, so a
// literal like 3.14 prints "3.14", not the raw binary expansion tail.
fn float_to_str(v float) -> string {
    if v == 0.0 {
        return "0"
    }
    if v < 0.0 {
        return "-" + float_to_str(-v)
    }
    whole = v as int
    frac = v - (whole as float)
    if frac == 0.0 {
        return int_to_str(whole)
    }
    digits = frac_digits(frac)
    if digits.len == 0 {
        // The fraction rounded up to 1.0 (all digits carried): the value
        // prints as the next integer.
        return int_to_str(whole + 1)
    }
    return int_to_str(whole) + "." + digits
}

fn frac_digits(frac float) -> string {
    b = new_builder()
    rem = frac_digits_into(b, frac, 15)
    if rem >= 0.5 {
        if not bump_last_digit(b) {
            return ""
        }
    }
    return trim_trailing_zeros(bfinish(b))
}

// frac_digits_into pushes the truncated decimal digits of frac
// (0 < frac < 1), stopping early when the remainder is exactly zero, and
// returns the remaining fraction after the last pushed digit (0.0 when
// exhausted). The caller rounds the cutoff digit from this remainder.
fn frac_digits_into(b CBuilder, frac float, left int) -> float {
    if left <= 0 {
        return frac
    }
    if frac == 0.0 {
        return 0.0
    }
    next = frac * 10.0
    d = next as int
    rem = next - (d as float)
    b.buf.push((48 + d) as uint8)
    if rem == 0.0 {
        return 0.0
    }
    return frac_digits_into(b, rem, left - 1)
}

// bump_last_digit increments the last pushed digit with carry ('9' -> '0'
// and carry on). Returns false when the carry runs past the first digit
// (all digits were '9').
fn bump_last_digit(b CBuilder) -> bool {
    i = b.buf.len - 1
    for i >= 0 {
        if b.buf[i] == 57 {
            b.buf[i] = 48
            i -= 1
        } else {
            b.buf[i] = b.buf[i] + 1
            return true
        }
    }
    return false
}

fn trim_trailing_zeros(s string) -> string {
    if s.len == 0 {
        return ""
    }
    if s[s.len - 1] == 48 {
        return trim_trailing_zeros(s[0..s.len - 1])
    }
    return s
}

// --- Stage 3b: Call / Index / Slice / Field + builtins ---

// emit_call: plain function calls use the Dot_-prefixed C name (Go fndecl
// emits "Dot_" + Name), builtins map to their runtime helpers.
fn emit_call(callee []Expr, args []Expr, vars []VarInfo) -> string {
    if callee.len == 0 {
        return "<TODO>"
    }
    return match callee[0] {
        Expr.Ident(name, _) => emit_call_by_name(name, args, vars)
        Expr.Field(recv, name, _) => emit_method_call(recv, name, args, vars)
        _ => "<TODO>"
    }
}

// emit_call_by_name dispatches on the callee name. print/println/eprint pack
// every argument into a DotSlice* via dot_slice_pack (Go emitVariadicCall);
// len/input/type_of/panic take their single argument directly (Go
// emitBuiltinCall). Zero-value defaults for a missing argument mirror Go's
// emitArg: "NULL" for string params (input, panic), "0" for DotAny ones
// (len, type_of).
fn emit_call_by_name(name string, args []Expr, vars []VarInfo) -> string {
    if str_eq(name, "print") {
        return "dot_print(" + emit_variadic_pack(args, vars) + ")"
    }
    if str_eq(name, "println") {
        return "dot_println(" + emit_variadic_pack(args, vars) + ")"
    }
    if str_eq(name, "eprint") {
        return "dot_eprint(" + emit_variadic_pack(args, vars) + ")"
    }
    if str_eq(name, "len") {
        return "dot_len(" + emit_first_arg(args, vars, "0") + ")"
    }
    if str_eq(name, "input") {
        return "dot_input(" + emit_first_arg(args, vars, "NULL") + ")"
    }
    if str_eq(name, "type_of") {
        return "dot_typeof(" + emit_first_arg(args, vars, "0") + ")"
    }
    if str_eq(name, "panic") {
        return "dot_panic(" + emit_first_arg(args, vars, "NULL") + ")"
    }
    return "Dot_" + name + "(" + emit_plain_args(args, vars) + ")"
}

// [РЕШЕНИЕ]: method calls on struct receivers emit as Dot_<Struct>_<Method>
// with the receiver as first argument (Go methodName = "Dot_" + Owner.Name +
// "_" + Method.Name, emitMethodCall). Only struct receivers are covered:
// builtin methods (items.push, ...) and static Type.method calls need the
// checker's selection info which the self-hosted codegen does not carry, so
// they stay "<TODO>" until stage 5 wires declarations into vars.
fn emit_method_call(recv []Expr, name string, args []Expr, vars []VarInfo) -> string {
    if recv.len == 0 {
        return "<TODO>"
    }
    r_ty = infer_type(recv[0], vars)
    return match r_ty {
        Type.Struct(sname) => "Dot_" + sname + "_" + name + "(" + emit_expr(recv[0], vars) + method_args_join(args, vars, 0) + ")"
        _ => "<TODO>"
    }
}

fn method_args_join(args []Expr, vars []VarInfo, i int) -> string {
    if i >= args.len {
        return ""
    }
    return ", " + emit_expr(args[i], vars) + method_args_join(args, vars, i + 1)
}

fn emit_first_arg(args []Expr, vars []VarInfo, zero string) -> string {
    if args.len > 0 {
        return emit_expr(args[0], vars)
    }
    return zero
}

fn emit_plain_args(args []Expr, vars []VarInfo) -> string {
    return plain_args_join(args, vars, 0)
}

fn plain_args_join(args []Expr, vars []VarInfo, i int) -> string {
    if i >= args.len {
        return ""
    }
    cur = emit_expr(args[i], vars)
    if i == args.len - 1 {
        return cur
    }
    return cur + ", " + plain_args_join(args, vars, i + 1)
}

// emit_variadic_pack renders dot_slice_pack(N, (DotAny[]){...}) for a
// variadic builtin call. Non-heap values (int/float/bool) are smuggled
// through DotAny slots as intptr_t, exactly like Go emitVariadicCall
// (isPointerLike check); heap values (string/slice/struct/...) pass through
// as pointers.
fn emit_variadic_pack(args []Expr, vars []VarInfo) -> string {
    packed = pack_args(args, vars, 0)
    return "dot_slice_pack(" + int_to_str(args.len) + ", (DotAny[]){{" + packed + "}})"
}

fn pack_args(args []Expr, vars []VarInfo, i int) -> string {
    if i >= args.len {
        return ""
    }
    one = pack_arg(args, vars, i)
    if i == args.len - 1 {
        return one
    }
    return one + ", " + pack_args(args, vars, i + 1)
}

fn pack_arg(args []Expr, vars []VarInfo, i int) -> string {
    val = emit_expr(args[i], vars)
    if is_heap(infer_type(args[i], vars)) {
        return val
    }
    return "(DotAny)(intptr_t)(" + val + ")"
}

// is_range_index detects the slice spelling s[a..b]: the parser lowers it to
// Index(left, [Binary(a, DotDot|DotDotEq, b)]) (parser_pratt.dot has no
// SliceExpr variant).
fn is_range_index(e Expr) -> bool {
    return match e {
        Expr.Binary(_, op, _, _) => is_range_op_of(op)
        _ => false
    }
}

fn is_range_op_of(op TokenType) -> bool {
    return match op {
        TokenType.DotDot => true
        TokenType.DotDotEq => true
        _ => false
    }
}

// emit_index: strings index into the DotString payload (Go emitIndex
// KindString branch); slices and fixed arrays go through dot_slice_get (the
// MVP lowers Array to DotSlice* too, see codegen_types.dot).
fn emit_index(left []Expr, index []Expr, vars []VarInfo) -> string {
    if left.len == 0 or index.len == 0 {
        return "<TODO>"
    }
    if is_range_index(index[0]) {
        return emit_slice_expr(left[0], index[0], vars)
    }
    obj = emit_expr(left[0], vars)
    idx = emit_expr(index[0], vars)
    left_ty = infer_type(left[0], vars)
    return match left_ty {
        Type.String => "((DotString*)" + obj + ")->data[" + idx + "]"
        Type.Slice(_) => emit_slice_get(obj, idx, left_ty)
        Type.Array(_) => emit_slice_get(obj, idx, left_ty)
        _ => "<TODO>"
    }
}

// emit_slice_get wraps dot_slice_get; when the element type is a known
// scalar the DotAny slot is unwrapped with the C cast Go emitIndex emits
// ((%s)(intptr_t)dot_slice_get(...)).
fn emit_slice_get(obj string, idx string, left_ty Type) -> string {
    call = "dot_slice_get(" + obj + ", " + idx + ")"
    elem = index_elem_ty(left_ty)
    if is_scalar_ty(elem) {
        return "((" + ty_to_c(elem) + ")(intptr_t)" + call + ")"
    }
    return call
}

fn index_elem_ty(t Type) -> Type {
    return match t {
        Type.Array(elem) => elem_of(elem)
        Type.Slice(elem) => elem_of(elem)
        _ => Type.Unknown
    }
}

fn is_scalar_ty(t Type) -> bool {
    return match t {
        Type.Int => true
        Type.Float => true
        Type.Bool => true
        _ => false
    }
}

// emit_slice_expr renders s[a..b] (Index with a DotDot range) as
// dot_slice_sub(obj, lo, hi, inclusive), Go emitSlice. Strings have no sub
// helper in the runtime, so the Go form rebuilds a DotString from the
// sub-sliced bytes. Missing bounds default to 0 / dot_slice_len(obj); ..=
// (DotDotEq) makes the range inclusive.
fn emit_slice_expr(obj_e Expr, range_e Expr, vars []VarInfo) -> string {
    return match range_e {
        Expr.Binary(lo, op, hi, _) => emit_slice_parts(obj_e, lo, op, hi, vars)
        _ => "<TODO>"
    }
}

fn emit_slice_parts(obj_e Expr, lo []Expr, op TokenType, hi []Expr, vars []VarInfo) -> string {
    obj = emit_expr(obj_e, vars)
    lo_s = slice_lo(lo, vars)
    hi_s = slice_hi(hi, obj, vars)
    inc_s = range_inc_str(op)
    sub = "dot_slice_sub(" + obj + ", " + lo_s + ", " + hi_s + ", " + inc_s + ")"
    if is_string_ty(infer_type(obj_e, vars)) {
        return "dot_string_from_bytes(dot_slice_sub(dot_string_to_bytes(" + obj + "), " + lo_s + ", " + hi_s + ", " + inc_s + "))"
    }
    return sub
}

fn slice_lo(lo []Expr, vars []VarInfo) -> string {
    if lo.len > 0 {
        return emit_expr(lo[0], vars)
    }
    return "0"
}

fn slice_hi(hi []Expr, obj string, vars []VarInfo) -> string {
    if hi.len > 0 {
        return emit_expr(hi[0], vars)
    }
    return "dot_slice_len(" + obj + ")"
}

fn range_inc_str(op TokenType) -> string {
    return match op {
        TokenType.DotDotEq => "true"
        _ => "false"
    }
}

// emit_field: struct fields are dot_-prefixed C members reached through the
// heap pointer (cFieldName types.go:301); strings and slices expose the
// .len (and slices .cap) builtin props (Go emitBuiltinProp).
fn emit_field(left []Expr, name string, vars []VarInfo) -> string {
    if left.len == 0 {
        return "<TODO>"
    }
    obj = emit_expr(left[0], vars)
    t = infer_type(left[0], vars)
    return match t {
        Type.String => {
            if str_eq(name, "len") {
                return "((DotString*)" + obj + ")->len"
            }
            return "<TODO>"
        }
        Type.Slice(_) => emit_slice_prop(obj, name)
        Type.Array(_) => emit_slice_prop(obj, name)
        Type.Struct(_) => obj + "->dot_" + name
        _ => "<TODO>"
    }
}

fn emit_slice_prop(obj string, name string) -> string {
    if str_eq(name, "len") {
        return "dot_slice_len(" + obj + ")"
    }
    if str_eq(name, "cap") {
        return "dot_slice_cap(" + obj + ")"
    }
    return "<TODO>"
}
