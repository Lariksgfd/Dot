// stdlib/codegen_expr.dot - T-051 stages 3a-3c: expression emitter for the
// self-hosted C codegen. Port of Go codegen/emit_expr.go. Covered: literals,
// ident, unary, binary, if-expr (3a); Call (plain + builtins), Index,
// Slice s[a..b] (Index with a DotDot range, see parser_pratt.dot), Field
// with .len/.cap builtin props (3b); Match (ternary chain), ArrayLit,
// StructLit, MapLit, Assign (3c). TupleLit stays "<TODO>" (the checker has
// no Type.Tuple yet), as does FnLit until closures land.
//
// Stage 7b (self-compile): the public emit_expr/infer_type keep their
// plain (e, vars) signatures (compiler_test.dot calls them directly), but
// all real work lives in emit_expr_full/infer_type_full which ALSO thread
// a fn signature registry (sigs []FnSig). A Call whose callee is a known
// fn name now infers its declared return type, so `s = g()` without an
// annotation emits `DotString* s = Dot_g();` instead of `void*` (T-051 7b).
//
// NOTE [РЕШЕНИЕ]: vars is a []VarInfo of name/type pairs, NOT map[string]Type.
// The stdlib stays map-free so the self-hosted codegen never has to emit map
// operations (T-052 self-compile); types.dot Scope emulates a map with a
// []Symbol the same way. Linear lookup is fine for an MVP.
import ast
import types
import codegen
import codegen_types
import codegen_stmt

pub struct VarInfo {
    name string
    ty   Type
}

// FnSig is one entry of the fn signature registry: the C-visible name
// ("name" for free fns, "Recv_Method" for impl methods — the same spelling
// emit_method_def/emit_call build) and the declared return type.
pub struct FnSig {
    name string
    ret  Type
}

// StructFieldInfo is one field of the struct field registry: the field
// name and its checker Type (resolved from the AST annotation via
// tynode_to_ty, the same resolver fn params use).
pub struct StructFieldInfo {
    name string
    ty   Type
}

// CodegenStructInfo is one entry of the struct field registry (stage 7d-C):
// the struct's name plus its field list. Named CodegenStructInfo to avoid
// clashing with the checker's StructInfo side-table.
pub struct CodegenStructInfo {
    name   string
    fields []StructFieldInfo
}

// infer_type is the public wrapper: no registry, every Call stays Unknown
// (the c199 form).
pub fn infer_type(e Expr, vars []VarInfo) -> Type {
    return infer_type_full(e, vars, []FnSig{}, []CodegenStructInfo{})
}

// infer_type_full is minimal expression type inference. The self-hosted
// codegen has no checker side-table, so operand types are recomputed on
// demand (T-051 design decision). Unknown propagates where a rule gives no
// answer.
fn infer_type_full(e Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    return match e {
        Expr.IntLit(_, _) => Type.Int
        Expr.FloatLit(_, _) => Type.Float
        Expr.StringLit(_, _) => Type.String
        Expr.BoolLit(_, _) => Type.Bool
        Expr.NilLit(_) => Type.Nil
        Expr.Ident(name, _) => var_type(vars, name)
        Expr.Unary(op, right, _) => infer_unary_type(right, op, vars, sigs, structs)
        Expr.Binary(left, op, right, _) => infer_binary_type(left, op, right, vars, sigs, structs)
        Expr.If(_, then_branch, _, _) => infer_if_type(then_branch, vars, sigs, structs)
        // [РЕШЕНИЕ] 7b: a Call on an Ident callee whose name is in the fn
        // registry yields the declared return type; a method call (callee
        // is a Field) needs the checker's selection info and stays Unknown.
        Expr.Call(callee, _, _) => call_ty(callee, vars, sigs, structs)
        Expr.Index(left, index, _) => infer_index_type(left, index, vars, sigs, structs)
        Expr.Field(left, name, _) => infer_field_ty(left, name, vars, sigs, structs)
        Expr.ArrayLit(elements, _) => Type.Array([]Type{array_lit_elem_ty(elements, 0, Type.Unknown, vars, sigs, structs)})
        Expr.TupleLit(elements, _) => tuple_lit_ty(elements, vars, sigs, structs)
        Expr.Match(_, arms, _) => match_first_arm_ty(arms, vars, sigs, structs)
        // Block in match-arm position: the value is the tail expression's
        // type (checker.check_fn_body_tail rule, A1/A2).
        Expr.Block(body, _) => infer_block_ty(body, 0, Type.Unknown, vars, sigs, structs)
        Expr.Assign(_, _, right, _) => assign_value_ty(right, vars, sigs, structs)
        Expr.StructLit(name, _, _) => Type.Struct(name)
        Expr.MapLit(entries, _) => map_lit_ty(entries, vars, sigs, structs)
        _ => Type.Unknown
    }
}

// call_ty resolves the return type of a Call expression: an Ident callee
// found in the fn registry yields its declared return type; a Field callee
// on a slice receiver resolves through the slice builtin table (push is
// Void). Everything else (struct method callees, unknown names, missing
// callee) stays Unknown.
fn call_ty(callee []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if callee.len == 0 {
        return Type.Unknown
    }
    return match callee[0] {
        Expr.Ident(n, _) => sig_ret(sigs, n)
        Expr.Field(recv, name, _) => method_call_ty(recv, name, vars, sigs, structs)
        _ => Type.Unknown
    }
}

// method_call_ty resolves the return type of a Field-callee method call:
// slice builtins known to the runtime (push -> Void) resolve, everything
// else (struct methods, unknown builtins) stays Unknown.
fn method_call_ty(recv []Expr, name string, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if recv.len == 0 {
        return Type.Unknown
    }
    r_ty = infer_type_full(recv[0], vars, sigs, structs)
    return match r_ty {
        Type.Slice(_) => slice_builtin_ret_ty(name)
        _ => Type.Unknown
    }
}

// slice_builtin_ret_ty maps a slice builtin method name to its return type
// (Go builtin_methods_slice.go): push is Void, len/cap are properties (not
// calls) handled by infer_field_ty. Methods without a runtime helper yet
// (pop, insert, contains, ...) stay Unknown.
fn slice_builtin_ret_ty(name string) -> Type {
    if str_eq(name, "push") {
        return Type.Void
    }
    return Type.Unknown
}

// sig_ret linear-searches the fn registry for name and returns its
// declared return type, Unknown when absent.
fn sig_ret(sigs []FnSig, name string) -> Type {
    i = 0
    for i < sigs.len {
        if str_eq(sigs[i].name, name) {
            return sigs[i].ret
        }
        i += 1
    }
    return Type.Unknown
}

// infer_index_type: an index yields the element type of its container;
// a range expression s[a..b] yields the container type itself (slice of
// slice / string of string), mirroring checker.check_index/slice_type.
fn infer_index_type(left []Expr, index []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if left.len == 0 or index.len == 0 {
        return Type.Unknown
    }
    left_ty = infer_type_full(left[0], vars, sigs, structs)
    if is_range_index(index[0]) {
        return left_ty
    }
    return match left_ty {
        Type.Array(elem) => elem_of(elem)
        Type.Slice(elem) => elem_of(elem)
        Type.String => Type.Int
        _ => Type.Unknown
    }
}

fn elem_of(elem []Type) -> Type {
    if elem.len > 0 {
        return elem[0]
    }
    return Type.Unknown
}

// infer_field_ty types a field access (stage 7d-C): a struct field looks
// up the field registry, string/slice/array/map `.len`/`.cap` are builtin
// properties. Everything else (enum payloads, unknown names) stays Unknown.
fn infer_field_ty(left []Expr, name string, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if left.len == 0 {
        return Type.Unknown
    }
    lt = infer_type_full(left[0], vars, sigs, structs)
    return match lt {
        Type.Struct(sname) => struct_field_ty(structs, sname, name)
        Type.String => {
            if str_eq(name, "len") {
                return Type.Int
            }
            return Type.Unknown
        }
        Type.Slice(_) => slice_prop_ty(name)
        Type.Array(_) => slice_prop_ty(name)
        Type.Map(_, _) => slice_prop_ty(name)
        _ => Type.Unknown
    }
}

// struct_field_ty linear-searches the struct registry for the struct, then
// its field list for the field (mirror of checker.find_struct_field,
// checker_expr.dot:707). Not found -> Unknown.
fn struct_field_ty(structs []CodegenStructInfo, sname string, name string) -> Type {
    i = 0
    for i < structs.len {
        if str_eq(structs[i].name, sname) {
            return struct_fields_find(structs[i].fields, name)
        }
        i += 1
    }
    return Type.Unknown
}

fn struct_fields_find(fields []StructFieldInfo, name string) -> Type {
    i = 0
    for i < fields.len {
        if str_eq(fields[i].name, name) {
            return fields[i].ty
        }
        i += 1
    }
    return Type.Unknown
}

// slice_prop_ty: `.len` and `.cap` on slice/array/map receivers are Int
// builtin properties; any other property name stays Unknown.
fn slice_prop_ty(name string) -> Type {
    if str_eq(name, "len") or str_eq(name, "cap") {
        return Type.Int
    }
    return Type.Unknown
}

// var_type returns the inferred type of name, or Type.Unknown when the
// name is not in vars.
fn var_type(vars []VarInfo, name string) -> Type {
    i = 0
    for i < vars.len {
        if vars[i].name == name {
            return vars[i].ty
        }
        i += 1
    }
    return Type.Unknown
}

fn infer_unary_type(right []Expr, op TokenType, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if right.len == 0 {
        return Type.Unknown
    }
    return match op {
        TokenType.Not => Type.Bool
        TokenType.Minus => infer_type_full(right[0], vars, sigs, structs)
        _ => infer_type_full(right[0], vars, sigs, structs)
    }
}

fn infer_binary_type(left []Expr, op TokenType, right []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if left.len == 0 or right.len == 0 {
        return Type.Unknown
    }
    l_ty = infer_type_full(left[0], vars, sigs, structs)
    r_ty = infer_type_full(right[0], vars, sigs, structs)
    return match op {
        TokenType.EqEq => Type.Bool
        TokenType.BangEq => Type.Bool
        TokenType.Lt => Type.Bool
        TokenType.Gt => Type.Bool
        TokenType.LtEq => Type.Bool
        TokenType.GtEq => Type.Bool
        TokenType.And => Type.Bool
        TokenType.Or => Type.Bool
        TokenType.Plus => {
            if is_string_ty(l_ty) or is_string_ty(r_ty) {
                return Type.String
            }
            return l_ty
        }
        TokenType.Minus => num_ty(l_ty, r_ty)
        TokenType.Star => num_ty(l_ty, r_ty)
        TokenType.Slash => num_ty(l_ty, r_ty)
        TokenType.Percent => num_ty(l_ty, r_ty)
        TokenType.StarStar => num_ty(l_ty, r_ty)
        TokenType.Amp => Type.Int
        TokenType.Pipe => Type.Int
        TokenType.Caret => Type.Int
        TokenType.Shl => Type.Int
        TokenType.Shr => Type.Int
        _ => Type.Unknown
    }
}

// num_ty: arithmetic result is Int only when both operands are Int, Float
// otherwise (mirrors the T-051 rule for -,*,/,**,%).
fn num_ty(l_ty Type, r_ty Type) -> Type {
    if is_int_ty(l_ty) and is_int_ty(r_ty) {
        return Type.Int
    }
    return Type.Float
}

fn is_string_ty(t Type) -> bool {
    return match t {
        Type.String => true
        _ => false
    }
}

fn is_int_ty(t Type) -> bool {
    return match t {
        Type.Int => true
        _ => false
    }
}

// The value type of an if-expr is the type of the then-branch's last
// expression statement (same rule as checker.check_if_then).
fn infer_if_type(then_branch []Stmt, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    return if_then_type(then_branch, 0, Type.Unknown, vars, sigs, structs)
}

fn if_then_type(stmts []Stmt, i int, acc Type, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if i >= stmts.len {
        return acc
    }
    return match stmts[i] {
        Stmt.ExprStmt(e, _) => if_then_type(stmts, i + 1, infer_type_full(e, vars, sigs, structs), vars, sigs, structs)
        _ => if_then_type(stmts, i + 1, acc, vars, sigs, structs)
    }
}

// infer_block_ty computes the value type of an Expr.Block: the walk threads
// Lets into vars (the emit path does the same via emit_stmts_ctx), and the
// type of the LAST expression statement wins (checker.check_fn_body_tail
// rule; Lets contribute nothing themselves). A tail reading a block-local
// Let therefore resolves, e.g. `0 => { y = x + 1\ny + 10 }` types as Int.
fn infer_block_ty(stmts []Stmt, i int, acc Type, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if i >= stmts.len {
        return acc
    }
    match stmts[i] {
        Stmt.ExprStmt(e, _) => { return infer_block_ty(stmts, i + 1, infer_type_full(e, vars, sigs, structs), vars, sigs, structs) }
        Stmt.Let(name, _, value, _, _) => {
            v_ty = infer_type_full(value, vars, sigs, structs)
            next_vars = vars
            next_vars.push(VarInfo { name, ty: v_ty })
            return infer_block_ty(stmts, i + 1, acc, next_vars, sigs, structs)
        }
        _ => { return infer_block_ty(stmts, i + 1, acc, vars, sigs, structs) }
    }
}

// emit_expr is the public wrapper (no fn registry) around emit_expr_full.
pub fn emit_expr(e Expr, vars []VarInfo) -> string {
    return emit_expr_full(e, vars, []FnSig{}, []CodegenStructInfo{})
}

// emit_expr_full renders a Dot expression as a C expression string.
// Unsupported nodes (stages 3b/3c) yield a "<TODO>" marker.
fn emit_expr_full(e Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    return match e {
        Expr.IntLit(value, _) => int_to_str(value)
        Expr.FloatLit(value, _) => float_to_str(value)
        Expr.StringLit(value, _) => literal_to_c(value, "string")
        Expr.BoolLit(value, _) => {
            if value {
                return "true"
            }
            return "false"
        }
        Expr.NilLit(_) => "NULL"
        Expr.Ident(name, _) => name
        Expr.Unary(op, right, _) => emit_unary(right, op, vars, sigs, structs)
        Expr.Binary(left, op, right, _) => emit_binary(left, op, right, vars, sigs, structs)
        Expr.If(condition, then_branch, else_branch, _) => emit_if_expr(condition, then_branch, else_branch, vars, sigs, structs)
        Expr.Call(callee, args, _) => emit_call(callee, args, vars, sigs, structs)
        Expr.Index(left, index, _) => emit_index(left, index, vars, sigs, structs)
        Expr.Field(left, name, _) => emit_field(left, name, vars, sigs, structs)
        Expr.Match(value, arms, _) => emit_match(value, arms, vars, sigs, structs)
        Expr.Block(body, _) => emit_block_expr(body, vars, sigs, structs)
        Expr.ArrayLit(elements, _) => emit_array_lit(elements, vars, sigs, structs)
        // [РЕШЕНИЕ]: TupleLit stays "<TODO>": the self-hosted checker has no
        // Type.Tuple (tuple_type is a placeholder returning the first
        // element's type), and C tuples need DotTuple_N typedef
        // registration from the declaration pass (stage 5).
        Expr.TupleLit(_, _) => "<TODO>"
        Expr.StructLit(name, fields, _) => emit_struct_lit(name, fields, vars, sigs, structs)
        Expr.MapLit(entries, _) => emit_map_lit(entries)
        Expr.Assign(left, op, right, _) => emit_assign(left, op, right, vars, sigs, structs)
        _ => "<TODO>"
    }
}

fn emit_unary(right []Expr, op TokenType, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if right.len == 0 {
        return "<TODO>"
    }
    inner = emit_expr_full(right[0], vars, sigs, structs)
    return match op {
        TokenType.Not => "!(" + inner + ")"
        TokenType.Minus => "-(" + inner + ")"
        _ => "<TODO>"
    }
}

// emit_binary reuses the стаб's binop_typed_to_c: it already picks the
// right C for string concat/eq and pow_int/pow_float from the operand
// type tags, so no operator logic is duplicated here.
fn emit_binary(left []Expr, op TokenType, right []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if left.len == 0 or right.len == 0 {
        return "<TODO>"
    }
    lhs = emit_expr_full(left[0], vars, sigs, structs)
    rhs = emit_expr_full(right[0], vars, sigs, structs)
    l_ty = infer_type_full(left[0], vars, sigs, structs)
    r_ty = infer_type_full(right[0], vars, sigs, structs)
    op_str = binop_str(op)
    if op_str.len == 0 {
        return "<TODO>"
    }
    return binop_typed_to_c(op_str, lhs, rhs, ty_tag(l_ty), ty_tag(r_ty))
}

// binop_str maps a TokenType operator to the string the стаб understands.
fn binop_str(op TokenType) -> string {
    return match op {
        TokenType.Plus => "+"
        TokenType.Minus => "-"
        TokenType.Star => "*"
        TokenType.Slash => "/"
        TokenType.Percent => "%"
        TokenType.StarStar => "**"
        TokenType.EqEq => "=="
        TokenType.BangEq => "!="
        TokenType.Lt => "<"
        TokenType.Gt => ">"
        TokenType.LtEq => "<="
        TokenType.GtEq => ">="
        TokenType.And => "and"
        TokenType.Or => "or"
        TokenType.Amp => "&"
        TokenType.Pipe => "|"
        TokenType.Caret => "^"
        TokenType.Shl => "<<"
        TokenType.Shr => ">>"
        _ => ""
    }
}

// ty_tag renders a checker Type as the small tag that the стаб's
// binop_typed_to_c understands: "string", "float", "int", "" otherwise.
fn ty_tag(t Type) -> string {
    return match t {
        Type.Int => "int"
        Type.Float => "float"
        Type.String => "string"
        _ => ""
    }
}

// The then-branch value is the last expression statement; the else-branch
// value is the last element of the else slice (checker.check_else_branch
// rule). Both fall back to a marker when absent.
fn emit_if_expr(condition []Expr, then_branch []Stmt, else_branch []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if condition.len == 0 {
        return "<TODO>"
    }
    cond = emit_expr_full(condition[0], vars, sigs, structs)
    then_e = then_value(then_branch, vars, sigs, structs)
    else_e = else_value(else_branch, vars, sigs, structs)
    return ifexpr_to_c(cond, then_e, else_e)
}

fn then_value(stmts []Stmt, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    return then_value_of(stmts, 0, "<TODO>", vars, sigs, structs)
}

fn then_value_of(stmts []Stmt, i int, acc string, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if i >= stmts.len {
        return acc
    }
    return match stmts[i] {
        Stmt.ExprStmt(e, _) => then_value_of(stmts, i + 1, emit_expr_full(e, vars, sigs, structs), vars, sigs, structs)
        _ => then_value_of(stmts, i + 1, acc, vars, sigs, structs)
    }
}

fn else_value(else_branch []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if else_branch.len > 0 {
        return emit_expr_full(else_branch[else_branch.len - 1], vars, sigs, structs)
    }
    return "<TODO>"
}

// float_to_str prints a float64 as the shortest plain decimal C literal:
// no exponent, trailing fraction zeros stripped, integer values without a
// dot. Fraction digits are extracted by repeated multiply-by-10 truncation
// capped at 15 digits, with round-half-up + carry at the cutoff, so a
// literal like 3.14 prints "3.14", not the raw binary expansion tail.
fn float_to_str(v float) -> string {
    if v == 0.0 {
        return "0"
    }
    if v < 0.0 {
        return "-" + float_to_str(-v)
    }
    whole = v as int
    frac = v - (whole as float)
    if frac == 0.0 {
        return int_to_str(whole)
    }
    digits = frac_digits(frac)
    if digits.len == 0 {
        // The fraction rounded up to 1.0 (all digits carried): the value
        // prints as the next integer.
        return int_to_str(whole + 1)
    }
    return int_to_str(whole) + "." + digits
}

fn frac_digits(frac float) -> string {
    b = new_builder()
    rem = frac_digits_into(b, frac, 15)
    if rem >= 0.5 {
        if not bump_last_digit(b) {
            return ""
        }
    }
    return trim_trailing_zeros(bfinish(b))
}

// frac_digits_into pushes the truncated decimal digits of frac
// (0 < frac < 1), stopping early when the remainder is exactly zero, and
// returns the remaining fraction after the last pushed digit (0.0 when
// exhausted). The caller rounds the cutoff digit from this remainder.
fn frac_digits_into(b CBuilder, frac float, left int) -> float {
    if left <= 0 {
        return frac
    }
    if frac == 0.0 {
        return 0.0
    }
    next = frac * 10.0
    d = next as int
    rem = next - (d as float)
    b.buf.push((48 + d) as uint8)
    if rem == 0.0 {
        return 0.0
    }
    return frac_digits_into(b, rem, left - 1)
}

// bump_last_digit increments the last pushed digit with carry ('9' -> '0'
// and carry on). Returns false when the carry runs past the first digit
// (all digits were '9').
fn bump_last_digit(b CBuilder) -> bool {
    i = b.buf.len - 1
    for i >= 0 {
        if b.buf[i] == 57 {
            b.buf[i] = 48
            i -= 1
        } else {
            b.buf[i] = b.buf[i] + 1
            return true
        }
    }
    return false
}

fn trim_trailing_zeros(s string) -> string {
    if s.len == 0 {
        return ""
    }
    if s[s.len - 1] == 48 {
        return trim_trailing_zeros(s[0..s.len - 1])
    }
    return s
}

// --- Stage 3b: Call / Index / Slice / Field + builtins ---

// emit_call: plain function calls use the Dot_-prefixed C name (Go fndecl
// emits "Dot_" + Name), builtins map to their runtime helpers.
fn emit_call(callee []Expr, args []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if callee.len == 0 {
        return "<TODO>"
    }
    return match callee[0] {
        Expr.Ident(name, _) => emit_call_by_name(name, args, vars, sigs, structs)
        Expr.Field(recv, name, _) => emit_method_call(recv, name, args, vars, sigs, structs)
        _ => "<TODO>"
    }
}

// emit_call_by_name dispatches on the callee name. print/println/eprint pack
// every argument into a DotSlice* via dot_slice_pack (Go emitVariadicCall);
// len/input/type_of/panic take their single argument directly (Go
// emitBuiltinCall). Zero-value defaults for a missing argument mirror Go's
// emitArg: "NULL" for string params (input, panic), "0" for DotAny ones
// (len, type_of).
fn emit_call_by_name(name string, args []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if str_eq(name, "print") {
        return "dot_print(" + emit_variadic_pack(args, vars, sigs, structs) + ")"
    }
    if str_eq(name, "println") {
        return "dot_println(" + emit_variadic_pack(args, vars, sigs, structs) + ")"
    }
    if str_eq(name, "eprint") {
        return "dot_eprint(" + emit_variadic_pack(args, vars, sigs, structs) + ")"
    }
    if str_eq(name, "len") {
        return "dot_len(" + emit_first_arg(args, vars, "0", sigs, structs) + ")"
    }
    if str_eq(name, "input") {
        return "dot_input(" + emit_first_arg(args, vars, "NULL", sigs, structs) + ")"
    }
    if str_eq(name, "type_of") {
        return "dot_typeof(" + emit_first_arg(args, vars, "0", sigs, structs) + ")"
    }
    if str_eq(name, "panic") {
        return "dot_panic(" + emit_first_arg(args, vars, "NULL", sigs, structs) + ")"
    }
    return "Dot_" + name + "(" + emit_plain_args(args, vars, sigs, structs) + ")"
}

// [РЕШЕНИЕ]: method calls on struct receivers emit as Dot_<Struct>_<Method>
// with the receiver as first argument (Go methodName = "Dot_" + Owner.Name +
// "_" + Method.Name, emitMethodCall). Slice receivers route to the slice
// builtin table (dot_slice_push and friends — Go SelectBuiltinMethod +
// builtinMethodName). Builtin methods on other receivers and static
// Type.method calls need the checker's selection info which the self-hosted
// codegen does not carry, so they stay "<TODO>". The fn registry is not
// consulted here either (method callees need selection info, not a flat
// name lookup — [РЕШЕНИЕ] 7b).
fn emit_method_call(recv []Expr, name string, args []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if recv.len == 0 {
        return "<TODO>"
    }
    r_ty = infer_type_full(recv[0], vars, sigs, structs)
    return match r_ty {
        Type.Struct(sname) => "Dot_" + sname + "_" + name + "(" + emit_expr_full(recv[0], vars, sigs, structs) + method_args_join(args, vars, 0, sigs, structs) + ")"
        Type.Slice(_) => emit_slice_builtin_call(recv[0], name, args, vars, sigs, structs)
        _ => "<TODO>"
    }
}

// emit_slice_builtin_call renders a slice builtin method call
// (Go builtinMethodName: "dot_slice_" + name). Only helpers that actually
// exist in runtime/array.h are emitted — currently just push (dot_slice_push,
// returns void, mutates in place; Go builtin_methods_slice.go: Result Void).
// pop/insert/contains/... have no runtime helper yet and stay "<TODO>". The
// argument is cast like pack_arg: heap values pass through as DotAny slots
// (pointers), scalars are smuggled via (DotAny)(intptr_t) (Go emitMethodCall
// casts every arg to DotAny).
fn emit_slice_builtin_call(recv_e Expr, name string, args []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if not str_eq(name, "push") or args.len == 0 {
        return "<TODO>"
    }
    obj = emit_expr_full(recv_e, vars, sigs, structs)
    arg = emit_expr_full(args[0], vars, sigs, structs)
    cast = if is_heap(infer_type_full(args[0], vars, sigs, structs)) { arg } else { "(DotAny)(intptr_t)(" + arg + ")" }
    return "dot_slice_push(" + obj + ", " + cast + ")"
}

fn method_args_join(args []Expr, vars []VarInfo, i int, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if i >= args.len {
        return ""
    }
    return ", " + emit_expr_full(args[i], vars, sigs, structs) + method_args_join(args, vars, i + 1, sigs, structs)
}

fn emit_first_arg(args []Expr, vars []VarInfo, zero string, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if args.len > 0 {
        return emit_expr_full(args[0], vars, sigs, structs)
    }
    return zero
}

fn emit_plain_args(args []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    return plain_args_join(args, vars, 0, sigs, structs)
}

fn plain_args_join(args []Expr, vars []VarInfo, i int, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if i >= args.len {
        return ""
    }
    cur = emit_expr_full(args[i], vars, sigs, structs)
    if i == args.len - 1 {
        return cur
    }
    return cur + ", " + plain_args_join(args, vars, i + 1, sigs, structs)
}

// emit_variadic_pack renders dot_slice_pack(N, (DotAny[]){...}) for a
// variadic builtin call. Non-heap values (int/float/bool) are smuggled
// through DotAny slots as intptr_t, exactly like Go emitVariadicCall
// (isPointerLike check); heap values (string/slice/struct/...) pass through
// as pointers.
fn emit_variadic_pack(args []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    packed = pack_args(args, vars, 0, sigs, structs)
    return "dot_slice_pack(" + int_to_str(args.len) + ", (DotAny[]){{" + packed + "}})"
}

fn pack_args(args []Expr, vars []VarInfo, i int, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if i >= args.len {
        return ""
    }
    one = pack_arg(args, vars, i, sigs, structs)
    if i == args.len - 1 {
        return one
    }
    return one + ", " + pack_args(args, vars, i + 1, sigs, structs)
}

fn pack_arg(args []Expr, vars []VarInfo, i int, sigs []FnSig, structs []CodegenStructInfo) -> string {
    val = emit_expr_full(args[i], vars, sigs, structs)
    if is_heap(infer_type_full(args[i], vars, sigs, structs)) {
        return val
    }
    return "(DotAny)(intptr_t)(" + val + ")"
}

// is_range_index detects the slice spelling s[a..b]: the parser lowers it to
// Index(left, [Binary(a, DotDot|DotDotEq, b)]) (parser_pratt.dot has no
// SliceExpr variant).
fn is_range_index(e Expr) -> bool {
    return match e {
        Expr.Binary(_, op, _, _) => is_range_op_of(op)
        _ => false
    }
}

fn is_range_op_of(op TokenType) -> bool {
    return match op {
        TokenType.DotDot => true
        TokenType.DotDotEq => true
        _ => false
    }
}

// emit_index: strings index into the DotString payload (Go emitIndex
// KindString branch); slices and fixed arrays go through dot_slice_get (the
// MVP lowers Array to DotSlice* too, see codegen_types.dot).
fn emit_index(left []Expr, index []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if left.len == 0 or index.len == 0 {
        return "<TODO>"
    }
    if is_range_index(index[0]) {
        return emit_slice_expr(left[0], index[0], vars, sigs, structs)
    }
    obj = emit_expr_full(left[0], vars, sigs, structs)
    idx = emit_expr_full(index[0], vars, sigs, structs)
    left_ty = infer_type_full(left[0], vars, sigs, structs)
    return match left_ty {
        Type.String => "((DotString*)" + obj + ")->data[" + idx + "]"
        Type.Slice(_) => emit_slice_get(obj, idx, left_ty)
        Type.Array(_) => emit_slice_get(obj, idx, left_ty)
        _ => "<TODO>"
    }
}

// emit_slice_get wraps dot_slice_get; when the element type is a known
// scalar the DotAny slot is unwrapped with the C cast Go emitIndex emits
// ((%s)(intptr_t)dot_slice_get(...)).
fn emit_slice_get(obj string, idx string, left_ty Type) -> string {
    call = "dot_slice_get(" + obj + ", " + idx + ")"
    elem = index_elem_ty(left_ty)
    if is_scalar_ty(elem) {
        return "((" + ty_to_c(elem) + ")(intptr_t)" + call + ")"
    }
    return call
}

fn index_elem_ty(t Type) -> Type {
    return match t {
        Type.Array(elem) => elem_of(elem)
        Type.Slice(elem) => elem_of(elem)
        _ => Type.Unknown
    }
}

fn is_scalar_ty(t Type) -> bool {
    return match t {
        Type.Int => true
        Type.Float => true
        Type.Bool => true
        _ => false
    }
}

// emit_slice_expr renders s[a..b] (Index with a DotDot range) as
// dot_slice_sub(obj, lo, hi, inclusive), Go emitSlice. Strings have no sub
// helper in the runtime, so the Go form rebuilds a DotString from the
// sub-sliced bytes. Missing bounds default to 0 / dot_slice_len(obj); ..=
// (DotDotEq) makes the range inclusive.
fn emit_slice_expr(obj_e Expr, range_e Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    return match range_e {
        Expr.Binary(lo, op, hi, _) => emit_slice_parts(obj_e, lo, op, hi, vars, sigs, structs)
        _ => "<TODO>"
    }
}

fn emit_slice_parts(obj_e Expr, lo []Expr, op TokenType, hi []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    obj = emit_expr_full(obj_e, vars, sigs, structs)
    lo_s = slice_lo(lo, vars, sigs, structs)
    hi_s = slice_hi(hi, obj, vars, sigs, structs)
    inc_s = range_inc_str(op)
    sub = "dot_slice_sub(" + obj + ", " + lo_s + ", " + hi_s + ", " + inc_s + ")"
    if is_string_ty(infer_type_full(obj_e, vars, sigs, structs)) {
        return "dot_string_from_bytes(dot_slice_sub(dot_string_to_bytes(" + obj + "), " + lo_s + ", " + hi_s + ", " + inc_s + "))"
    }
    return sub
}

fn slice_lo(lo []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if lo.len > 0 {
        return emit_expr_full(lo[0], vars, sigs, structs)
    }
    return "0"
}

fn slice_hi(hi []Expr, obj string, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if hi.len > 0 {
        return emit_expr_full(hi[0], vars, sigs, structs)
    }
    return "dot_slice_len(" + obj + ")"
}

fn range_inc_str(op TokenType) -> string {
    return match op {
        TokenType.DotDotEq => "true"
        _ => "false"
    }
}

// emit_field: struct fields are dot_-prefixed C members reached through the
// heap pointer (cFieldName types.go:301); strings and slices expose the
// .len (and slices .cap) builtin props (Go emitBuiltinProp).
fn emit_field(left []Expr, name string, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if left.len == 0 {
        return "<TODO>"
    }
    obj = emit_expr_full(left[0], vars, sigs, structs)
    t = infer_type_full(left[0], vars, sigs, structs)
    return match t {
        Type.String => {
            if str_eq(name, "len") {
                return "((DotString*)" + obj + ")->len"
            }
            return "<TODO>"
        }
        Type.Slice(_) => emit_slice_prop(obj, name)
        Type.Array(_) => emit_slice_prop(obj, name)
        Type.Map(_, _) => emit_map_prop(obj, name)
        Type.Struct(_) => obj + "->dot_" + name
        _ => "<TODO>"
    }
}

fn emit_slice_prop(obj string, name string) -> string {
    if str_eq(name, "len") {
        return "dot_slice_len(" + obj + ")"
    }
    if str_eq(name, "cap") {
        return "dot_slice_cap(" + obj + ")"
    }
    return "<TODO>"
}

// emit_map_prop: DotMap carries its own len/cap fields (runtime/map.h), so
// `.len`/`.cap` on a map read them directly — dot_slice_len takes DotSlice*
// and cannot accept a DotMap*.
fn emit_map_prop(obj string, name string) -> string {
    if str_eq(name, "len") {
        return "((DotMap*)" + obj + ")->len"
    }
    if str_eq(name, "cap") {
        return "((DotMap*)" + obj + ")->cap"
    }
    return "<TODO>"
}

// --- Stage 3c: Match / ArrayLit / StructLit / MapLit / Assign ---

// [РЕШЕНИЕ]: a match renders as a ternary chain (Go emits a GCC statement
// expression with _match_res; the MVP avoids statement expressions). An
// Ident pattern is implemented by TEXTUALLY substituting the subject into
// the arm body (and guard): the subject text may be duplicated, side
// effects re-evaluated, and the replace is a naive substring match (a short
// binding name inside a longer identifier gets replaced too). Proper C
// temporaries/bindings need statement codegen (stages 4-5). A Variant
// pattern lowers to the tail arm with a "<TODO variant match>" marker until
// enum-match lands (stages 5-6). A match with zero arms emits "<TODO>": it
// has no result value (Go leaves _match_res uninitialized) and the checker
// rejects it anyway.
fn emit_match(value []Expr, arms []MatchArm, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if value.len == 0 {
        return "<TODO>"
    }
    if arms.len == 0 {
        return "<TODO>"
    }
    subj = emit_expr_full(value[0], vars, sigs, structs)
    subj_ty = ty_tag(infer_type_full(value[0], vars, sigs, structs))
    return emit_match_arms(arms, 0, subj, subj_ty, vars, sigs, structs)
}

// emit_match_arms folds the arm list right-to-left into nested ternaries
// via ifexpr_to_c. A cond-less arm (CatchAll / Variant) becomes the tail
// and ends the chain; if the last arm still has a cond, the chain falls
// back to "0" (the same "no matching arm" gap as Go's uninitialized
// _match_res; the checker guarantees a catch-all arm in practice).
fn emit_match_arms(arms []MatchArm, i int, subj string, subj_ty string, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if i >= arms.len {
        return "0"
    }
    arm = arms[i]
    cond = match_arm_cond(arm, subj, subj_ty)
    body = match_arm_body(arm, subj, vars, sigs, structs)
    cond = match_guard_cond(cond, arm, subj, vars, sigs, structs)
    if cond.len == 0 {
        return body
    }
    return ifexpr_to_c(cond, body, emit_match_arms(arms, i + 1, subj, subj_ty, vars, sigs, structs))
}

// match_arm_cond renders the dispatch condition of one arm. Ident and
// CatchAll patterns always match; IntLit compares through the стаб
// match_cond_to_c; Variant arms get no cond ("") and act as tail arms.
fn match_arm_cond(arm MatchArm, subj string, subj_ty string) -> string {
    return match arm.pattern {
        Pattern.IntLit(v) => match_cond_to_c(subj, subj_ty, int_to_str(v))
        Pattern.Ident(_) => "true"
        Pattern.CatchAll => ""
        Pattern.Variant(_, _) => ""
    }
}

fn match_arm_body(arm MatchArm, subj string, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    body = emit_expr_full(arm.body, vars, sigs, structs)
    if is_ident_pattern(arm.pattern) {
        return str_replace_ident(body, ident_pattern_name(arm.pattern), "(" + subj + ")")
    }
    if is_variant_pattern(arm.pattern) {
        return "/* <TODO variant match> */ 0"
    }
    return body
}

// NOTE [РЕШЕНИЕ]: the pattern checks and payload extraction are if-based
// (with expression-match helpers), NOT `return match ...` chains: the Go
// compiler's ARC does not retain the _match_res temp of a match value, so
// an arm returning a local heap string (e.g. `_ => body`) dangles after the
// local is released at scope end (use-after-free, observed as corrupted
// strings). Constants and fresh call/concat results are unaffected; if
// statements return locals through the normal retained return path.
fn is_ident_pattern(p Pattern) -> bool {
    return match p {
        Pattern.Ident(_) => true
        _ => false
    }
}

fn is_variant_pattern(p Pattern) -> bool {
    return match p {
        Pattern.Variant(_, _) => true
        _ => false
    }
}

// ident_pattern_name extracts the binding name of an Ident pattern ("" for
// any other pattern). The returned string borrows the pattern's payload;
// the caller must only read it while the pattern object is alive.
fn ident_pattern_name(p Pattern) -> string {
    return match p {
        Pattern.Ident(name) => name
        _ => ""
    }
}

// match_guard_cond folds the optional arm guard into the dispatch
// condition. Ident-pattern guards get the same subject substitution as the
// body, so they can mention the binding.
fn match_guard_cond(cond string, arm MatchArm, subj string, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if not arm.guard.is_some() {
        return cond
    }
    guard_e = emit_expr_full(arm.guard.unwrap(), vars, sigs, structs)
    // [РЕШЕНИЕ] D53: `g = ...` inside the if-block below would SHADOW the
    // outer local, and the unsubstituted guard would leak into the cond —
    // the substitution lives in an if-expression at fn top level instead.
    g = if is_ident_pattern(arm.pattern) { str_replace_ident(guard_e, ident_pattern_name(arm.pattern), "(" + subj + ")") } else { guard_e }
    if cond.len == 0 {
        return "(" + g + ")"
    }
    return cond + " && (" + g + ")"
}

// str_replace_all replaces every occurrence of old in s with new.
fn str_replace_all(s string, old string, new string) -> string {
    if old.len == 0 {
        return s
    }
    b = new_builder()
    i = 0
    for i < s.len {
        if str_match_at(s, old, i) {
            bwrite(b, new)
            i += old.len
        } else {
            b.buf.push(s[i] as uint8)
            i += 1
        }
    }
    return bfinish(b)
}

// str_replace_ident is str_replace_all with identifier boundaries: name is
// replaced only where the characters before and after the match are NOT
// identifier chars (a-z A-Z 0-9 _). The naive str_replace_all corrupted
// generated code for short pattern bindings: `v => { print(v) }` turned
// `(void)0` into `((n)oid)0` and would mangle `void*`, `int64_t`,
// `dot_print` too. The replaced text is wrapped in parentheses by the
// callers, and since name itself never contains parens, nested `((subj))`
// cannot form.
fn str_replace_ident(s string, name string, new string) -> string {
    if name.len == 0 {
        return s
    }
    b = new_builder()
    str_replace_ident_into(b, s, name, new, 0)
    return bfinish(b)
}

fn str_replace_ident_into(b CBuilder, s string, name string, new string, i int) {
    if i >= s.len {
        return
    }
    if str_match_at(s, name, i) and not is_ident_char_at(s, i - 1) and not is_ident_char_at(s, i + name.len) {
        bwrite(b, new)
        return str_replace_ident_into(b, s, name, new, i + name.len)
    }
    b.buf.push(s[i] as uint8)
    return str_replace_ident_into(b, s, name, new, i + 1)
}

// is_ident_char_at reports whether the byte at idx of s is an identifier
// char (a-z A-Z 0-9 _). Indices outside the string are false (the boundary
// before index 0 and after the last byte is never an identifier char).
fn is_ident_char_at(s string, idx int) -> bool {
    if idx < 0 or idx >= s.len {
        return false
    }
    ch = s[idx]
    return (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90) or (ch >= 48 and ch <= 57) or ch == 95
}

// [РЕШЕНИЕ]: array literals reuse the emit_variadic_pack slot rule: heap
// values (string/slice/struct/map) pass through as pointers, scalars are
// smuggled via (DotAny)(intptr_t). Struct/enum ELEMENTS are not boxed to
// the heap yet (Go emitBoxValue allocates a heap copy), so a struct
// compound literal inside an array literal is wrong on the MVP — that
// arrives with ARC/retain on stage 6.
fn emit_array_lit(elements []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    packed = array_pack_args(elements, vars, 0, sigs, structs)
    return "dot_slice_from_array(" + int_to_str(elements.len) + ", (DotAny[]){{" + packed + "}})"
}

fn array_pack_args(elements []Expr, vars []VarInfo, i int, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if i >= elements.len {
        return ""
    }
    one = array_pack_arg(elements, vars, i, sigs, structs)
    if i == elements.len - 1 {
        return one
    }
    return one + ", " + array_pack_args(elements, vars, i + 1, sigs, structs)
}

// [РЕШЕНИЕ] ARC (6b): a heap-typed IDENT element must be retained — the
// literal's DotAny slot takes ownership of the reference, so releasing the
// variable later (block exit / return) must not free the value behind the
// slot. Literals and calls already yield retained values (dot_string_from_lit,
// dot_string_concat, fn returns are +1), so they pass through as-is — an
// extra retain would leak a ref. Go mirrors this via emitRetain (lvalue path)
// vs plain emitExpr (rvalue path); here Ident is the lvalue proxy.
fn array_pack_arg(elements []Expr, vars []VarInfo, i int, sigs []FnSig, structs []CodegenStructInfo) -> string {
    val = emit_expr_full(elements[i], vars, sigs, structs)
    if is_heap(infer_type_full(elements[i], vars, sigs, structs)) {
        if is_ident_expr(elements[i]) {
            return "dot_retain((DotRefcnt*)(" + val + "))"
        }
        return val
    }
    return "(DotAny)(intptr_t)(" + val + ")"
}

// [РЕШЕНИЕ] 7a struct-lit BOXING: field names go through the codegen стаб
// struct_literal_to_c WITH the dot_ prefix (the стаб itself writes the bare
// name), and the resulting VALUE compound literal is boxed onto the heap.
// The stdlib locks Struct -> Dot<Name>* (ty_to_c stage 2), i.e. every
// struct pointer must point AT the fields (emit_field emits `p->dot_x`,
// c193), so the expression yields the PAYLOAD pointer, not the ARC header
// pointer: dot_box_struct(sizeof(Dot<Name>), &lit) returns the header
// pointer, dot_box_payload offsets past DotRefcnt. The compound literal is
// a C99 block-scope lvalue, so &lit is valid and the box memcpy's from it
// immediately (no Go-style statement-expression temp needed). Boxing lives
// IN the expression itself, so a struct-lit works as a let-init, an assign
// RHS, a call argument and a return value. (Known MVP hazard: dot_release
// on the payload pointer reads a garbage refcnt — struct release semantics
// land with a later ARC stage; the box itself is leaked.)
fn emit_struct_lit(name string, fields []StructLitField, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    fnames = struct_lit_field_names(fields, 0, []string{})
    fvals = struct_lit_field_values(fields, 0, vars, sigs, structs, []string{})
    lit = struct_literal_to_c(name, fnames, fvals)
    return "dot_box_payload(dot_box_struct(sizeof(Dot" + name + "), &" + lit + "))"
}

fn struct_lit_field_names(fields []StructLitField, i int, acc []string) -> []string {
    if i >= fields.len {
        return acc
    }
    acc.push("dot_" + fields[i].name)
    return struct_lit_field_names(fields, i + 1, acc)
}

fn struct_lit_field_values(fields []StructLitField, i int, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo, acc []string) -> []string {
    if i >= fields.len {
        return acc
    }
    // [РЕШЕНИЕ] ARC (6b): same ownership rule as array_pack_arg — a
    // heap-typed IDENT field value is retained on the way into the literal
    // (the struct owns the ref); literals and calls pass through unchanged.
    val = emit_expr_full(fields[i].value, vars, sigs, structs)
    if is_heap(infer_type_full(fields[i].value, vars, sigs, structs)) and is_ident_expr(fields[i].value) {
        acc.push("dot_retain((DotRefcnt*)(" + val + "))")
    } else {
        acc.push(val)
    }
    return struct_lit_field_values(fields, i + 1, vars, sigs, structs, acc)
}

// [РЕШЕНИЕ]: map literals mirror Go emitMapLit exactly — an empty literal
// is dot_map_new(), a populated one drops its entries with a comment. The
// expression emitter cannot issue the dot_map_set statements an in-place
// build needs; entry insertion arrives with statement codegen (stage 4).
fn emit_map_lit(entries []MapEntryNode) -> string {
    if entries.len == 0 {
        return "dot_map_new()"
    }
    return "/* map literal with " + int_to_str(entries.len) + " entries */ dot_map_new()"
}

// [РЕШЕНИЕ]: Go emitAssignExpr falls back to a plain "=" for
// %/bitwise/shift assigns; here every assign op maps to its real C
// compound operator. Multi-target assignments stay "<TODO>".
fn emit_assign(left []Expr, op TokenType, right []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> string {
    if left.len == 0 or right.len == 0 {
        return "<TODO>"
    }
    op_s = assign_op_str(op)
    if op_s.len == 0 {
        return "<TODO>"
    }
    return "(" + emit_expr_full(left[0], vars, sigs, structs) + " " + op_s + " " + emit_expr_full(right[0], vars, sigs, structs) + ")"
}

fn assign_op_str(op TokenType) -> string {
    return match op {
        TokenType.Assign => "="
        TokenType.PlusAssign => "+="
        TokenType.MinusAssign => "-="
        TokenType.StarAssign => "*="
        TokenType.SlashAssign => "/="
        TokenType.PercentAssign => "%="
        TokenType.AmpAssign => "&="
        TokenType.PipeAssign => "|="
        TokenType.CaretAssign => "^="
        TokenType.ShlAssign => "<<="
        TokenType.ShrAssign => ">>="
        _ => ""
    }
}

// --- Stage 3c: infer_type helpers ---

// array_lit_elem_ty folds element types like checker.check_array_elems:
// the first non-Unknown element type wins.
fn array_lit_elem_ty(elements []Expr, i int, acc Type, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if i >= elements.len {
        return acc
    }
    t = infer_type_full(elements[i], vars, sigs, structs)
    next = if is_unknown_ty(acc) { t } else { acc }
    return array_lit_elem_ty(elements, i + 1, next, vars, sigs, structs)
}

// tuple_lit_ty mirrors checker.tuple_type: the first element's type (the
// checker has no Type.Tuple yet).
fn tuple_lit_ty(elements []TupleElem, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if elements.len > 0 {
        return infer_type_full(elements[0].value, vars, sigs, structs)
    }
    return Type.Void
}

// match_first_arm_ty: the match type is the first arm's body type (the
// checker folds all arms and requires them compatible).
fn match_first_arm_ty(arms []MatchArm, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if arms.len > 0 {
        return infer_type_full(arms[0].body, vars, sigs, structs)
    }
    return Type.Unknown
}

fn assign_value_ty(right []Expr, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if right.len > 0 {
        return infer_type_full(right[0], vars, sigs, structs)
    }
    return Type.Unknown
}

fn map_lit_ty(entries []MapEntryNode, vars []VarInfo, sigs []FnSig, structs []CodegenStructInfo) -> Type {
    if entries.len > 0 {
        k = infer_type_full(entries[0].key, vars, sigs, structs)
        v = infer_type_full(entries[0].value, vars, sigs, structs)
        return Type.Map([]Type{k}, []Type{v})
    }
    return Type.Map([]Type{Type.Unknown}, []Type{Type.Unknown})
}

fn is_unknown_ty(t Type) -> bool {
    return match t {
        Type.Unknown => true
        _ => false
    }
}
