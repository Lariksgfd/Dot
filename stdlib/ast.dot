import lexer

pub struct Span {
    start Position
    end   Position
}

impl Span {
    pub fn new(start Position, end Position) -> Span {
        return Span { start, end }
    }
}

pub enum Expr {
    Ident(name string, span Span)
    IntLit(value int, span Span)
    FloatLit(value float, span Span)
    StringLit(value string, span Span)
    BoolLit(value bool, span Span)
    NilLit(span Span)

    // Using single-element slices as a stable way to represent recursive heap structures
    // in early versions of the compiler just in case direct recursion is tricky.
    Unary(op TokenType, right []Expr, span Span) 
    Binary(left []Expr, op TokenType, right []Expr, span Span)
    Call(callee []Expr, args []Expr, span Span)
    Index(left []Expr, index []Expr, span Span)
    Field(left []Expr, name string, span Span)
    
    ArrayLit(elements []Expr, span Span)
    TupleLit(elements []TupleElem, span Span)
    
    If(condition []Expr, then_branch []Stmt, else_branch []Expr, span Span)
    Match(value []Expr, arms []MatchArm, span Span)
    // Block expression in match-arm position: `pat => { ... }`.
    Block(body []Stmt, span Span)
    
    Assign(left []Expr, op TokenType, right []Expr, span Span)

    FnLit(params []Param, ret_ty Option[TypeNode], body []Stmt, span Span)

    StructLit(name string, fields []StructLitField, span Span)

    MapLit(entries []MapEntryNode, span Span)
}

pub struct MatchArm {
    pattern Pattern
    guard   Option[Expr]
    body    Expr
}

pub struct StructLitField {
    name  string
    value Expr
}

// TupleElem is one element of a tuple literal. name is Some only for the
// named form `(x: 1)`; positional elements have name None.
pub struct TupleElem {
    name  Option[string]
    value Expr
}

pub struct MapEntryNode {
    key   Expr
    value Expr
}

pub enum Pattern {
    Ident(name string)
    IntLit(value int)
    CatchAll
    // Enum variant pattern with payload bindings, e.g. the match arm
    // `Type.Func(oparams, oret) => oparams`. name is the full dotted path;
    // bindings are the new names bound to the variant's payload fields.
    Variant(name string, bindings []string)
}

pub enum Stmt {
    ExprStmt(expr Expr, span Span)
    Let(name string, ty Option[TypeNode], value Expr, is_mut bool, span Span)
    Return(value Option[Expr], span Span)
    Break(label Option[string], span Span)
    Continue(label Option[string], span Span)
    For(pattern Pattern, iterable Expr, body []Stmt, span Span)
    While(condition Expr, body []Stmt, span Span)
    Block(stmts []Stmt, span Span)
}

pub enum Decl {
    Fn(name string, params []Param, type_params []string, ret_ty Option[TypeNode], body []Stmt, span Span)
    Struct(name string, fields []FieldDef, span Span)
    Enum(name string, variants []VariantDef, span Span)
    Trait(name string, methods []Decl, span Span)
    Impl(trait_name Option[string], target TypeNode, methods []Decl, span Span)

    // [РЕШЕНИЕ] ExternFn/ExternStruct carry the @extern("C") annotation
    // (T-051 stage 7c1). They are APPENDED after the original five variants
    // instead of adding an is_extern bool field to Fn/Struct, so the payload
    // layouts and tag values of the existing variants stay stable — every
    // direct Decl.Fn/Decl.Struct construction (incl. testdata) keeps
    // compiling untouched. ExternFn holds a signature only: no body, no
    // type params (both dropped by the parser).
    ExternFn(name string, params []Param, ret_ty Option[TypeNode], span Span)
    ExternStruct(name string, span Span)
}

pub struct Param {
    name string
    ty   TypeNode
}

pub struct FieldDef {
    name string
    ty   TypeNode
}

pub struct VariantDef {
    name   string
    params []Param
}

pub enum TypeNode {
    Named(name string, span Span)
    Array(elem_ty []TypeNode, span Span)
    Slice(elem_ty []TypeNode, span Span)
    Pointer(elem_ty []TypeNode, span Span)
    Func(params []TypeNode, ret_ty Option[TypeNode], span Span)
    Map(key []TypeNode, val []TypeNode, span Span)
}
