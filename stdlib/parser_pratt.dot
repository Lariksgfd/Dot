import lexer
import ast
import parser

pub const PREC_LOWEST int = 0
pub const PREC_ASSIGNMENT int = 1
pub const PREC_PIPE int = 2
pub const PREC_LOGICAL_OR int = 3
pub const PREC_LOGICAL_AND int = 4
pub const PREC_EQUALITY int = 5
pub const PREC_COMPARISON int = 6
pub const PREC_BIT_OR int = 7
pub const PREC_BIT_XOR int = 8
pub const PREC_BIT_AND int = 9
pub const PREC_SHIFT int = 10
pub const PREC_RANGE int = 11
pub const PREC_SUM int = 12
pub const PREC_PRODUCT int = 13
pub const PREC_POWER int = 14
pub const PREC_PREFIX int = 15
pub const PREC_CALL int = 16
pub const PREC_INDEX int = 17

// NOTE: arms are listed in exactly the same order as the variants of Expr
// in ast.dot; the bootstrap C codegen switches on arm index, so order matters.
impl Expr {
    pub fn span(self) -> Span {
        return match self {
            Ident(_, span) => span
            IntLit(_, span) => span
            FloatLit(_, span) => span
            StringLit(_, span) => span
            BoolLit(_, span) => span
            NilLit(span) => span
            Unary(_, _, span) => span
            Binary(_, _, _, span) => span
            Call(_, _, span) => span
            Index(_, _, span) => span
            Field(_, _, span) => span
            ArrayLit(_, span) => span
            TupleLit(_, span) => span
            If(_, _, _, span) => span
            Match(_, _, span) => span
            Assign(_, _, _, span) => span
            FnLit(_, _, _, span) => span
            StructLit(_, _, span) => span
            MapLit(_, span) => span
        }
    }
}

fn kind_eq(a TokenType, b TokenType) -> bool {
    return a == b
}

impl Parser {
    pub fn peek_precedence(self) -> int {
        return token_precedence(self.peek_tok.kind)
    }

    pub fn cur_precedence(self) -> int {
        return token_precedence(self.cur_tok.kind)
    }

    pub fn parse_expr(mut self, precedence int) -> Option[Expr] {
        left = self.parse_prefix()
        if left.is_none() {
            return None
        }
        return self.parse_expr_rest(left.unwrap(), precedence)
    }

    // Recursive continuation of parse_expr. Recursion (instead of a loop with
    // an accumulator) avoids the nested-scope shadowing semantics of Dot,
    // where `x = expr` inside a block declares a new variable.
    fn parse_expr_rest(mut self, left Expr, precedence int) -> Option[Expr] {
        if self.peek_token_is(TokenType.EOF) {
            return Some(left)
        }
        if precedence >= self.peek_precedence() {
            return Some(left)
        }
        if not self.has_infix_parse_fn(self.peek_tok.kind) {
            return Some(left)
        }
        self.next_token()
        new_left = self.parse_infix(left)
        return self.parse_expr_rest(new_left, precedence)
    }

    fn parse_prefix(mut self) -> Option[Expr] {
        if self.cur_token_is(TokenType.Ident) {
            if self.peek_token_is(TokenType.LBrace) {
                return self.parse_struct_lit(self.cur_tok.lexeme, self.cur_tok.pos)
            }
            return Some(Expr.Ident(self.cur_tok.lexeme, Span.new(self.cur_tok.pos, self.cur_tok.end)))
        }
        if self.cur_token_is(TokenType.SelfKw) {
            return Some(Expr.Ident("self", Span.new(self.cur_tok.pos, self.cur_tok.end)))
        }
        if self.cur_token_is(TokenType.Int) {
            val = str_to_int(self.cur_tok.lexeme)
            return Some(Expr.IntLit(val, Span.new(self.cur_tok.pos, self.cur_tok.end)))
        }
        if self.cur_token_is(TokenType.Float) {
            val = str_to_float(self.cur_tok.lexeme)
            return Some(Expr.FloatLit(val, Span.new(self.cur_tok.pos, self.cur_tok.end)))
        }
        if self.cur_token_is(TokenType.String) or self.cur_token_is(TokenType.RawString) {
            return Some(Expr.StringLit(self.cur_tok.value, Span.new(self.cur_tok.pos, self.cur_tok.end)))
        }
        if self.cur_token_is(TokenType.TrueKw) {
            return Some(Expr.BoolLit(true, Span.new(self.cur_tok.pos, self.cur_tok.end)))
        }
        if self.cur_token_is(TokenType.FalseKw) {
            return Some(Expr.BoolLit(false, Span.new(self.cur_tok.pos, self.cur_tok.end)))
        }
        if self.cur_token_is(TokenType.NilKw) {
            return Some(Expr.NilLit(Span.new(self.cur_tok.pos, self.cur_tok.end)))
        }
        if self.cur_token_is(TokenType.Minus) or self.cur_token_is(TokenType.Not) or self.cur_token_is(TokenType.Tilde) {
            start = self.cur_tok.pos
            op = self.cur_tok.kind
            self.next_token()
            right = self.parse_expr(PREC_PREFIX)
            if right.is_none() {
                return None
            }
            end = self.cur_tok.end
            return Some(Expr.Unary(op, [right.unwrap()], Span.new(start, end)))
        }
        if self.cur_token_is(TokenType.LParen) {
            return self.parse_group_or_tuple()
        }
        if self.cur_token_is(TokenType.LBracket) {
            return self.parse_array_lit()
        }
        if self.cur_token_is(TokenType.If) {
            return self.parse_if_expr()
        }
        if self.cur_token_is(TokenType.Match) {
            return self.parse_match_expr()
        }
        if self.cur_token_is(TokenType.Fn) {
            return self.parse_fn_lit()
        }
        if self.cur_token_is(TokenType.LBrace) {
            return self.parse_map_lit()
        }
        self.errors.push("no prefix parse function found")
        return None
    }

    // Point { x: 1, y: 2 } -> Expr.StructLit. cur is the struct name and
    // peek is LBrace when called; leaves cur on RBrace (like the other
    // literal parsers). An empty literal Point {} is valid. Shorthand
    // fields {x} and type-prefixed literals are not representable yet.
    fn parse_struct_lit(mut self, name string, start Position) -> Option[Expr] {
        self.next_token() // cur = LBrace
        fields = self.parse_struct_lit_fields()
        end = self.cur_tok.end
        return Some(Expr.StructLit(name, fields, Span.new(start, end)))
    }

    fn parse_struct_lit_fields(mut self) -> []StructLitField {
        fields = []StructLitField{}
        self.next_token() // cur = first field name or RBrace

        for not self.cur_token_is(TokenType.RBrace) and not self.cur_token_is(TokenType.EOF) {
            if self.cur_token_is(TokenType.Ident) {
                fname = self.cur_tok.lexeme
                if not self.expect_peek(TokenType.Colon) {
                    return fields
                }
                self.next_token() // cur = value start
                value = self.parse_expr(PREC_LOWEST)
                if value.is_some() {
                    fields.push(StructLitField { name: fname, value: value.unwrap() })
                }
            }
            if self.peek_token_is(TokenType.Comma) {
                self.next_token() // cur = Comma
                self.next_token() // cur = next field or RBrace
            } else if self.peek_token_is(TokenType.RBrace) or self.peek_token_is(TokenType.EOF) {
                break
            } else {
                self.next_token()
            }
        }

        if not self.cur_token_is(TokenType.RBrace) {
            self.expect_peek(TokenType.RBrace)
        }
        return fields
    }

    // {k: v, k2: v2} -> Expr.MapLit. cur is LBrace when called; leaves cur
    // on RBrace (like the other literal parsers). An empty literal {} is a
    // valid empty map. Keys are arbitrary expressions, not just identifiers.
    fn parse_map_lit(mut self) -> Option[Expr] {
        start = self.cur_tok.pos
        entries = self.parse_map_entries()
        end = self.cur_tok.end
        return Some(Expr.MapLit(entries, Span.new(start, end)))
    }

    fn parse_map_entries(mut self) -> []MapEntryNode {
        entries = []MapEntryNode{}
        self.next_token() // cur = first key or RBrace

        for not self.cur_token_is(TokenType.RBrace) and not self.cur_token_is(TokenType.EOF) {
            key = self.parse_expr(PREC_LOWEST)
            if key.is_none() {
                return entries
            }
            if not self.expect_peek(TokenType.Colon) {
                return entries
            }
            self.next_token() // cur = value start
            value = self.parse_expr(PREC_LOWEST)
            if value.is_some() {
                entries.push(MapEntryNode { key: key.unwrap(), value: value.unwrap() })
            }
            if self.peek_token_is(TokenType.Comma) {
                self.next_token() // cur = Comma
                self.next_token() // cur = next key or RBrace
            } else if self.peek_token_is(TokenType.RBrace) or self.peek_token_is(TokenType.EOF) {
                break
            } else {
                self.next_token()
            }
        }

        if not self.cur_token_is(TokenType.RBrace) {
            self.expect_peek(TokenType.RBrace)
        }
        return entries
    }

    // (a) -> grouped; () / (a,) / (a, b) -> TupleLit. A named element
    // (x: 1) makes a tuple even without a comma, since dropping the name
    // would change the meaning.
    fn parse_group_or_tuple(mut self) -> Option[Expr] {
        start = self.cur_tok.pos

        if self.peek_token_is(TokenType.RParen) {
            self.next_token()
            return Some(Expr.TupleLit([]TupleElem{}, Span.new(start, self.cur_tok.end)))
        }

        self.next_token() // cur = first element
        first = self.parse_tuple_elem()
        if first.is_none() {
            for not self.cur_token_is(TokenType.RParen) and not self.cur_token_is(TokenType.EOF) {
                self.next_token()
            }
            return None
        }
        first_elem = first.unwrap()

        if not self.peek_token_is(TokenType.Comma) {
            if not self.expect_peek(TokenType.RParen) {
                return None
            }
            if first_elem.name.is_some() {
                return Some(Expr.TupleLit([]TupleElem{first_elem}, Span.new(start, self.cur_tok.end)))
            }
            return Some(first_elem.value)
        }

        elements = []TupleElem{first_elem}
        for self.peek_token_is(TokenType.Comma) {
            self.next_token() // cur = Comma
            if self.peek_token_is(TokenType.RParen) {
                // Trailing comma: cur lands on RParen here, so return
                // directly instead of expect_peek, which checks peek.
                self.next_token() // cur = RParen
                return Some(Expr.TupleLit(elements, Span.new(start, self.cur_tok.end)))
            }
            self.next_token() // cur = next element
            el = self.parse_tuple_elem()
            if el.is_some() {
                elements.push(el.unwrap())
            }
        }

        if not self.expect_peek(TokenType.RParen) {
            return None
        }
        return Some(Expr.TupleLit(elements, Span.new(start, self.cur_tok.end)))
    }

    // One tuple element: `x: expr` (named) or a plain expression. The named
    // arm returns early so its locals stay inside the branch scope.
    fn parse_tuple_elem(mut self) -> Option[TupleElem] {
        if self.cur_token_is(TokenType.Ident) and self.peek_token_is(TokenType.Colon) {
            name = self.cur_tok.lexeme
            self.next_token() // cur = Colon
            self.next_token() // cur = value start
            value = self.parse_expr(PREC_LOWEST)
            if value.is_none() {
                return None
            }
            return Some(TupleElem { name: Some(name), value: value.unwrap() })
        }
        value = self.parse_expr(PREC_LOWEST)
        if value.is_none() {
            return None
        }
        return Some(TupleElem { name: None, value: value.unwrap() })
    }

    // [1, 2, 3] -> ArrayLit; []int{1, 2} -> ArrayLit (type annotation is dropped,
    // ast.dot has no typed slice literal variant yet).
    fn parse_array_lit(mut self) -> Option[Expr] {
        start = self.cur_tok.pos

        if self.peek_token_is(TokenType.RBracket) {
            self.next_token() // cur = RBracket
            if self.peek_token_is(TokenType.Ident) {
                // []T{...} — skip the type tokens until the opening brace
                for not self.peek_token_is(TokenType.LBrace) and not self.peek_token_is(TokenType.EOF) {
                    self.next_token()
                }
            if self.peek_token_is(TokenType.LBrace) {
                self.next_token()
                elements = self.parse_array_elements(TokenType.RBrace)
                return Some(Expr.ArrayLit(elements, Span.new(start, self.cur_tok.end)))
            }
            self.errors.push("expected opening brace in slice literal")
        }
        return Some(Expr.ArrayLit([]Expr{}, Span.new(start, self.cur_tok.end)))
    }

    elements = self.parse_array_elements(TokenType.RBracket)
    return Some(Expr.ArrayLit(elements, Span.new(start, self.cur_tok.end)))
}

fn parse_array_elements(mut self, end_tok TokenType) -> []Expr {
    elements = []Expr{}

    if self.peek_token_is(end_tok) {
        self.next_token()
        return elements
    }

    self.next_token()
    first = self.parse_expr(PREC_LOWEST)
    if first.is_some() {
        elements.push(first.unwrap())
    }

    for self.peek_token_is(TokenType.Comma) {
        self.next_token()
        if self.peek_token_is(end_tok) {
            self.next_token()
            break
        }
        self.next_token()
        el = self.parse_expr(PREC_LOWEST)
        if el.is_some() {
            elements.push(el.unwrap())
        }
    }

    if not self.expect_peek(end_tok) {
        return []Expr{}
    }
    return elements
}

    // if cond { ... } else { ... } / else if ... -> Expr.If.
    // else-branch is stored as a list of expressions (one per expression
    // statement in the block); the []Expr shape comes from ast.dot.
    fn parse_if_expr(mut self) -> Option[Expr] {
        start = self.cur_tok.pos

        self.next_token()
        cond = self.parse_expr(PREC_LOWEST)
        if cond.is_none() {
            return None
        }

        if not self.peek_after_newline_is(TokenType.LBrace) {
            self.peek_error(TokenType.LBrace)
            return None
        }
        self.next_token() // cur = LBrace

        then_stmts = self.parse_block_stmt()

        if self.peek_token_is(TokenType.Else) or self.peek_after_newline_is(TokenType.Else) {
            self.next_token() // cur = Else
            if self.peek_after_newline_is(TokenType.If) {
                self.next_token() // cur = If
                nested = self.parse_if_expr()
                if nested.is_some() {
                    else_exprs = []Expr{nested.unwrap()}
                    end = self.cur_tok.end
                    return Some(Expr.If([cond.unwrap()], then_stmts, else_exprs, Span.new(start, end)))
                }
                return None
            }
            if self.peek_after_newline_is(TokenType.LBrace) {
                self.next_token() // cur = LBrace
                else_exprs = self.parse_else_block_exprs()
                end = self.cur_tok.end
                return Some(Expr.If([cond.unwrap()], then_stmts, else_exprs, Span.new(start, end)))
            }
            self.errors.push("expected if or block after else")
            return None
        }

        end = self.cur_tok.end
        return Some(Expr.If([cond.unwrap()], then_stmts, []Expr{}, Span.new(start, end)))
    }

    fn parse_else_block_exprs(mut self) -> []Expr {
        exprs = []Expr{}
        stmts = self.parse_block_stmt()
        i = 0
        for i < stmts.len {
            match stmts[i] {
                Stmt.ExprStmt(e, span) => exprs.push(e)
                _ => {}
            }
            i += 1
        }
        return exprs
    }

    // match value { pat => expr, _ => other } -> Expr.Match.
    // Only Literal (int), Ident / Enum-variant-path and Wildcard patterns
    // are supported: ast.dot has no EnumPattern-with-payload variant.
    fn parse_match_expr(mut self) -> Option[Expr] {
        start = self.cur_tok.pos

        self.next_token()
        subject = self.parse_expr(PREC_LOWEST)
        if subject.is_none() {
            return None
        }

        if not self.expect_peek(TokenType.LBrace) {
            return None
        }

        arms = self.parse_match_arms()
        end = self.cur_tok.end
        return Some(Expr.Match([subject.unwrap()], arms, Span.new(start, end)))
    }

    fn parse_match_arms(mut self) -> []MatchArm {
        arms = []MatchArm{}
        self.next_token() // cur = first pattern or RBrace

        for not self.cur_token_is(TokenType.RBrace) and not self.cur_token_is(TokenType.EOF) {
            arm = self.parse_match_arm()
            if arm.is_some() {
                arms.push(arm.unwrap())
            }
            if self.peek_token_is(TokenType.Comma) {
                self.next_token() // cur = Comma
                self.next_token() // cur = next pattern
            } else if self.peek_token_is(TokenType.RBrace) or self.peek_token_is(TokenType.EOF) {
                self.next_token()
            } else {
                self.next_token()
            }
        }
        return arms
    }

    fn parse_match_arm(mut self) -> Option[MatchArm] {
        pat = self.parse_pattern()
        if pat.is_none() {
            return None
        }

        guard = self.parse_match_guard()

        if not self.expect_peek(TokenType.FatArrow) {
            return None
        }

        self.next_token() // cur = arm body

        // Block-bodied arms cannot be represented: MatchArm.body is an Expr
        // and ast.dot has no block expression. The block is parsed and
        // skipped, the arm is dropped.
        if self.cur_token_is(TokenType.LBrace) {
            self.parse_block_stmt()
            self.errors.push("match arm block bodies are not supported yet")
            return None
        }

        body = self.parse_expr(PREC_LOWEST)
        if body.is_none() {
            return None
        }

        return Some(MatchArm { pattern: pat.unwrap(), guard, body: body.unwrap() })
    }

    // Guard of a match arm: `if cond` right after the pattern.
    fn parse_match_guard(mut self) -> Option[Expr] {
        if self.peek_token_is(TokenType.If) {
            self.next_token() // cur = If
            self.next_token() // cur = guard expression
            return self.parse_expr(PREC_LOWEST)
        }
        return None
    }

    fn parse_pattern(mut self) -> Option[Pattern] {
        if self.cur_token_is(TokenType.Underscore) {
            return Some(Pattern.CatchAll)
        }
        if self.cur_token_is(TokenType.Int) {
            return Some(Pattern.IntLit(str_to_int(self.cur_tok.lexeme)))
        }
        if self.cur_token_is(TokenType.Ident) {
            // Enum variant paths (Color.Red) are folded into a single name
            // string; payload bindings (Shape.Circle(r)) are not
            // representable in ast.dot yet.
            return self.parse_pattern_path(self.cur_tok.lexeme)
        }
        self.errors.push("unsupported pattern token")
        return None
    }

    fn parse_pattern_path(mut self, name string) -> Option[Pattern] {
        if not self.peek_token_is(TokenType.Dot) {
            return Some(Pattern.Ident(name))
        }
        self.next_token() // cur = Dot
        if not self.peek_token_is(TokenType.Ident) {
            return Some(Pattern.Ident(name))
        }
        self.next_token() // cur = Ident
        return self.parse_pattern_path(name + "." + self.cur_tok.lexeme)
    }

    // fn(x int) -> int { x + 1 } -> Expr.FnLit. A missing body (no block)
    // is accepted silently, like trait method signatures in parse_fn_body.
    fn parse_fn_lit(mut self) -> Option[Expr] {
        start = self.cur_tok.pos

        if not self.expect_peek(TokenType.LParen) {
            return None
        }
        params = self.parse_params()

        ret_ty = self.parse_fn_lit_ret()
        body = self.parse_fn_lit_body()
        end = self.cur_tok.end
        return Some(Expr.FnLit(params, ret_ty, body, Span.new(start, end)))
    }

    // -> ret_ty is optional; the helper keeps the assignment out of an
    // if-branch so the value survives Dot's if-scope shadowing.
    fn parse_fn_lit_ret(mut self) -> Option[TypeNode] {
        if self.peek_token_is(TokenType.Arrow) {
            self.next_token() // cur = Arrow
            self.next_token() // cur = ret type start
            return Some(self.parse_type())
        }
        return None
    }

    fn parse_fn_lit_body(mut self) -> []Stmt {
        if self.peek_after_newline_is(TokenType.LBrace) {
            self.next_token() // cur = LBrace
            return self.parse_block_stmt()
        }
        return []Stmt{}
    }

    fn has_infix_parse_fn(self, t TokenType) -> bool {
        if kind_eq(t, TokenType.Plus) { return true }
        if kind_eq(t, TokenType.Minus) { return true }
        if kind_eq(t, TokenType.Star) { return true }
        if kind_eq(t, TokenType.Slash) { return true }
        if kind_eq(t, TokenType.Percent) { return true }
        if kind_eq(t, TokenType.EqEq) { return true }
        if kind_eq(t, TokenType.BangEq) { return true }
        if kind_eq(t, TokenType.Lt) { return true }
        if kind_eq(t, TokenType.Gt) { return true }
        if kind_eq(t, TokenType.LtEq) { return true }
        if kind_eq(t, TokenType.GtEq) { return true }
        if kind_eq(t, TokenType.And) { return true }
        if kind_eq(t, TokenType.Or) { return true }
        if kind_eq(t, TokenType.Amp) { return true }
        if kind_eq(t, TokenType.Pipe) { return true }
        if kind_eq(t, TokenType.Caret) { return true }
        if kind_eq(t, TokenType.Shl) { return true }
        if kind_eq(t, TokenType.Shr) { return true }
        if kind_eq(t, TokenType.DotDot) { return true }
        if kind_eq(t, TokenType.DotDotEq) { return true }
        if kind_eq(t, TokenType.PipeArrow) { return true }
        if kind_eq(t, TokenType.StarStar) { return true }
        if kind_eq(t, TokenType.Assign) { return true }
        if kind_eq(t, TokenType.PlusAssign) { return true }
        if kind_eq(t, TokenType.MinusAssign) { return true }
        if kind_eq(t, TokenType.StarAssign) { return true }
        if kind_eq(t, TokenType.SlashAssign) { return true }
        if kind_eq(t, TokenType.PercentAssign) { return true }
        if kind_eq(t, TokenType.AmpAssign) { return true }
        if kind_eq(t, TokenType.PipeAssign) { return true }
        if kind_eq(t, TokenType.CaretAssign) { return true }
        if kind_eq(t, TokenType.ShlAssign) { return true }
        if kind_eq(t, TokenType.ShrAssign) { return true }
        if kind_eq(t, TokenType.LParen) { return true }
        if kind_eq(t, TokenType.LBracket) { return true }
        if kind_eq(t, TokenType.Dot) { return true }
        if kind_eq(t, TokenType.Question) { return true }
        return false
    }

    fn is_assign_op(self, t TokenType) -> bool {
        if kind_eq(t, TokenType.Assign) { return true }
        if kind_eq(t, TokenType.PlusAssign) { return true }
        if kind_eq(t, TokenType.MinusAssign) { return true }
        if kind_eq(t, TokenType.StarAssign) { return true }
        if kind_eq(t, TokenType.SlashAssign) { return true }
        if kind_eq(t, TokenType.PercentAssign) { return true }
        if kind_eq(t, TokenType.AmpAssign) { return true }
        if kind_eq(t, TokenType.PipeAssign) { return true }
        if kind_eq(t, TokenType.CaretAssign) { return true }
        if kind_eq(t, TokenType.ShlAssign) { return true }
        if kind_eq(t, TokenType.ShrAssign) { return true }
        return false
    }

    fn parse_infix(mut self, left Expr) -> Expr {
        start = left.span().start
        op = self.cur_tok.kind
        precedence = self.cur_precedence()

        if self.cur_token_is(TokenType.LParen) {
            // Call
            args = self.parse_expr_list(TokenType.RParen)
            end = self.cur_tok.end
            return Expr.Call([left], args, Span.new(start, end))
        }
        if self.cur_token_is(TokenType.LBracket) {
            // Index (including s[1..3] which becomes Index(left, [Binary(1, DotDot, 3)])
            // since ast.dot has no SliceExpr variant)
            self.next_token()
            idx = self.parse_expr(PREC_LOWEST)
            if idx.is_none() {
                self.errors.push("expected index expression")
                for not self.cur_token_is(TokenType.RBracket) and not self.cur_token_is(TokenType.EOF) {
                    self.next_token()
                }
                return left
            }
            if not self.expect_peek(TokenType.RBracket) {
                return left
            }
            end = self.cur_tok.end
            return Expr.Index([left], [idx.unwrap()], Span.new(start, end))
        }
        if self.cur_token_is(TokenType.Dot) {
            // Field (tuple indexing t.0 is not representable in ast.dot yet)
            if not self.expect_peek(TokenType.Ident) {
                return left
            }
            name = self.cur_tok.lexeme
            end = self.cur_tok.end
            return Expr.Field([left], name, Span.new(start, end))
        }
        if self.is_assign_op(op) {
            self.next_token()
            right = self.parse_expr(PREC_LOWEST)
            if right.is_none() {
                self.errors.push("expected expression after assignment operator")
                return left
            }
            end = self.cur_tok.end
            return Expr.Assign([left], op, [right.unwrap()], Span.new(start, end))
        }
        if self.cur_token_is(TokenType.Question) {
            // try-expression `expr?` — no TryExpr variant in ast.dot yet
            self.errors.push("try expression ? is not supported yet")
            return left
        }

        // Binary (also covers PipeArrow pipe and DotDot/DotDotEq range,
        // which have no dedicated variants in ast.dot yet)
        self.next_token()
        // Power operator is right-associative
        is_starstar = kind_eq(op, TokenType.StarStar)
        next_prec = if is_starstar { 
            precedence - 1 
        } else { 
            precedence 
        }
        
        right = self.parse_expr(next_prec)
        if right.is_none() {
            self.errors.push("expected expression after operator")
            return left
        }
        end = self.cur_tok.end
        return Expr.Binary([left], op, [right.unwrap()], Span.new(start, end))
    }

    fn parse_expr_list(mut self, end_type TokenType) -> []Expr {
        list = []Expr{}

        if self.peek_token_is(end_type) {
            self.next_token()
            return list
        }

        self.next_token()
        first = self.parse_expr(PREC_LOWEST)
        if first.is_some() {
            list.push(first.unwrap())
        }

        for self.peek_token_is(TokenType.Comma) {
            self.next_token()
            self.next_token()
            el = self.parse_expr(PREC_LOWEST)
            if el.is_some() {
                list.push(el.unwrap())
            }
        }

        if not self.expect_peek(end_type) {
            return []Expr{}
        }

        return list
    }
}

fn parse_int_part(s string, i int, acc int) -> int {
    if i >= s.len {
        return acc
    }
    ch = s[i] as int
    if ch >= 48 and ch <= 57 {
        return parse_int_part(s, i + 1, acc * 10 + (ch - 48))
    }
    return parse_int_part(s, i + 1, acc)
}

fn str_to_int(s string) -> int {
    return parse_int_part(s, 0, 0)
}

fn parse_float_part(s string, i int, whole float, frac float, divisor float, seen_dot bool) -> float {
    if i >= s.len {
        return whole + frac
    }
    ch = s[i] as int
    if ch == 46 {
        return parse_float_part(s, i + 1, whole, frac, divisor, true)
    }
    if ch >= 48 and ch <= 57 {
        digit = ch - 48
        if seen_dot {
            return parse_float_part(s, i + 1, whole, frac + (digit as float) / (divisor * 10.0), divisor * 10.0, true)
        }
        return parse_float_part(s, i + 1, whole * 10.0 + (digit as float), frac, divisor, false)
    }
    return parse_float_part(s, i + 1, whole, frac, divisor, seen_dot)
}

fn str_to_float(s string) -> float {
    return parse_float_part(s, 0, 0.0, 0.0, 1.0, false)
}

pub fn token_precedence(t TokenType) -> int {
    if kind_eq(t, TokenType.Assign) or kind_eq(t, TokenType.PlusAssign) or kind_eq(t, TokenType.MinusAssign) or kind_eq(t, TokenType.StarAssign) or kind_eq(t, TokenType.SlashAssign) or kind_eq(t, TokenType.PercentAssign) or kind_eq(t, TokenType.AmpAssign) or kind_eq(t, TokenType.PipeAssign) or kind_eq(t, TokenType.CaretAssign) or kind_eq(t, TokenType.ShlAssign) or kind_eq(t, TokenType.ShrAssign) { return PREC_ASSIGNMENT }
    if kind_eq(t, TokenType.PipeArrow) { return PREC_PIPE }
    if kind_eq(t, TokenType.Or) { return PREC_LOGICAL_OR }
    if kind_eq(t, TokenType.And) { return PREC_LOGICAL_AND }
    if kind_eq(t, TokenType.EqEq) or kind_eq(t, TokenType.BangEq) { return PREC_EQUALITY }
    if kind_eq(t, TokenType.Lt) or kind_eq(t, TokenType.Gt) or kind_eq(t, TokenType.LtEq) or kind_eq(t, TokenType.GtEq) { return PREC_COMPARISON }
    if kind_eq(t, TokenType.Pipe) { return PREC_BIT_OR }
    if kind_eq(t, TokenType.Caret) { return PREC_BIT_XOR }
    if kind_eq(t, TokenType.Amp) { return PREC_BIT_AND }
    if kind_eq(t, TokenType.Shl) or kind_eq(t, TokenType.Shr) { return PREC_SHIFT }
    if kind_eq(t, TokenType.DotDot) or kind_eq(t, TokenType.DotDotEq) { return PREC_RANGE }
    if kind_eq(t, TokenType.Plus) or kind_eq(t, TokenType.Minus) { return PREC_SUM }
    if kind_eq(t, TokenType.Star) or kind_eq(t, TokenType.Slash) or kind_eq(t, TokenType.Percent) { return PREC_PRODUCT }
    if kind_eq(t, TokenType.StarStar) { return PREC_POWER }
    if kind_eq(t, TokenType.LParen) or kind_eq(t, TokenType.Dot) or kind_eq(t, TokenType.LBracket) { return PREC_CALL }
    if kind_eq(t, TokenType.Question) { return PREC_CALL }
    return PREC_LOWEST
}
