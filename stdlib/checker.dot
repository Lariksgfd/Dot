import ast
import types
import lexer
import checker_stmt
import checker_expr

pub struct StructInfo {
    name   string
    fields []Symbol
}

pub struct Checker {
    current_scope []Scope
    errors        []string
    loop_depth    int
    ret_ty        []Type
    type_params   []string
    structs       []StructInfo
}

impl Checker {
    pub fn new() -> Checker {
        global_scope = Scope.new([]Scope{})

        // Define some builtins
        global_scope.define(Symbol {
            name: "print",
            kind: SymbolKind.Function,
            ty: Type.Func(params: []Type{Type.Unknown}, ret_ty: []Type{Type.Void}),
            is_mut: false,
        })

        return Checker {
            current_scope: []Scope{global_scope},
            errors: []string{},
            loop_depth: 0,
            ret_ty: []Type{},
            type_params: []string{},
            structs: []StructInfo{},
        }
    }

    pub fn error(mut self, span Span, msg string) {
        self.errors.push("Type Error: {msg}")
    }

    pub fn push_scope(mut self) {
        new_scope = Scope.new(self.current_scope)
        self.current_scope = []Scope{new_scope}
    }

    pub fn pop_scope(mut self) {
        if self.current_scope.len > 0 {
            if self.current_scope[0].parent.len > 0 {
                self.current_scope = self.current_scope[0].parent
            }
        }
    }

    pub fn check_decl(mut self, decl Decl) {
        match decl {
            Decl.Fn(name, params, type_params, ret_ty, body, span) => self.check_fn_decl(name, params, type_params, ret_ty, body, span)
            Decl.Struct(name, fields, span) => self.check_struct_decl(name, fields, span)
            Decl.Enum(name, variants, span) => self.check_enum_decl(name, variants, span)
            Decl.Trait(name, methods, span) => {}
            Decl.Impl(trait_name, target, methods, span) => {}
        }
    }

    fn check_struct_decl(mut self, name string, fields []FieldDef, span Span) {
        syms = []Symbol{}
        for f in fields {
            syms.push(Symbol {
                name: f.name,
                kind: SymbolKind.Variable,
                ty: self.resolve_type(f.ty, []string{}),
                is_mut: false,
            })
        }
        self.structs.push(StructInfo { name, fields: syms })
    }

    // Enum variants are recorded as fields of a synthetic entry so that
    // match arms on Enum.Variant can be resolved by name. Each variant also
    // gets a constructor whose params are its real payload types (T-064c2);
    // a payload-less variant gets an empty params list, so a zero-arg call
    // passes the arity check. The variant's structs entry stores the payload
    // types as the params of a Func so match patterns can bind them
    // (T-051 stage 0).
    fn check_enum_decl(mut self, name string, variants []VariantDef, span Span) {
        enum_ty = Type.Struct(name: name)
        fields = []Symbol{}
        for v in variants {
            payload_types = []Type{}
            for p in v.params {
                payload_types.push(self.resolve_type(p.ty, []string{}))
            }
            fields.push(Symbol {
                name: v.name,
                kind: SymbolKind.Variable,
                ty: Type.Func(params: payload_types, ret_ty: []Type{enum_ty}),
                is_mut: false,
            })
            self.current_scope[0].define(Symbol {
                name: v.name,
                kind: SymbolKind.Function,
                ty: Type.Func(params: payload_types, ret_ty: []Type{enum_ty}),
                is_mut: false,
            })
        }
        self.structs.push(StructInfo { name, fields })
        self.current_scope[0].define(Symbol {
            name,
            kind: SymbolKind.Struct,
            ty: enum_ty,
            is_mut: false,
        })
    }

    fn check_fn_decl(mut self, name string, params []Param, type_params []string, ret_ty Option[TypeNode], body []Stmt, span Span) {
        // 0. Install the type parameters so resolve_type can turn their
        // names into TypeVar types while checking params, return type and body.
        self.type_params = type_params

        // 1. Resolve return type. A helper is used because a bare
        // `resolved_ret_ty = ...` inside an if-body would declare a shadow
        // variable (Dot scoping), not reassign the outer one.
        resolved_ret_ty = self.resolve_ret_ty(ret_ty, self.type_params)

        // 2. Resolve param types
        param_types = []Type{}
        for p in params {
            param_types.push(self.resolve_type(p.ty, self.type_params))
        }

        // 3. Register function in current scope
        fn_ty = Type.Func(params: param_types, ret_ty: []Type{resolved_ret_ty})
        self.current_scope[0].define(Symbol {
            name,
            kind: SymbolKind.Function,
            ty: fn_ty,
            is_mut: false,
        })

        // 4. Enter function scope
        self.push_scope()
        self.ret_ty = []Type{resolved_ret_ty}

        // Define params in the function's scope
        i = 0
        for p in params {
            self.current_scope[0].define(Symbol {
                name: p.name,
                kind: SymbolKind.Variable,
                ty: param_types[i],
                is_mut: false,
            })
            i += 1
        }

        // 5. Check body and remember the tail type (value of the last
        // expression statement, if any)
        tail_ty = self.check_fn_body_tail(body, 0, Type.Unknown)

        // 6. Body type vs declared return type (simplified port of Go's
        // checkMissingReturn + assignCompatible): a known tail type must be
        // compatible, and a body that can fall off the end without a single
        // return is an error.
        if is_known(resolved_ret_ty) {
            if not resolved_ret_ty.equals(Type.Void) {
                if is_known(tail_ty) {
                    if not compatible(resolved_ret_ty, tail_ty) {
                        self.error(span, "Function body type mismatch")
                    }
                } else {
                    if not self.check_fn_body_has_return(body, 0) {
                        self.error(span, "Missing return value")
                    }
                }
            }
        }

        // 7. Leave scope
        self.ret_ty = []Type{}
        self.pop_scope()
        self.type_params = []string{}
    }

    fn resolve_ret_ty(mut self, ret_ty Option[TypeNode], tps []string) -> Type {
        if ty_node = ret_ty {
            return self.resolve_type(ty_node, tps)
        }
        return Type.Void
    }

    fn resolve_type(mut self, node TypeNode, tps []string) -> Type {
        match node {
            TypeNode.Named(name, span) => {
                if type_param_list_contains(tps, name, 0) {
                    return Type.TypeVar(name: name)
                }
                if name == "int" { return Type.Int }
                if name == "float" { return Type.Float }
                if name == "bool" { return Type.Bool }
                if name == "string" { return Type.String }
                // fallback
                return Type.Struct(name: name)
            }
            TypeNode.Array(elem_ty, span) => {
                if elem_ty.len > 0 {
                    return Type.Array(elem: []Type{self.resolve_type(elem_ty[0], tps)})
                }
            }
            TypeNode.Slice(elem_ty, span) => {
                if elem_ty.len > 0 {
                    return Type.Slice(elem: []Type{self.resolve_type(elem_ty[0], tps)})
                }
            }
            TypeNode.Func(params, ret_ty, span) => {
                param_types = []Type{}
                for p in params {
                    param_types.push(self.resolve_type(p, tps))
                }
                return Type.Func(params: param_types, ret_ty: []Type{self.resolve_ret_ty(ret_ty, tps)})
            }
            TypeNode.Pointer(elem_ty, span) => {
                return Type.Unknown
            }
            TypeNode.Map(key_ty, val_ty, span) => {
                if key_ty.len > 0 and val_ty.len > 0 {
                    return Type.Map(key: []Type{self.resolve_type(key_ty[0], tps)}, val: []Type{self.resolve_type(val_ty[0], tps)})
                }
            }
            _ => {}
        }
        return Type.Unknown
    }
}

pub fn is_catchall(p Pattern) -> bool {
    return match p {
        Pattern.CatchAll => true
        _ => false
    }
}

pub fn is_range_expr(e Expr) -> bool {
    match e {
        Expr.Binary(_, op, _, _) => {
            return is_range_op(op)
        }
        _ => {}
    }
    return false
}

pub fn is_range_op(op TokenType) -> bool {
    return match op {
        TokenType.DotDot => true
        TokenType.DotDotEq => true
        _ => false
    }
}

pub fn is_unknown(t Type) -> bool {
    return match t {
        Type.Unknown => true
        _ => false
    }
}

pub fn is_error(t Type) -> bool {
    return match t {
        Type.Error => true
        _ => false
    }
}

pub fn is_known(t Type) -> bool {
    if is_unknown(t) or is_error(t) {
        return false
    }
    return true
}

pub fn is_bool(t Type) -> bool {
    return match t {
        Type.Bool => true
        _ => false
    }
}

pub fn is_int(t Type) -> bool {
    return match t {
        Type.Int => true
        _ => false
    }
}

pub fn is_float(t Type) -> bool {
    return match t {
        Type.Float => true
        _ => false
    }
}

pub fn is_string(t Type) -> bool {
    return match t {
        Type.String => true
        _ => false
    }
}

// Type compatibility for this checker version: exact matches plus a few
// stub-level relaxations (nil fits anything, arrays and slices interchange).
pub fn compatible(a Type, b Type) -> bool {
    if a.equals(b) or b.equals(a) {
        return true
    }
    match a {
        Type.Nil => { return true }
        _ => {}
    }
    match b {
        Type.Nil => { return true }
        _ => {}
    }
    match a {
        Type.Array(ae) => {
            match b {
                Type.Slice(be) => {
                    if ae.len > 0 and be.len > 0 {
                        return ae[0].equals(be[0]) or be[0].equals(ae[0])
                    }
                    return true
                }
                _ => {}
            }
        }
        Type.Slice(ae) => {
            match b {
                Type.Array(be) => {
                    if ae.len > 0 and be.len > 0 {
                        return ae[0].equals(be[0]) or be[0].equals(ae[0])
                    }
                    return true
                }
                _ => {}
            }
        }
        _ => {}
    }
    return false
}

pub fn type_param_list_contains(tps []string, name string, i int) -> bool {
    if i >= tps.len {
        return false
    }
    if tps[i] == name {
        return true
    }
    return type_param_list_contains(tps, name, i + 1)
}

pub fn lookup_binding(bindings []TypeBinding, name string, i int) -> Option[Type] {
    if i >= bindings.len {
        return None
    }
    if bindings[i].name == name {
        return Some(bindings[i].ty)
    }
    return lookup_binding(bindings, name, i + 1)
}

// Substitute every TypeVar in t using bindings (linear scan by name).
// Unknown names are left as-is.
pub fn substitute(t Type, bindings []TypeBinding, i int) -> Type {
    match t {
        Type.TypeVar(name) => {
            if b_ty = lookup_binding(bindings, name, 0) {
                return b_ty
            }
            return t
        }
        Type.Func(params, ret_ty) => {
            return Type.Func(params: type_lists_subst(params, bindings, 0), ret_ty: type_lists_subst(ret_ty, bindings, 0))
        }
        Type.Array(elem) => {
            return Type.Array(elem: type_lists_subst(elem, bindings, 0))
        }
        Type.Slice(elem) => {
            return Type.Slice(elem: type_lists_subst(elem, bindings, 0))
        }
        _ => { return t }
    }
    return t
}

pub fn type_lists_subst(a []Type, bindings []TypeBinding, i int) -> []Type {
    if i >= a.len {
        return []Type{}
    }
    out = []Type{}
    out.push(substitute(a[i], bindings, 0))
    return append_type_list(out, type_lists_subst(a, bindings, i + 1), 0)
}

pub fn append_type_list(dst []Type, src []Type, i int) -> []Type {
    if i >= src.len {
        return dst
    }
    dst.push(src[i])
    return append_type_list(dst, src, i + 1)
}

// Returns a fresh slice with one more binding appended; the input is never mutated.
pub fn bind_typevar(bindings []TypeBinding, name string, ty Type) -> []TypeBinding {
    out = copy_type_bindings(bindings, 0, []TypeBinding{})
    out.push(TypeBinding { name: name, ty: ty })
    return out
}

fn copy_type_bindings(bindings []TypeBinding, i int, acc []TypeBinding) -> []TypeBinding {
    if i >= bindings.len {
        return acc
    }
    acc.push(bindings[i])
    return copy_type_bindings(bindings, i + 1, acc)
}

pub fn index_of_char(s string, ch int) -> int {
    i = 0
    for i < s.len {
        c = s[i] as int
        if c == ch {
            return i
        }
        i += 1
    }
    return -1
}
