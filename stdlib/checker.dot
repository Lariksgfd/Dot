import ast
import types
import lexer
import checker_stmt
import checker_expr

pub struct StructInfo {
    name   string
    fields []Symbol
}

pub struct Checker {
    current_scope []Scope
    errors        []string
    loop_depth    int
    ret_ty        []Type
    structs       []StructInfo
}

impl Checker {
    pub fn new() -> Checker {
        global_scope = Scope.new([]Scope{})

        // Define some builtins
        global_scope.define(Symbol {
            name: "print",
            kind: SymbolKind.Function,
            ty: Type.Func(params: []Type{Type.String}, ret_ty: []Type{Type.Void}),
            is_mut: false,
        })

        return Checker {
            current_scope: []Scope{global_scope},
            errors: []string{},
            loop_depth: 0,
            ret_ty: []Type{},
            structs: []StructInfo{},
        }
    }

    pub fn error(mut self, span Span, msg string) {
        self.errors.push("Type Error: {msg}")
    }

    pub fn push_scope(mut self) {
        new_scope = Scope.new(self.current_scope)
        self.current_scope = []Scope{new_scope}
    }

    pub fn pop_scope(mut self) {
        if self.current_scope.len > 0 {
            if self.current_scope[0].parent.len > 0 {
                self.current_scope = self.current_scope[0].parent
            }
        }
    }

    pub fn check_decl(mut self, decl Decl) {
        match decl {
            Decl.Fn(name, params, ret_ty, body, span) => self.check_fn_decl(name, params, ret_ty, body, span)
            Decl.Struct(name, fields, span) => self.check_struct_decl(name, fields, span)
            Decl.Enum(name, variants, span) => self.check_enum_decl(name, variants, span)
            Decl.Trait(name, methods, span) => {}
            Decl.Impl(trait_name, target, methods, span) => {}
        }
    }

    fn check_struct_decl(mut self, name string, fields []FieldDef, span Span) {
        syms = []Symbol{}
        for f in fields {
            syms.push(Symbol {
                name: f.name,
                kind: SymbolKind.Variable,
                ty: self.resolve_type(f.ty),
                is_mut: false,
            })
        }
        self.structs.push(StructInfo { name, fields: syms })
    }

    // Enum variants are recorded as fields of a synthetic entry so that
    // match arms on Enum.Variant can be resolved by name.
    fn check_enum_decl(mut self, name string, variants []VariantDef, span Span) {
        enum_ty = Type.Struct(name: name)
        fields = []Symbol{}
        for v in variants {
            fields.push(Symbol {
                name: v.name,
                kind: SymbolKind.Variable,
                ty: enum_ty,
                is_mut: false,
            })
        }
        self.structs.push(StructInfo { name, fields })
        self.current_scope[0].define(Symbol {
            name,
            kind: SymbolKind.Struct,
            ty: enum_ty,
            is_mut: false,
        })
    }

    fn check_fn_decl(mut self, name string, params []Param, ret_ty Option[TypeNode], body []Stmt, span Span) {
        // 1. Resolve return type
        resolved_ret_ty = Type.Void
        if ty_node = ret_ty {
            resolved_ret_ty = self.resolve_type(ty_node)
        }

        // 2. Resolve param types
        param_types = []Type{}
        for p in params {
            param_types.push(self.resolve_type(p.ty))
        }

        // 3. Register function in current scope
        fn_ty = Type.Func(params: param_types, ret_ty: []Type{resolved_ret_ty})
        self.current_scope[0].define(Symbol {
            name,
            kind: SymbolKind.Function,
            ty: fn_ty,
            is_mut: false,
        })

        // 4. Enter function scope
        self.push_scope()
        self.ret_ty = []Type{resolved_ret_ty}

        // Define params in the function's scope
        i = 0
        for p in params {
            self.current_scope[0].define(Symbol {
                name: p.name,
                kind: SymbolKind.Variable,
                ty: param_types[i],
                is_mut: false,
            })
            i += 1
        }

        // 5. Check body
        for stmt in body {
            self.check_stmt(stmt)
        }

        // 6. Leave scope
        self.ret_ty = []Type{}
        self.pop_scope()
    }

    fn resolve_type(mut self, node TypeNode) -> Type {
        match node {
            TypeNode.Named(name, span) => {
                if name == "int" { return Type.Int }
                if name == "float" { return Type.Float }
                if name == "bool" { return Type.Bool }
                if name == "string" { return Type.String }
                // fallback
                return Type.Struct(name: name)
            }
            TypeNode.Array(elem_ty, span) => {
                if elem_ty.len > 0 {
                    return Type.Array(elem: []Type{self.resolve_type(elem_ty[0])})
                }
            }
            TypeNode.Slice(elem_ty, span) => {
                if elem_ty.len > 0 {
                    return Type.Slice(elem: []Type{self.resolve_type(elem_ty[0])})
                }
            }
            _ => {}
        }
        return Type.Unknown
    }
}

pub fn is_catchall(p Pattern) -> bool {
    return match p {
        Pattern.CatchAll => true
        _ => false
    }
}

pub fn is_range_expr(e Expr) -> bool {
    match e {
        Expr.Binary(_, op, _, _) => {
            return is_range_op(op)
        }
        _ => {}
    }
    return false
}

pub fn is_range_op(op TokenType) -> bool {
    return match op {
        TokenType.DotDot => true
        TokenType.DotDotEq => true
        _ => false
    }
}

pub fn is_unknown(t Type) -> bool {
    return match t {
        Type.Unknown => true
        _ => false
    }
}

pub fn is_error(t Type) -> bool {
    return match t {
        Type.Error => true
        _ => false
    }
}

pub fn is_known(t Type) -> bool {
    if is_unknown(t) or is_error(t) {
        return false
    }
    return true
}

pub fn is_bool(t Type) -> bool {
    return match t {
        Type.Bool => true
        _ => false
    }
}

pub fn is_int(t Type) -> bool {
    return match t {
        Type.Int => true
        _ => false
    }
}

pub fn is_float(t Type) -> bool {
    return match t {
        Type.Float => true
        _ => false
    }
}

pub fn is_string(t Type) -> bool {
    return match t {
        Type.String => true
        _ => false
    }
}

// Type compatibility for this checker version: exact matches plus a few
// stub-level relaxations (nil fits anything, arrays and slices interchange).
pub fn compatible(a Type, b Type) -> bool {
    if a.equals(b) or b.equals(a) {
        return true
    }
    match a {
        Type.Nil => { return true }
        _ => {}
    }
    match b {
        Type.Nil => { return true }
        _ => {}
    }
    match a {
        Type.Array(ae) => {
            match b {
                Type.Slice(be) => {
                    if ae.len > 0 and be.len > 0 {
                        return ae[0].equals(be[0]) or be[0].equals(ae[0])
                    }
                    return true
                }
                _ => {}
            }
        }
        Type.Slice(ae) => {
            match b {
                Type.Array(be) => {
                    if ae.len > 0 and be.len > 0 {
                        return ae[0].equals(be[0]) or be[0].equals(ae[0])
                    }
                    return true
                }
                _ => {}
            }
        }
        _ => {}
    }
    return false
}

pub fn index_of_char(s string, ch int) -> int {
    i = 0
    for i < s.len {
        c = s[i] as int
        if c == ch {
            return i
        }
        i += 1
    }
    return -1
}
