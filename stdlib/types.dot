pub enum Type {
    Unknown
    Error
    Void
    Int
    Float
    Bool
    String
    Nil
    Func(params []Type, ret_ty []Type)
    Array(elem []Type)
    Slice(elem []Type)
    Struct(name string)
    TypeVar(name string)
    Map(key []Type, val []Type)
}

impl Type {
    pub fn equals(self, other Type) -> bool {
        match self {
            Type.Int => match other { Type.Int => true, _ => false }
            Type.Float => match other { Type.Float => true, _ => false }
            Type.Bool => match other { Type.Bool => true, _ => false }
            Type.String => match other { Type.String => true, _ => false }
            Type.Void => match other { Type.Void => true, _ => false }
            Type.Nil => match other { Type.Nil => true, _ => false }
            Type.Error => true // Error type matches anything to suppress cascading errors
            Type.Unknown => true
            Type.Func(params, ret_ty) => match other {
                Type.Func(oparams, oret) => {
                    if params.len != oparams.len or ret_ty.len != oret.len {
                        return false
                    }
                    for i in 0..params.len {
                        if not params[i].equals(oparams[i]) {
                            return false
                        }
                    }
                    for i in 0..ret_ty.len {
                        if not ret_ty[i].equals(oret[i]) {
                            return false
                        }
                    }
                    true
                }
                _ => false
            }
            Type.Array(elem) => match other {
                Type.Array(oelem) => {
                    if elem.len != oelem.len {
                        return false
                    }
                    for i in 0..elem.len {
                        if not elem[i].equals(oelem[i]) {
                            return false
                        }
                    }
                    true
                }
                _ => false
            }
            Type.Slice(elem) => match other {
                Type.Slice(oelem) => {
                    if elem.len != oelem.len {
                        return false
                    }
                    for i in 0..elem.len {
                        if not elem[i].equals(oelem[i]) {
                            return false
                        }
                    }
                    true
                }
                _ => false
            }
            Type.Struct(name) => match other {
                Type.Struct(oname) => name == oname
                _ => false
            }
            Type.TypeVar(name) => match other {
                Type.TypeVar(oname) => name == oname
                _ => false
            }
            Type.Map(key, val) => match other {
                Type.Map(ok, ov) => {
                    if key.len != ok.len or val.len != ov.len {
                        return false
                    }
                    for i in 0..key.len {
                        if not key[i].equals(ok[i]) {
                            return false
                        }
                    }
                    for i in 0..val.len {
                        if not val[i].equals(ov[i]) {
                            return false
                        }
                    }
                    true
                }
                _ => false
            }
        }
    }
}

pub struct TypeBinding {
    name string
    ty   Type
}

pub enum SymbolKind {
    Variable
    Function
    Struct
}

pub struct Symbol {
    name   string
    kind   SymbolKind
    ty     Type
    is_mut bool
}

pub struct Scope {
    // We use a slice of size 0 or 1 to emulate an Option[Scope] / heap reference
    // since Dot v0.1 might not have full GC/pointer support for recursive structs.
    parent  []Scope
    symbols []Symbol // Emulating a map/dict for simple v0.1
}

impl Scope {
    pub fn new(parent []Scope) -> Scope {
        return Scope {
            parent: parent,
            symbols: []Symbol{},
        }
    }

    pub fn define(mut self, sym Symbol) {
        self.symbols.push(sym)
    }

    pub fn lookup(self, name string) -> Option[Symbol] {
        // Search in current scope (reverse order to get latest shadowed var if applicable, though shadowing in same scope is error)
        i = self.symbols.len - 1
        for i >= 0 {
            if self.symbols[i].name == name {
                return Some(self.symbols[i])
            }
            i -= 1
        }

        // Search in parent
        if self.parent.len > 0 {
            return self.parent[0].lookup(name)
        }

        return None
    }
}