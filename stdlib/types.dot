pub enum Type {
    Unknown
    Error
    Void
    Int
    Float
    Bool
    String
    Nil
    Func(params []Type, ret_ty []Type)
    Array(elem []Type)
    Slice(elem []Type)
    Struct(name string)
    TypeVar(name string)
    Map(key []Type, val []Type)
}

impl Type {
    pub fn equals(self, other Type) -> bool {
        match self {
            Type.Int => {
                match other {
                    Type.Int => { return true }
                    _ => { return false }
                }
            }
            Type.Float => {
                match other {
                    Type.Float => { return true }
                    _ => { return false }
                }
            }
            Type.Bool => {
                match other {
                    Type.Bool => { return true }
                    _ => { return false }
                }
            }
            Type.String => {
                match other {
                    Type.String => { return true }
                    _ => { return false }
                }
            }
            Type.Void => {
                match other {
                    Type.Void => { return true }
                    _ => { return false }
                }
            }
            Type.Nil => {
                match other {
                    Type.Nil => { return true }
                    _ => { return false }
                }
            }
            Type.Error => { return true } // Error type matches anything to suppress cascading errors
            Type.Unknown => { return true }
            Type.Func(params, ret_ty) => {
                match other {
                    Type.Func(oparams, oret) => {
                        if not type_lists_equal(params, oparams, 0) {
                            return false
                        }
                        return type_lists_equal(ret_ty, oret, 0)
                    }
                    _ => { return false }
                }
            }
            Type.Array(elem) => {
                match other {
                    Type.Array(oelem) => {
                        return type_lists_equal(elem, oelem, 0)
                    }
                    _ => { return false }
                }
            }
            Type.Slice(elem) => {
                match other {
                    Type.Slice(oelem) => {
                        return type_lists_equal(elem, oelem, 0)
                    }
                    _ => { return false }
                }
            }
            Type.Struct(name) => {
                match other {
                    Type.Struct(oname) => { return name == oname }
                    _ => { return false }
                }
            }
            Type.TypeVar(name) => {
                match other {
                    Type.TypeVar(oname) => { return name == oname }
                    _ => { return false }
                }
            }
            Type.Map(key, val) => {
                match other {
                    Type.Map(ok, ov) => {
                        if not type_lists_equal(key, ok, 0) {
                            return false
                        }
                        return type_lists_equal(val, ov, 0)
                    }
                    _ => { return false }
                }
            }
        }
        return false
    }
}

pub fn type_lists_equal(a []Type, b []Type, i int) -> bool {
    if a.len != b.len {
        return false
    }
    if i >= a.len {
        return true
    }
    if a[i].equals(b[i]) {
        return type_lists_equal(a, b, i + 1)
    }
    return false
}

pub struct TypeBinding {
    name string
    ty   Type
}

pub enum SymbolKind {
    Variable
    Function
    Struct
}

pub struct Symbol {
    name   string
    kind   SymbolKind
    ty     Type
    is_mut bool
}

pub struct Scope {
    // We use a slice of size 0 or 1 to emulate an Option[Scope] / heap reference
    // since Dot v0.1 might not have full GC/pointer support for recursive structs.
    parent  []Scope
    symbols []Symbol // Emulating a map/dict for simple v0.1
}

impl Scope {
    pub fn new(parent []Scope) -> Scope {
        return Scope {
            parent: parent,
            symbols: []Symbol{},
        }
    }

    pub fn define(mut self, sym Symbol) {
        self.symbols.push(sym)
    }

    pub fn lookup(self, name string) -> Option[Symbol] {
        // Search in current scope (reverse order to get latest shadowed var if applicable, though shadowing in same scope is error)
        i = self.symbols.len - 1
        for i >= 0 {
            if self.symbols[i].name == name {
                return Some(self.symbols[i])
            }
            i -= 1
        }

        // Search in parent
        if self.parent.len > 0 {
            return self.parent[0].lookup(name)
        }

        return None
    }
}