import ast
import types
import lexer
import checker

impl Checker {
    pub fn check_expr(mut self, expr Expr) -> Type {
        match expr {
            Expr.IntLit(value, span) => { return Type.Int }
            Expr.FloatLit(value, span) => { return Type.Float }
            Expr.StringLit(value, span) => { return Type.String }
            Expr.BoolLit(value, span) => { return Type.Bool }
            Expr.NilLit(span) => { return Type.Nil }
            Expr.Ident(name, span) => {
                if sym = self.current_scope[0].lookup(name) {
                    if sym.kind == SymbolKind.Function {
                        // A bare variant constructor name (no call parens) is
                        // a variant VALUE of the enum type, not a function:
                        // payload-less variants are unit values (None), and
                        // legacy Unknown-param stubs keep typing as the enum
                        // value too.
                        match sym.ty {
                            Type.Func(params, ret_ty) => {
                                if ret_ty.len > 0 {
                                    if params.len == 0 {
                                        return ret_ty[0]
                                    }
                                    if params.len == 1 and is_unknown(params[0]) {
                                        return ret_ty[0]
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                    return sym.ty
                }
                self.error(span, "Undefined variable: {name}")
                return Type.Error
            }
            Expr.Unary(op, right, span) => {
                if right.len == 0 {
                    return Type.Error
                }
                t = self.check_expr(right[0])
                match op {
                    TokenType.Not => {
                        if is_known(t) {
                            if not is_bool(t) {
                                self.error(span, "'not' requires a bool operand")
                            }
                        }
                        return Type.Bool
                    }
                    TokenType.Minus => {
                        if is_known(t) {
                            if not is_int(t) and not is_float(t) {
                                self.error(span, "Unary minus requires a number")
                            }
                        }
                        return t
                    }
                    _ => {
                        return t
                    }
                }
                return Type.Unknown
            }
            Expr.Binary(left, op, right, span) => {
                return self.check_binary(left, op, right, span)
            }
            Expr.Call(callee, args, span) => {
                if callee.len == 0 {
                    return Type.Error
                }
                callee_ty = self.callee_type(callee[0])
                arg_tys = self.check_call_args(args, 0, []Type{})
                match callee_ty {
                    Type.Func(params, ret_ty) => {
                        return self.check_fn_call(params, ret_ty, arg_tys, args.len, span)
                    }
                    Type.Error => { return Type.Error }
                    Type.Unknown => { return Type.Unknown }
                    _ => {
                        self.error(span, "Cannot call non-function")
                        return Type.Error
                    }
                }
                return Type.Error
            }
            Expr.Index(left, index, span) => {
                return self.check_index(left, index, span)
            }
            Expr.Field(left, name, span) => {
                return self.check_field(left, name, span)
            }
            Expr.ArrayLit(elements, span) => {
                elem_ty = self.check_array_elems(elements, 0, Type.Unknown, span)
                return Type.Array(elem: []Type{elem_ty})
            }
            Expr.TupleLit(elements, span) => {
                return self.tuple_type(elements, 0, Type.Void)
            }
            Expr.If(condition, then_branch, else_branch, span) => {
                return self.check_if_expr(condition, then_branch, else_branch, span)
            }
            Expr.Match(value, arms, span) => {
                return self.check_match_expr(value, arms, span)
            }
            Expr.Block(body, span) => {
                self.push_scope()
                t = self.check_fn_body_tail(body, 0, Type.Unknown)
                self.pop_scope()
                return t
            }
            Expr.Assign(left, op, right, span) => {
                if left.len == 0 or right.len == 0 {
                    return Type.Error
                }
                l_ty = self.check_expr(left[0])
                r_ty = self.check_expr(right[0])
                if is_known(l_ty) and is_known(r_ty) {
                    if not compatible(l_ty, r_ty) {
                        self.error(span, "Type mismatch in assignment")
                    }
                }
                return Type.Void
            }
            Expr.FnLit(params, ret_ty, body, span) => {
                return self.check_fn_lit(params, ret_ty, body, span)
            }
            Expr.StructLit(name, fields, span) => {
                return self.check_struct_lit(name, fields, span)
            }
            Expr.MapLit(entries, span) => {
                return self.check_map_lit(entries, span)
            }
        }
        return Type.Unknown
    }

    fn check_fn_lit(mut self, params []Param, ret_ty Option[TypeNode], body []Stmt, span Span) -> Type {
        param_types = []Type{}
        for p in params {
            param_types.push(self.resolve_type(p.ty, self.type_params))
        }
        closure_ret = self.resolve_ret_ty(ret_ty, self.type_params)

        saved_ret = self.ret_ty
        self.ret_ty = []Type{closure_ret}
        self.push_scope()
        i = 0
        for p in params {
            self.current_scope[0].define(Symbol {
                name: p.name,
                kind: SymbolKind.Variable,
                ty: param_types[i],
                is_mut: false,
            })
            i += 1
        }
        self.check_fn_body_tail(body, 0, Type.Unknown)
        self.pop_scope()
        self.ret_ty = saved_ret

        return Type.Func(params: param_types, ret_ty: []Type{closure_ret})
    }

    fn check_binary(mut self, left []Expr, op TokenType, right []Expr, span Span) -> Type {
        if left.len == 0 or right.len == 0 {
            return Type.Error
        }
        l_ty = self.check_expr(left[0])
        r_ty = self.check_expr(right[0])

        match op {
            TokenType.PipeArrow => { return self.check_pipe(left[0], right[0], l_ty, r_ty, span) }
            TokenType.DotDot => { return self.check_range(l_ty, r_ty, span) }
            TokenType.DotDotEq => { return self.check_range(l_ty, r_ty, span) }
            TokenType.And => {
                self.require_bool(l_ty, span, "Left operand of 'and'")
                self.require_bool(r_ty, span, "Right operand of 'and'")
                return Type.Bool
            }
            TokenType.Or => {
                self.require_bool(l_ty, span, "Left operand of 'or'")
                self.require_bool(r_ty, span, "Right operand of 'or'")
                return Type.Bool
            }
            TokenType.EqEq => {
                self.require_same(l_ty, r_ty, span)
                return Type.Bool
            }
            TokenType.BangEq => {
                self.require_same(l_ty, r_ty, span)
                return Type.Bool
            }
            TokenType.Lt => {
                self.require_same(l_ty, r_ty, span)
                return Type.Bool
            }
            TokenType.Gt => {
                self.require_same(l_ty, r_ty, span)
                return Type.Bool
            }
            TokenType.LtEq => {
                self.require_same(l_ty, r_ty, span)
                return Type.Bool
            }
            TokenType.GtEq => {
                self.require_same(l_ty, r_ty, span)
                return Type.Bool
            }
            TokenType.Plus => {
                if is_string(l_ty) and is_string(r_ty) {
                    return Type.String
                }
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.Minus => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.Star => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.Slash => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.Percent => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.StarStar => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.Amp => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.Pipe => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.Caret => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.Shl => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            TokenType.Shr => {
                self.require_same(l_ty, r_ty, span)
                return l_ty
            }
            _ => { return Type.Unknown }
        }
        return Type.Unknown
    }

    // The left side is piped into the call on the right: it becomes the last
    // argument, or the only argument of a call with no arguments.
    fn check_pipe(mut self, lhs Expr, rhs Expr, l_ty Type, r_ty Type, span Span) -> Type {
        match rhs {
            Expr.Call(callee, args, _) => {
                if callee.len == 0 {
                    return Type.Error
                }
                callee_ty = self.check_expr(callee[0])
                arg_tys = self.check_call_args(args, 0, []Type{})
                match callee_ty {
                    Type.Func(params, ret_ty) => {
                        if args.len + 1 == params.len {
                            last_pt = params[params.len - 1]
                            if is_known(last_pt) and is_known(l_ty) {
                                if not compatible(last_pt, l_ty) {
                                    self.error(span, "Pipe argument type mismatch")
                                }
                            }
                            arg_tys.push(l_ty)
                            return self.check_fn_call(params, ret_ty, arg_tys, args.len + 1, span)
                        }
                        if args.len != params.len {
                            self.error(span, "Argument count mismatch")
                        }
                        return self.check_fn_call(params, ret_ty, arg_tys, args.len, span)
                    }
                    Type.Error => { return Type.Error }
                    Type.Unknown => { return Type.Unknown }
                    _ => {
                        self.error(span, "Cannot call non-function")
                        return Type.Error
                    }
                }
                return Type.Error
            }
            _ => {
                self.error(span, "Pipe right side must be a call")
                return l_ty
            }
        }
        return Type.Unknown
    }

    // Recursive argument walker: checks every argument and collects its type.
    fn check_call_args(mut self, args []Expr, i int, acc []Type) -> []Type {
        if i >= args.len {
            return acc
        }
        acc.push(self.check_expr(args[i]))
        return self.check_call_args(args, i + 1, acc)
    }

    // The type of a call target: an identifier naming a function is taken
    // directly from its symbol, so stub constructors stay callable even
    // though a bare name would type-check as the enum value.
    fn callee_type(mut self, callee Expr) -> Type {
        match callee {
            Expr.Ident(name, _) => {
                if sym = self.current_scope[0].lookup(name) {
                    if sym.kind == SymbolKind.Function {
                        return sym.ty
                    }
                }
                return self.check_expr(callee)
            }
            _ => {
                return self.check_expr(callee)
            }
        }
        return Type.Error
    }

    // Shared call logic: bind TypeVar params to known argument types, check
    // the arguments and substitute the bindings into the result type.
    fn check_fn_call(mut self, params []Type, ret_ty []Type, arg_tys []Type, nargs int, span Span) -> Type {
        // Lenient mode for enum variant stub constructors: one Unknown param
        // accepts any number of arguments and the result is the enum type.
        if params.len == 1 and is_unknown(params[0]) {
            if ret_ty.len > 0 {
                return ret_ty[0]
            }
            return Type.Void
        }
        if nargs != params.len {
            self.error(span, "Argument count mismatch")
        }
        bindings = self.collect_bindings(params, arg_tys, 0, []TypeBinding{}, span)
        self.check_fn_args(params, arg_tys, 0, span)
        if ret_ty.len > 0 {
            if is_known(ret_ty[0]) {
                return substitute(ret_ty[0], bindings, 0)
            }
            return ret_ty[0]
        }
        return Type.Void
    }

    // Binds TypeVar params to their known argument types, position by position.
    // A second binding for the same TypeVar must be compatible with the first
    // one, otherwise the call is a type conflict.
    fn collect_bindings(mut self, params []Type, arg_tys []Type, i int, acc []TypeBinding, span Span) -> []TypeBinding {
        if i >= params.len or i >= arg_tys.len {
            return acc
        }
        next = self.bind_one(params[i], arg_tys[i], acc, span)
        return self.collect_bindings(params, arg_tys, i + 1, next, span)
    }

    fn bind_one(mut self, p Type, a Type, acc []TypeBinding, span Span) -> []TypeBinding {
        match p {
            Type.TypeVar(n) => {
                if is_known(a) {
                    if prev = lookup_binding(acc, n, 0) {
                        if not compatible(prev, a) {
                            self.error(span, "Argument type mismatch")
                        }
                        return acc
                    }
                    return bind_typevar(acc, n, a)
                }
                return acc
            }
            _ => { return acc }
        }
        return acc
    }

    // TypeVar params accept anything; everything else is checked as usual.
    fn check_fn_args(mut self, params []Type, arg_tys []Type, i int, span Span) {
        if i >= params.len or i >= arg_tys.len {
            return
        }
        self.check_fn_arg(params[i], arg_tys[i], span)
        return self.check_fn_args(params, arg_tys, i + 1, span)
    }

    fn check_fn_arg(mut self, p Type, a Type, span Span) {
        match p {
            Type.TypeVar(_) => { return }
            _ => {}
        }
        if is_known(p) and is_known(a) {
            if not compatible(p, a) {
                self.error(span, "Argument type mismatch")
            }
        }
        return
    }

    fn check_range(mut self, l_ty Type, r_ty Type, span Span) -> Type {
        self.require_same(l_ty, r_ty, span)
        return if is_known(l_ty) { l_ty } else { r_ty }
    }

    fn check_index(mut self, left []Expr, index []Expr, span Span) -> Type {
        if left.len == 0 or index.len == 0 {
            return Type.Error
        }
        left_ty = self.check_expr(left[0])
        idx_ty = self.check_expr(index[0])

        // s[a..b] arrives as Index(left, Binary(a, DotDot, b)) since
        // ast.dot has no SliceExpr variant.
        if is_range_expr(index[0]) {
            return self.slice_type(left_ty, span)
        }

        if is_known(idx_ty) {
            if not is_int(idx_ty) {
                self.error(span, "Index must be an integer")
            }
        }

        match left_ty {
            Type.Array(elem) => {
                if elem.len > 0 {
                    return elem[0]
                }
                return Type.Unknown
            }
            Type.Slice(elem) => {
                if elem.len > 0 {
                    return elem[0]
                }
                return Type.Unknown
            }
            Type.String => { return Type.Int }
            Type.Error => { return Type.Error }
            Type.Unknown => { return Type.Unknown }
            _ => {
                self.error(span, "Cannot index this value")
                return Type.Unknown
            }
        }
        return Type.Unknown
    }

    fn slice_type(mut self, left_ty Type, span Span) -> Type {
        match left_ty {
            Type.Array(elem) => {
                if elem.len > 0 {
                    return Type.Slice(elem)
                }
                return Type.Unknown
            }
            Type.Slice(elem) => {
                if elem.len > 0 {
                    return Type.Slice(elem)
                }
                return Type.Unknown
            }
            Type.String => { return Type.String }
            Type.Error => { return Type.Error }
            Type.Unknown => { return Type.Unknown }
            _ => {
                self.error(span, "Cannot slice this value")
                return Type.Unknown
            }
        }
        return Type.Unknown
    }

    fn check_field(mut self, left []Expr, name string, span Span) -> Type {
        if left.len == 0 {
            return Type.Error
        }
        left_ty = self.check_expr(left[0])

        match left_ty {
            Type.Struct(struct_name) => {
                f_ty = self.find_struct_field(struct_name, name)
                if is_unknown(f_ty) {
                    if struct_name == "Option" {
                        m_ty = option_method(name)
                        if is_unknown(m_ty) {
                            self.error(span, "Unknown field: {name}")
                        }
                        return m_ty
                    }
                    if struct_name == "Result" {
                        m_ty = result_method(name)
                        if is_unknown(m_ty) {
                            self.error(span, "Unknown field: {name}")
                        }
                        return m_ty
                    }
                    self.error(span, "Unknown field: {name}")
                }
                return f_ty
            }
            Type.Array(_) => { return self.builtin_field(name) }
            Type.Slice(_) => { return self.builtin_field(name) }
            Type.String => { return self.builtin_field(name) }
            Type.Error => { return Type.Error }
            Type.Unknown => { return Type.Unknown }
            _ => {
                self.error(span, "Cannot access field on this value")
                return Type.Unknown
            }
        }
        return Type.Unknown
    }

    fn builtin_field(self, name string) -> Type {
        if name == "len" {
            return Type.Int
        }
        return Type.Unknown
    }

    fn check_if_expr(mut self, condition []Expr, then_branch []Stmt, else_branch []Expr, span Span) -> Type {
        if condition.len > 0 {
            cond_ty = self.check_expr(condition[0])
            self.require_bool(cond_ty, span, "If condition")
        }

        self.push_scope()
        then_ty = self.check_if_then(then_branch, 0, Type.Unknown)
        self.pop_scope()

        else_ty = self.check_else_branch(else_branch)

        if is_known(then_ty) and is_known(else_ty) {
            if not compatible(then_ty, else_ty) {
                self.error(span, "If branches have different types")
            }
        }
        return if is_known(then_ty) { then_ty } else { else_ty }
    }

    // The else-branch value lives in a helper: assigning `else_ty` from an
    // if-body would declare a shadow variable (Dot scoping), not reassign it.
    fn check_else_branch(mut self, else_branch []Expr) -> Type {
        if else_branch.len > 0 {
            return self.check_expr(else_branch[else_branch.len - 1])
        }
        return Type.Unknown
    }

    // Walks the then-branch, checking every statement and remembering the
    // type of the last expression statement as the branch value type.
    fn check_if_then(mut self, stmts []Stmt, i int, acc Type) -> Type {
        if i >= stmts.len {
            return acc
        }
        match stmts[i] {
            Stmt.ExprStmt(e, _) => {
                t = self.check_expr(e)
                return self.check_if_then(stmts, i + 1, t)
            }
            _ => {
                self.check_stmt(stmts[i])
                return self.check_if_then(stmts, i + 1, acc)
            }
        }
        return Type.Unknown
    }

    fn check_match_expr(mut self, value []Expr, arms []MatchArm, span Span) -> Type {
        sel_ty = self.match_sel_ty(value)
        return self.check_match_arms(arms, 0, sel_ty, Type.Unknown, span)
    }

    // The selector type, in a helper: a bare `sel_ty = ...` inside an
    // if-body would declare a shadow variable (Dot scoping), not reassign it.
    fn match_sel_ty(mut self, value []Expr) -> Type {
        if value.len > 0 {
            return self.check_expr(value[0])
        }
        return Type.Unknown
    }

    fn check_match_arms(mut self, arms []MatchArm, i int, sel_ty Type, result_ty Type, span Span) -> Type {
        if i >= arms.len {
            return result_ty
        }
        arm = arms[i]

        match arm.pattern {
            Pattern.Ident(name) => {
                dot_idx = index_of_char(name, 46)
                if dot_idx >= 0 {
                    // Enum variant path Enum.Variant: check it exists
                    enum_name = name[0..dot_idx]
                    variant_name = name[dot_idx + 1..name.len]
                    v_ty = self.find_struct_field(enum_name, variant_name)
                    if is_unknown(v_ty) {
                        self.error(span, "Unknown enum variant: {name}")
                    }
                } else {
                    // Value binding
                    self.current_scope[0].define(Symbol {
                        name,
                        kind: SymbolKind.Variable,
                        ty: sel_ty,
                        is_mut: false,
                    })
                }
            }
            Pattern.IntLit(_) => {
                if is_known(sel_ty) {
                    if not is_int(sel_ty) {
                        self.error(span, "Integer pattern does not match selector type")
                    }
                }
            }
            Pattern.CatchAll => {}
            Pattern.Variant(name, bindings) => {
                self.check_variant_pattern(name, bindings, sel_ty, span)
            }
        }

        if guard = arm.guard {
            g_ty = self.check_expr(guard)
            self.require_bool(g_ty, span, "Match guard")
        }

        arm_ty = self.check_expr(arm.body)

        if is_known(result_ty) and is_known(arm_ty) {
            if not compatible(result_ty, arm_ty) {
                self.error(span, "Match arms have different types")
            }
        }
        next_ty = if is_unknown(result_ty) { arm_ty } else { result_ty }
        return self.check_match_arms(arms, i + 1, sel_ty, next_ty, span)
    }

    // Enum variant pattern with payload bindings: the match arm
    // `Type.Func(oparams, oret) => oparams`.
    // The variant's payload types come from the enum entry in structs (each
    // variant is stored as a Func whose params are its payload types, see
    // check_enum_decl). Arity must match and every binding name is defined in
    // the current scope with its payload type.
    fn check_variant_pattern(mut self, name string, bindings []string, sel_ty Type, span Span) {
        dot_idx = index_of_char(name, 46)
        enum_name = self.variant_enum_name(name, dot_idx, sel_ty)
        variant_name = variant_name_of(name, dot_idx)
        v_ty = self.find_struct_field(enum_name, variant_name)
        if is_unknown(v_ty) {
            self.error(span, "Unknown enum variant: {name}")
            return
        }
        payload = variant_payload(v_ty)
        if bindings.len != payload.len {
            self.error(span, "Variant {name} takes a different number of values than the pattern binds")
        }
        self.bind_variant_bindings(bindings, payload, 0)
    }

    // The qualifier of a variant pattern: the part before the dot, or the
    // subject's enum name for an unqualified variant (Ok(n)).
    fn variant_enum_name(self, name string, dot_idx int, sel_ty Type) -> string {
        if dot_idx >= 0 {
            return name[0..dot_idx]
        }
        match sel_ty {
            Type.Struct(n) => { return n }
            _ => {}
        }
        return name
    }

    fn bind_variant_bindings(mut self, names []string, tys []Type, i int) {
        if i >= names.len {
            return
        }
        if i < tys.len {
            if names[i] != "_" {
                self.current_scope[0].define(Symbol {
                    name: names[i],
                    kind: SymbolKind.Variable,
                    ty: tys[i],
                    is_mut: false,
                })
            }
        }
        return self.bind_variant_bindings(names, tys, i + 1)
    }

    fn find_struct_field(self, struct_name string, field_name string) -> Type {
        for si in self.structs {
            if si.name == struct_name {
                for f in si.fields {
                    if f.name == field_name {
                        return f.ty
                    }
                }
            }
        }
        return Type.Unknown
    }

    fn require_same(mut self, l_ty Type, r_ty Type, span Span) {
        if is_known(l_ty) and is_known(r_ty) {
            if not compatible(l_ty, r_ty) {
                self.error(span, "Type mismatch in binary expression")
            }
        }
    }

    fn require_bool(mut self, t Type, span Span, what string) {
        if is_known(t) {
            if not is_bool(t) {
                self.error(span, "{what} must be bool")
            }
        }
    }

    fn check_array_elems(mut self, elements []Expr, i int, elem_ty Type, span Span) -> Type {
        if i >= elements.len {
            return elem_ty
        }
        e_ty = self.check_expr(elements[i])
        if is_known(elem_ty) and is_known(e_ty) {
            if not compatible(elem_ty, e_ty) {
                self.error(span, "Array elements must have the same type")
            }
        }
        next_ty = if is_unknown(elem_ty) { e_ty } else { elem_ty }
        return self.check_array_elems(elements, i + 1, next_ty, span)
    }

    fn check_map_lit(mut self, entries []MapEntryNode, span Span) -> Type {
        return self.check_map_entries(entries, 0, Type.Unknown, Type.Unknown, span)
    }

    // Walks map literal entries, accumulating the first known key and value
    // types and requiring every later entry to be compatible with them.
    fn check_map_entries(mut self, entries []MapEntryNode, i int, k_ty Type, v_ty Type, span Span) -> Type {
        if i >= entries.len {
            return Type.Map(key: []Type{k_ty}, val: []Type{v_ty})
        }
        entry = entries[i]
        k = self.check_expr(entry.key)
        v = self.check_expr(entry.value)
        if is_known(k_ty) and is_known(k) {
            if not compatible(k_ty, k) {
                self.error(span, "Map keys must have the same type")
            }
        }
        if is_known(v_ty) and is_known(v) {
            if not compatible(v_ty, v) {
                self.error(span, "Map values must have the same type")
            }
        }
        next_k = if is_unknown(k_ty) { k } else { k_ty }
        next_v = if is_unknown(v_ty) { v } else { v_ty }
        return self.check_map_entries(entries, i + 1, next_k, next_v, span)
    }

    fn tuple_type(mut self, elements []TupleElem, i int, first Type) -> Type {
        if i >= elements.len {
            return first
        }
        t = self.check_expr(elements[i].value)
        next_first = if i == 0 { t } else { first }
        return self.tuple_type(elements, i + 1, next_first)
    }

    // Struct literal: Point { x: 1, y: 2 }. Every field is checked against
    // the declared StructInfo; an undeclared struct yields Unknown field
    // types, so all of its fields report "Unknown field".
    fn check_struct_lit(mut self, name string, fields []StructLitField, span Span) -> Type {
        self.check_struct_lit_fields(fields, 0, name, span)
        return Type.Struct(name: name)
    }

    fn check_struct_lit_fields(mut self, fields []StructLitField, i int, name string, span Span) {
        if i >= fields.len {
            return
        }
        field = fields[i]
        f_ty = self.find_struct_field(name, field.name)
        if is_unknown(f_ty) {
            self.error(span, "Unknown field: {field.name}")
        }
        val_ty = self.check_expr(field.value)
        if is_known(f_ty) and is_known(val_ty) {
            if not compatible(f_ty, val_ty) {
                self.error(span, "Struct field type mismatch")
            }
        }
        return self.check_struct_lit_fields(fields, i + 1, name, span)
    }
}

// Built-in methods of the Option enum. The element type is not tracked, so
// closures take and return Unknown.
pub fn option_method(name string) -> Type {
    if name == "map" {
        return Type.Func(params: []Type{Type.Func(params: []Type{Type.Unknown}, ret_ty: []Type{Type.Unknown})}, ret_ty: []Type{Type.Struct(name: "Option")})
    }
    if name == "and_then" {
        return Type.Func(params: []Type{Type.Func(params: []Type{Type.Unknown}, ret_ty: []Type{Type.Unknown})}, ret_ty: []Type{Type.Struct(name: "Option")})
    }
    if name == "unwrap" {
        return Type.Func(params: []Type{}, ret_ty: []Type{Type.Unknown})
    }
    if name == "is_some" {
        return Type.Func(params: []Type{}, ret_ty: []Type{Type.Bool})
    }
    if name == "is_none" {
        return Type.Func(params: []Type{}, ret_ty: []Type{Type.Bool})
    }
    return Type.Unknown
}

// Built-in methods of the Result enum.
pub fn result_method(name string) -> Type {
    if name == "unwrap" {
        return Type.Func(params: []Type{}, ret_ty: []Type{Type.Unknown})
    }
    if name == "is_ok" {
        return Type.Func(params: []Type{}, ret_ty: []Type{Type.Bool})
    }
    if name == "is_err" {
        return Type.Func(params: []Type{}, ret_ty: []Type{Type.Bool})
    }
    if name == "map" {
        return Type.Func(params: []Type{Type.Func(params: []Type{Type.Unknown}, ret_ty: []Type{Type.Unknown})}, ret_ty: []Type{Type.Struct(name: "Result")})
    }
    if name == "map_err" {
        return Type.Func(params: []Type{Type.Func(params: []Type{Type.Unknown}, ret_ty: []Type{Type.Unknown})}, ret_ty: []Type{Type.Struct(name: "Result")})
    }
    return Type.Unknown
}

// The payload types of an enum variant: check_enum_decl stores each variant
// in structs as a Func whose params are its payload types.
pub fn variant_payload(v_ty Type) -> []Type {
    match v_ty {
        Type.Func(params, _) => { return params }
        _ => {}
    }
    return []Type{}
}

// The variant part of a pattern path: the text after the last dot, or the
// whole name for an unqualified variant.
pub fn variant_name_of(name string, dot_idx int) -> string {
    if dot_idx >= 0 {
        return name[dot_idx + 1..name.len]
    }
    return name
}
