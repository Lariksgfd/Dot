// stdlib/codegen_decl.dot - T-051 stage 5a1+5a2: declaration + definition
// emitter for the self-hosted C codegen. Port of Go codegen/emit_decl.go
// (emitStructDef, emitEnumDef, emitStructFwd/emitEnumFwd, emitFuncDecls,
// emitFuncDef) and codegen/types.go (cFieldName, variantFieldName). Covered:
// named struct definitions, tagged-union enum definitions (DotRefcnt header
// + int32_t tag + payload union), fn forward declarations + definitions
// (incl. tail-expression materialisation) and impl method declarations +
// definitions (Dot_<Recv>_<Method> with Dot<Recv>* self). Trait stays a TODO
// marker until 5b/6.
//
// [РЕШЕНИЕ] Definition forms are copied verbatim from the Go compiler's
// actual C output (verified with `dot build` of a struct+enum sample):
// named types render as `struct Dot<Name> { ... };` and the typedef name
// comes from emit_type_fwd (the Go emitStructFwd/emitEnumFwd pair, grouped
// by the driver before definitions as in emit_types.go). The anonymous
// `typedef struct { ... } Dot<Name>;` form is NOT used here — that one is
// Go's cAnonStruct for inline types like DotFn_*.
//
// [РЕШЕНИЕ] Field names carry the dot_ prefix (c_field_name) and enum
// payload members are dot_<Variant>_<field> (variant_field_name): every
// variant of an enum shares one C union, so bare field names would be
// ambiguous (IntLit(value) vs StringLit(value)).
import ast
import codegen
import codegen_types
import codegen_stmt
import codegen_expr

// emit_type_decl renders one top-level Decl that defines a type or a
// function (the 5b driver's definition pass). Struct/Enum produce full
// definitions, Fn/Impl route to the 5a2 emitters; Trait stays a TODO
// marker until the vtable pass (5b/6).
pub fn emit_type_decl(d Decl, out CBuilder, depth int) {
    match d {
        Decl.Struct(name, fields, _) => emit_struct_def(name, fields, out, depth)
        Decl.Enum(name, variants, _) => emit_enum_def(name, variants, out, depth)
        Decl.Trait(name, _, _) => bwriteln(out, depth, "/* <TODO 5b: trait vtable " + name + "> */")
        Decl.Impl(_, target, methods, _) => emit_impl_def_from(target, methods, out, depth, []FnSig{}, []CodegenStructInfo{})
        Decl.Fn(name, params, _, ret_ty, body, _) => emit_fn_def_from(name, params, ret_ty, body, out, depth, []FnSig{}, []CodegenStructInfo{})
        // extern decls live in the C runtime headers: ExternFn prototypes
        // are emitted by emit_fn_decl (stage 7c2, `extern` prefix) and its
        // definition is skipped in emit_fn_defs (no body in the AST);
        // ExternStruct emits NO typedef/def at all — the C header owns the
        // type (Go isExternType, emit_types.go:49).
        Decl.ExternFn(_, _, _, _) => {}
        Decl.ExternStruct(_, _) => {}
    }
}

// emit_struct_def renders a named struct definition, verbatim Go form
// (emitStructDef): `struct Dot<Name> { <ctype> dot_<field>; ... };`. The
// Dot<Name> typedef name itself is emitted separately by emit_type_fwd so
// the driver can group all forwards before any definition (Go emit_types.go).
pub fn emit_struct_def(name string, fields []FieldDef, out CBuilder, depth int) {
    bwriteln(out, depth, "struct Dot" + name + " {{")
    for f in fields {
        bwriteln(out, depth + 1, ty_to_c(tynode_to_ty(f.ty)) + " " + c_field_name(f.name) + ";")
    }
    bwriteln(out, depth, "}};")
    bwriteln(out, depth, "")
}

// emit_enum_def renders a tagged-union enum definition, verbatim Go form
// (emitEnumDef + cAnonEnum payload grouping): the DotRefcnt header sits at
// offset 0 so dot_retain/dot_release work on the object pointer directly,
// then the int32_t tag, then a union with one anonymous struct per payload
// variant so multi-field variants do not overlap. Unit variants contribute
// nothing to the union (Go skips variants with zero fields).
pub fn emit_enum_def(name string, variants []VariantDef, out CBuilder, depth int) {
    bwriteln(out, depth, "struct Dot" + name + " {{")
    bwriteln(out, depth + 1, "DotRefcnt _rc;")
    bwriteln(out, depth + 1, "int32_t tag;")
    emit_enum_union(variants, out, depth + 1)
    bwriteln(out, depth, "}};")
    bwriteln(out, depth, "")
}

// emit_enum_union emits the `union { ... };` block at the given depth, only
// when at least one variant carries a payload (Go emitEnumDef hasPayload
// guard).
fn emit_enum_union(variants []VariantDef, out CBuilder, depth int) {
    if not enum_has_payload(variants) {
        return
    }
    bwriteln(out, depth, "union {{")
    for v in variants {
        if v.params.len > 0 {
            bwriteln(out, depth + 1, "struct {{ /* " + v.name + " */")
            for p in v.params {
                bwriteln(out, depth + 2, ty_to_c(tynode_to_ty(p.ty)) + " " + variant_field_name(v.name, p.name) + ";")
            }
            bwriteln(out, depth + 1, "}};")
        }
    }
    bwriteln(out, depth, "}};")
}

// enum_has_payload reports whether any variant carries payload fields.
fn enum_has_payload(variants []VariantDef) -> bool {
    for v in variants {
        if v.params.len > 0 {
            return true
        }
    }
    return false
}

// emit_type_fwd emits the forward typedef for a named struct or enum so
// pointer fields and parameters can reference the type before its full
// definition appears (Go emitStructFwd/emitEnumFwd — identical for both).
pub fn emit_type_fwd(name string, out CBuilder, depth int) {
    bwriteln(out, depth, "typedef struct Dot" + name + " Dot" + name + ";")
}

// c_field_name prefixes a Dot field name to avoid conflicts with C keywords
// and Dot builtins (e.g. `len`, `tag`) — Go cFieldName.
fn c_field_name(name string) -> string {
    return "dot_" + name
}

// variant_field_name returns the unique C union member name for one payload
// field of an enum variant (dot_<Variant>_<field>). This is the single
// source of truth for the naming scheme; definition emission and every
// payload access must use it (Go variantFieldName).
fn variant_field_name(variant string, field string) -> string {
    return "dot_" + variant + "_" + field
}

// --- Stage 5a2: Fn/Impl declarations + definitions ---
//
// [РЕШЕНИЕ] Signature types go through ty_to_c, so struct params/returns
// render as `Dot<Name>*` (pointer) — Go's cNamed renders them BY VALUE
// (`DotPoint`, no star; only enums and the receiver are pointers). The
// self-hosted Type has no Enum kind (checker folds enums into Type.Struct)
// and stage 2 locked Struct→`Dot<Name>*` (test c105), so a per-position
// value/pointer split is impossible here; keeping the pointer keeps every
// body emitter (`self->dot_x`) consistent. Reconcile with Go when struct
// value semantics land (stage 6/7).

// [РЕШЕНИЕ] Forward declarations carry parameter TYPES only, no names —
// verified against Go output (`dot build` of tmp_fn.dot): Go emitFuncDecls
// uses emitForwardParams (emit_decl.go:243), while named params belong to
// definitions only (emitParams). Empty param list renders as `void`.
// emit_fn_decl renders one forward declaration. Extern fns (stage 7c2) get
// the `extern` prefix exactly like Go emitFuncDecls (emit_decl.go:334):
// `extern <Ret> Dot_<Name>(<types>);` — parameter TYPES only (void for an
// empty list), the body lives in the C runtime; dot_runtime.h maps the
// Dot_-prefixed name onto the real dot_<file>_<fn> symbol via #define.
pub fn emit_fn_decl(d Decl, out CBuilder, depth int) {
    match d {
        Decl.Fn(name, params, _, ret_ty, _, _) => {
            ret_c = ty_to_c(fn_ret_ty(ret_ty))
            bwriteln(out, depth, ret_c + " Dot_" + name + "(" + fn_decl_params_c(params) + ");")
        }
        Decl.ExternFn(name, params, ret_ty, _) => {
            ret_c = ty_to_c(fn_ret_ty(ret_ty))
            bwriteln(out, depth, "extern " + ret_c + " Dot_" + name + "(" + fn_decl_params_c(params) + ");")
        }
        _ => {}
    }
}

// emit_fn_def renders one free function definition (Go emitFuncDef):
// `Ret Dot_<Name>(<named params>) { <body> }`. Parameters are registered in
// vars so the body sees their types; a trailing expression statement in a
// value-returning fn is materialised into a temp and returned (Go
// emitBodyStmts tail handling). The public form carries no fn registry
// (stage 7b) — emit_program goes through emit_fn_def_full.
pub fn emit_fn_def(d Decl, out CBuilder, depth int) {
    emit_fn_def_full(d, out, depth, []FnSig{}, []CodegenStructInfo{})
}

fn emit_fn_def_full(d Decl, out CBuilder, depth int, sigs []FnSig, structs []CodegenStructInfo) {
    match d {
        Decl.Fn(name, params, _, ret_ty, body, _) => emit_fn_def_from(name, params, ret_ty, body, out, depth, sigs, structs)
        _ => {}
    }
}

// emit_impl_decl renders forward declarations for every method of an impl
// block (Go emitFuncDecls ImplDecl arm): `Ret Dot_<Recv>_<Method>(<types>);`
// with `Dot<Recv>*` prepended for methods taking self.
pub fn emit_impl_decl(d Decl, out CBuilder, depth int) {
    match d {
        Decl.Impl(_, target, methods, _) => {
            recv = impl_recv_name(target)
            if recv.len == 0 {
                bwriteln(out, depth, "/* <TODO 5b: impl on unsupported target> */")
                return
            }
            emit_impl_decls(recv, methods, 0, out, depth)
        }
        _ => {}
    }
}

// emit_impl_def renders the definitions of all methods of an impl block
// (Go emitFuncDefs ImplDecl arm): `Ret Dot_<Recv>_<Method>(Dot<Recv>* self,
// ...) { <body> }`. self is registered in vars as the struct type so field
// access `self.x` lowers to `self->dot_x`.
pub fn emit_impl_def(d Decl, out CBuilder, depth int) {
    emit_impl_def_full(d, out, depth, []FnSig{}, []CodegenStructInfo{})
}

// emit_impl_def_full is the registry-threading form of emit_impl_def
// (stage 7b: method bodies see the whole program's fn signatures).
fn emit_impl_def_full(d Decl, out CBuilder, depth int, sigs []FnSig, structs []CodegenStructInfo) {
    match d {
        Decl.Impl(_, target, methods, _) => {
            recv = impl_recv_name(target)
            if recv.len == 0 {
                bwriteln(out, depth, "/* <TODO 5b: impl on unsupported target> */")
                return
            }
            emit_impl_defs(recv, methods, 0, out, depth, sigs, structs)
        }
        _ => {}
    }
}

// emit_fn_def_from renders one free fn with its unpacked fields.
fn emit_fn_def_from(name string, params []Param, ret_ty Option[TypeNode], body []Stmt, out CBuilder, depth int, sigs []FnSig, structs []CodegenStructInfo) {
    ret_c = ty_to_c(fn_ret_ty(ret_ty))
    params_c = fn_params_c(params, 0, "")
    bwriteln(out, depth, ret_c + " Dot_" + name + "(" + params_c + ") {{")
    vars = fn_params_vars(params, 0, []VarInfo{})
    emit_fn_body(body, ret_ty, vars, out, depth + 1, sigs, structs)
    bwriteln(out, depth, "}}")
    bwriteln(out, depth, "")
}

fn emit_impl_def_from(target TypeNode, methods []Decl, out CBuilder, depth int, sigs []FnSig, structs []CodegenStructInfo) {
    recv = impl_recv_name(target)
    if recv.len == 0 {
        bwriteln(out, depth, "/* <TODO 5b: impl on unsupported target> */")
        return
    }
    emit_impl_defs(recv, methods, 0, out, depth, sigs, structs)
}

// [РЕШЕНИЕ] Body emission: the self-hosted AST has no ExprBody — the parser
// always builds a []Stmt block (parser.parse_fn_body), so the Go ExprBody
// branch of emitFuncDef does not exist here. Its tail-expression
// equivalent is handled by emit_fn_body: when the fn returns a value and
// its last statement is a non-void expression, that tail is materialised
// into a temp and returned (Go emitBodyStmts). The init statements run
// FIRST so their Lets land in vars — the tail's infer_type must see local
// variables, not just parameters (bug c262). Everything else is emitted
// statement by statement; an empty body renders as an empty C block.
fn emit_fn_body(body []Stmt, ret_ty Option[TypeNode], vars []VarInfo, out CBuilder, depth int, sigs []FnSig, structs []CodegenStructInfo) {
    r_ty = fn_ret_ty(ret_ty)
    ctx0 = StmtCtx { vars, heap: []string{}, unused: 0, ret_ty: r_ty, sigs, structs }
    if body.len == 0 {
        emit_stmts_ctx(body, 0, ctx0, out, depth)
        return
    }
    if is_bad_ret_ty(r_ty) {
        // [РЕШЕНИЕ] ARC: void fns (and bad ret types) release their body's
        // heap locals at the closing brace; a trailing return already
        // released everything (heap is empty), so the cleanup is a no-op.
        inner = emit_stmts_ctx(body, 0, ctx0, out, depth)
        pop_block_heap(inner.heap, 0, out, depth)
        return
    }
    // init = all but the last statement, emitted with vars accumulation
    // (emit_stmts threads Let bindings through); the tail then sees them.
    init = emit_stmts_ctx(body[0..body.len - 1], 0, ctx0, out, depth)
    if fn_body_tail(body[body.len - 1], init, out, depth) {
        return
    }
    last = emit_stmt_ctx(body[body.len - 1], init, out, depth)
    pop_block_heap(last.heap, 0, out, depth)
}

// fn_body_tail materialises one trailing ExprStmt into a `_dot_ret_tail_N`
// temp plus a return. Assignments and void/unknown-typed expressions are
// NOT tails: Go keeps AssignStmt a statement (emitBodyStmts only matches
// ast.ExprStmt), and a void call (print) or untyped expr has no value to
// return. The value lands in the temp BEFORE the scope releases run, so it
// may read locals safely; a tail that is a bare ident moves that local
// (its release is skipped), like emit_return_stmt.
fn fn_body_tail(last Stmt, ctx StmtCtx, out CBuilder, depth int) -> bool {
    match last {
        Stmt.ExprStmt(e, _) => {
            if is_assign_expr(e) {
                return false
            }
            vt = infer_type_full(e, ctx.vars, ctx.sigs, ctx.structs)
            if is_unknown_ty(vt) or is_void_ty(vt) {
                return false
            }
            // [РЕШЕНИЕ] if-EXPRESSION, not an if statement + assignment: a
            // plain `skip = ...` inside an if block would shadow (D53).
            skip = if is_ident_expr(e) { ident_name_of(e) } else { "" }
            // [РЕШЕНИЕ] temp name embeds depth instead of Go's global
            // unusedIdx counter: two tail temps can never share one C scope
            // (one tail per fn body), and depth keeps them unique there.
            tmp = "_dot_ret_tail_" + int_to_str(depth)
            bwriteln(out, depth, ty_to_c(vt) + " " + tmp + " = " + emit_expr_full(e, ctx.vars, ctx.sigs, ctx.structs) + ";")
            emit_return_releases(ctx.heap, skip, out, depth)
            bwriteln(out, depth, "return " + tmp + ";")
            return true
        }
        _ => {}
    }
    return false
}

// impl_recv_name extracts the receiver struct name from the impl target
// TypeNode; "" marks a target the codegen cannot lower (generic inst).
fn impl_recv_name(target TypeNode) -> string {
    return match target {
        TypeNode.Named(name, _) => name
        _ => ""
    }
}

fn emit_impl_decls(recv string, methods []Decl, i int, out CBuilder, depth int) {
    if i >= methods.len {
        return
    }
    emit_method_decl(recv, methods[i], out, depth)
    emit_impl_decls(recv, methods, i + 1, out, depth)
}

fn emit_impl_defs(recv string, methods []Decl, i int, out CBuilder, depth int, sigs []FnSig, structs []CodegenStructInfo) {
    if i >= methods.len {
        return
    }
    emit_method_def(recv, methods[i], out, depth, sigs, structs)
    emit_impl_defs(recv, methods, i + 1, out, depth, sigs, structs)
}

fn emit_method_decl(recv string, m Decl, out CBuilder, depth int) {
    match m {
        Decl.Fn(name, params, _, ret_ty, _, _) => {
            ret_c = ty_to_c(fn_ret_ty(ret_ty))
            bwriteln(out, depth, ret_c + " Dot_" + recv + "_" + name + "(" + method_decl_params_c(recv, params) + ");")
        }
        _ => {}
    }
}

fn emit_method_def(recv string, m Decl, out CBuilder, depth int, sigs []FnSig, structs []CodegenStructInfo) {
    match m {
        Decl.Fn(name, params, _, ret_ty, body, _) => {
            ret_c = ty_to_c(fn_ret_ty(ret_ty))
            bwriteln(out, depth, ret_c + " Dot_" + recv + "_" + name + "(" + method_params_c(recv, params) + ") {{")
            vars = method_body_vars(recv, params)
            emit_fn_body(body, ret_ty, vars, out, depth + 1, sigs, structs)
            bwriteln(out, depth, "}}")
            bwriteln(out, depth, "")
        }
        _ => {}
    }
}

// method_has_self reports whether the method takes the `self` receiver.
// The self-hosted AST keeps self as the first regular Param (parser
// parse_params names it "self"), unlike Go's separate Sig.Recv — the
// convention here is exactly params[0].name == "self".
fn method_has_self(params []Param) -> bool {
    if params.len == 0 {
        return false
    }
    return str_eq(params[0].name, "self")
}

fn method_param_start(params []Param) -> int {
    if method_has_self(params) {
        return 1
    }
    return 0
}

// fn_params_c renders the named C parameter list of a definition
// (`TY name, ...`, Go emitParams); an empty list renders as "" — Go
// definitions use bare parens, only declarations use `void`.
fn fn_params_c(params []Param, i int, acc string) -> string {
    if i >= params.len {
        return acc
    }
    p = ty_to_c(tynode_to_ty(params[i].ty)) + " " + params[i].name
    if acc.len == 0 {
        return fn_params_c(params, i + 1, p)
    }
    return fn_params_c(params, i + 1, acc + ", " + p)
}

// fn_param_types_c renders the type-only C parameter list of a forward
// declaration (Go emitForwardParams).
fn fn_param_types_c(params []Param, i int, acc string) -> string {
    if i >= params.len {
        return acc
    }
    p = ty_to_c(tynode_to_ty(params[i].ty))
    if acc.len == 0 {
        return fn_param_types_c(params, i + 1, p)
    }
    return fn_param_types_c(params, i + 1, acc + ", " + p)
}

// fn_decl_params_c: forward-declaration params render as `void` when empty
// (Go emitForwardParams emit_decl.go:245).
fn fn_decl_params_c(params []Param) -> string {
    if params.len == 0 {
        return "void"
    }
    return fn_param_types_c(params, 0, "")
}

// method_params_c renders the named C parameter list of a method
// definition: `Dot<Recv>* self` first when the method takes self.
fn method_params_c(recv string, params []Param) -> string {
    rest = fn_params_c(params, method_param_start(params), "")
    if method_has_self(params) {
        if rest.len == 0 {
            return "Dot" + recv + "* self"
        }
        return "Dot" + recv + "* self, " + rest
    }
    return rest
}

// method_decl_params_c renders the type-only C parameter list of a method
// forward declaration: `Dot<Recv>*` first when the method takes self
// (Go emitFuncDecls prepends the receiver type to emitForwardParams).
fn method_decl_params_c(recv string, params []Param) -> string {
    if method_has_self(params) {
        rest = fn_param_types_c(params, 1, "")
        if rest.len == 0 {
            return "Dot" + recv + "*"
        }
        return "Dot" + recv + "*" + ", " + rest
    }
    return fn_decl_params_c(params)
}

// fn_params_vars registers params[i..] as VarInfo locals.
fn fn_params_vars(params []Param, i int, vars []VarInfo) -> []VarInfo {
    if i >= params.len {
        return vars
    }
    vars.push(VarInfo { name: params[i].name, ty: tynode_to_ty(params[i].ty) })
    return fn_params_vars(params, i + 1, vars)
}

// method_body_vars registers the method locals: self first (so `self.x`
// lowers through the Struct branch of emit_field), then the explicit params.
fn method_body_vars(recv string, params []Param) -> []VarInfo {
    vars = []VarInfo{}
    if method_has_self(params) {
        vars.push(VarInfo { name: "self", ty: Type.Struct(recv) })
    }
    return fn_params_vars(params, method_param_start(params), vars)
}

// fn_ret_ty resolves the declared return Type; no annotation means void.
fn fn_ret_ty(ret_ty Option[TypeNode]) -> Type {
    if r = ret_ty {
        return tynode_to_ty(r)
    }
    return Type.Void
}

// is_bad_ret_ty: void/unknown/error return types never get a materialised
// tail (Go emitBodyStmts want==nil/invalid/void guard).
fn is_bad_ret_ty(t Type) -> bool {
    return match t {
        Type.Void => true
        Type.Unknown => true
        Type.Error => true
        _ => false
    }
}

fn is_void_ty(t Type) -> bool {
    return match t {
        Type.Void => true
        _ => false
    }
}

// --- Stage 5b: emit_program — the C translation-unit driver ---
//
// Port of Go codegen.go emitAll: the fixed phase order is header → type
// forwards → type definitions → fn/impl prototypes → fn/impl definitions →
// main(), so every C reference has a prior declaration (Go emitTypes,
// emitFuncDecls, emitFunctionBodies, emitMain).

// emit_program renders a complete C translation unit from a checked
// program ([]Decl) and returns the C source as a string.
pub fn emit_program(decls []Decl) -> string {
    out = new_builder()
    bwriteln(out, 0, "#include \"dot_runtime.h\"")
    bwriteln(out, 0, "")
    emit_type_fwds(decls, out)
    emit_type_defs(decls, out)
    emit_fn_decls(decls, out)
    structs = collect_structs(decls)
    emit_fn_defs(decls, out, collect_sigs(decls), structs)
    emit_main_driver(decls, out)
    return bfinish(out)
}

// collect_sigs builds the fn signature registry (stage 7b): every free fn
// contributes FnSig { name, ret }, every impl method contributes
// FnSig { Recv_Method, ret } — the same name spelling emit_method_def
// emits ("Dot_" + recv + "_" + name) so call sites and definitions agree.
// fn_ret_ty resolves the declared annotation (absent = void).
fn collect_sigs(decls []Decl) -> []FnSig {
    return collect_sigs_from(decls, 0, []FnSig{})
}

fn collect_sigs_from(decls []Decl, i int, acc []FnSig) -> []FnSig {
    if i >= decls.len {
        return acc
    }
    next = match decls[i] {
        Decl.Fn(name, _, _, ret_ty, _, _) => fn_sig_list(acc, name, fn_ret_ty(ret_ty))
        Decl.Impl(_, target, methods, _) => impl_sigs(impl_recv_name(target), methods, acc)
        _ => acc
    }
    return collect_sigs_from(decls, i + 1, next)
}

fn fn_sig_list(sigs []FnSig, name string, ret Type) -> []FnSig {
    sigs.push(FnSig { name, ret })
    return sigs
}

fn impl_sigs(recv string, methods []Decl, sigs []FnSig) -> []FnSig {
    if recv.len == 0 {
        return sigs
    }
    return impl_sigs_from(methods, 0, recv, sigs)
}

fn impl_sigs_from(methods []Decl, i int, recv string, sigs []FnSig) -> []FnSig {
    if i >= methods.len {
        return sigs
    }
    next = match methods[i] {
        Decl.Fn(name, _, _, ret_ty, _, _) => fn_sig_list(sigs, recv + "_" + name, fn_ret_ty(ret_ty))
        _ => sigs
    }
    return impl_sigs_from(methods, i + 1, recv, next)
}

// collect_structs builds the struct field registry (stage 7d-C): every
// Decl.Struct contributes CodegenStructInfo { name, fields } with field
// types resolved through tynode_to_ty (the same resolver fn params use).
// Enums are NOT included: the checker folds them into Type.Struct, but
// their payload fields live in variant-specific unions, not plain fields.
fn collect_structs(decls []Decl) -> []CodegenStructInfo {
    return collect_structs_from(decls, 0, []CodegenStructInfo{})
}

fn collect_structs_from(decls []Decl, i int, acc []CodegenStructInfo) -> []CodegenStructInfo {
    if i >= decls.len {
        return acc
    }
    next = match decls[i] {
        Decl.Struct(name, fields, _) => struct_info_list(acc, name, fields)
        _ => acc
    }
    return collect_structs_from(decls, i + 1, next)
}

fn struct_info_list(acc []CodegenStructInfo, name string, fields []FieldDef) -> []CodegenStructInfo {
    acc.push(CodegenStructInfo { name, fields: struct_field_infos(fields, 0, []StructFieldInfo{}) })
    return acc
}

fn struct_field_infos(fields []FieldDef, i int, acc []StructFieldInfo) -> []StructFieldInfo {
    if i >= fields.len {
        return acc
    }
    acc.push(StructFieldInfo { name: fields[i].name, ty: tynode_to_ty(fields[i].ty) })
    return struct_field_infos(fields, i + 1, acc)
}

// Phase 1: forward typedefs for every named struct/enum so pointer fields
// and signatures can reference types defined later (Go emitStructFwd /
// emitEnumFwd — identical forms, grouped before all definitions).
fn emit_type_fwds(decls []Decl, out CBuilder) {
    for d in decls {
        match d {
            Decl.Struct(name, _, _) => emit_type_fwd(name, out, 0)
            Decl.Enum(name, _, _) => emit_type_fwd(name, out, 0)
            _ => {}
        }
    }
}

// Phase 2: full struct/enum definitions; traits stay a TODO marker until
// the vtable pass (stage 6/7).
fn emit_type_defs(decls []Decl, out CBuilder) {
    for d in decls {
        match d {
            Decl.Struct(name, fields, _) => emit_struct_def(name, fields, out, 0)
            Decl.Enum(name, variants, _) => emit_enum_def(name, variants, out, 0)
            Decl.Trait(name, _, _) => bwriteln(out, 0, "/* <TODO 5b: trait vtable " + name + "> */")
            _ => {}
        }
    }
}

// Phase 3: prototypes of every free fn and impl method. The per-decl
// emitters no-op on non-matching Decl variants, so no dispatch is needed.
fn emit_fn_decls(decls []Decl, out CBuilder) {
    for d in decls {
        emit_fn_decl(d, out, 0)
        emit_impl_decl(d, out, 0)
    }
}

// Phase 4: definitions of every free fn and impl method. sigs threads the
// program-wide fn signature registry into the body emitters (stage 7b).
fn emit_fn_defs(decls []Decl, out CBuilder, sigs []FnSig, structs []CodegenStructInfo) {
    for d in decls {
        emit_fn_def_full(d, out, 0, sigs, structs)
        emit_impl_def_full(d, out, 0, sigs, structs)
    }
}

// Phase 5: the C entry point (Go emitMain, codegen.go:320). The exact line
// set and indentation were verified against the Go compiler's real output
// on testdata/hello.dot (`dot build`).
fn emit_main_driver(decls []Decl, out CBuilder) {
    bwriteln(out, 0, "int main(void) {{")
    bwriteln(out, 1, "async_init();")
    if has_main_fn(decls) {
        bwriteln(out, 1, "Dot_main();")
    } else {
        bwriteln(out, 1, "/* no main function defined */")
    }
    bwriteln(out, 1, "async_run();")
    bwriteln(out, 1, "dot_atexit_cleanup();")
    bwriteln(out, 1, "return 0;")
    bwriteln(out, 0, "}}")
}

// has_main_fn reports whether the program defines fn main (Go emitMain
// hasMain scan over prog.Decls).
fn has_main_fn(decls []Decl) -> bool {
    for d in decls {
        if decl_is_main(d) {
            return true
        }
    }
    return false
}

fn decl_is_main(d Decl) -> bool {
    return match d {
        Decl.Fn(name, _, _, _, _, _) => str_eq(name, "main")
        _ => false
    }
}
