struct HashMap {
    keys []string
    values []string
    occupied []bool
    count int
    capacity int
}

fn string_eq(a string, b string) -> bool {
    if a.len != b.len {
        return false
    }
    i = 0
    for i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    return true
}

fn hash_string(s string) -> int {
    hash = 2166136261
    i = 0
    for i < s.len {
        (hash) = hash ^ (s[i] as int)
        (hash) = hash * 16777619
        i += 1
    }
    if hash < 0 {
        (hash) = -hash
    }
    return hash
}

impl HashMap {
    fn new() -> HashMap {
        new_keys = []string{}
        new_values = []string{}
        new_occupied = []bool{}
        i = 0
        for i < 16 {
            new_keys.push("")
            new_values.push("")
            new_occupied.push(false)
            i += 1
        }
        return HashMap {
            keys: new_keys,
            values: new_values,
            occupied: new_occupied,
            count: 0,
            capacity: 16
        }
    }

    fn put(mut self, key string, value string) {
        h = hash_string(key)
        index = h % self.capacity
        
        start_index = index
        for {
            should_update = false
            if not self.occupied[index] {
                (should_update) = true
                self.count += 1
            } else if string_eq(self.keys[index], key) {
                (should_update) = true
            }
            
            if should_update {
                new_keys = []string{}
                new_values = []string{}
                new_occupied = []bool{}
                
                i = 0
                for i < self.capacity {
                    if i == index {
                        new_keys.push(key)
                        new_values.push(value)
                        new_occupied.push(true)
                    } else {
                        new_keys.push(self.keys[i])
                        new_values.push(self.values[i])
                        new_occupied.push(self.occupied[i])
                    }
                    i += 1
                }
                
                self.keys = new_keys
                self.values = new_values
                self.occupied = new_occupied
                return
            }
            
            (index) = (index + 1) % self.capacity
            if index == start_index {
                return
            }
        }
    }

    fn get(self, key string) -> string {
        h = hash_string(key)
        index = h % self.capacity
        
        start_index = index
        for {
            if not self.occupied[index] {
                return ""
            }
            if string_eq(self.keys[index], key) {
                return self.values[index]
            }
            (index) = (index + 1) % self.capacity
            if index == start_index {
                return ""
            }
        }
        return ""
    }

    fn contains(self, key string) -> bool {
        h = hash_string(key)
        index = h % self.capacity
        
        start_index = index
        for {
            if not self.occupied[index] {
                return false
            }
            if string_eq(self.keys[index], key) {
                return true
            }
            (index) = (index + 1) % self.capacity
            if index == start_index {
                return false
            }
        }
        return false
    }
}
