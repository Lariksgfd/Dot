// stdlib/codegen.dot - C code generation helpers (self-hosting skeleton).

pub struct CBuilder {
    buf []byte
}

fn str_eq(a string, b string) -> bool {
    if a.len != b.len {
        return false
    }
    i = 0
    for i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    return true
}

fn str_concat(a string, b string) -> string {
    bld = new_builder()
    bwrite(bld, a)
    bwrite(bld, b)
    return bfinish(bld)
}

fn str_starts_with(s string, prefix string) -> bool {
    if prefix.len > s.len {
        return false
    }
    i = 0
    for i < prefix.len {
        if s[i] != prefix[i] {
            return false
        }
        i += 1
    }
    return true
}

fn str_ends_with(s string, suffix string) -> bool {
    if suffix.len > s.len {
        return false
    }
    offset = s.len - suffix.len
    i = 0
    for i < suffix.len {
        if s[offset + i] != suffix[i] {
            return false
        }
        i += 1
    }
    return true
}

fn str_contains(s string, sub string) -> bool {
    return str_index_of(s, sub) >= 0
}

fn str_index_of(s string, sub string) -> int {
    if sub.len == 0 {
        return 0
    }
    if sub.len > s.len {
        return -1
    }
    i = 0
    for i <= s.len - sub.len {
        if str_match_at(s, sub, i) {
            return i
        }
        i += 1
    }
    return -1
}

fn str_match_at(s string, sub string, pos int) -> bool {
    j = 0
    for j < sub.len {
        if s[pos + j] != sub[j] {
            return false
        }
        j += 1
    }
    return true
}

fn new_builder() -> CBuilder {
    buf = []byte{}
    return CBuilder { buf }
}

fn bwrite(b CBuilder, s string) {
    i = 0
    for i < s.len {
        b.buf.push(s[i] as uint8)
        i += 1
    }
}

fn bfinish(b CBuilder) -> string {
    return b.buf as string
}

fn type_to_c(t string) -> string {
    if str_eq(t, "int") { return "int64_t" }
    if str_eq(t, "int8") { return "int8_t" }
    if str_eq(t, "int16") { return "int16_t" }
    if str_eq(t, "int32") { return "int32_t" }
    if str_eq(t, "uint") { return "uint64_t" }
    if str_eq(t, "uint8") { return "uint8_t" }
    if str_eq(t, "uint16") { return "uint16_t" }
    if str_eq(t, "uint32") { return "uint32_t" }
    if str_eq(t, "float") { return "double" }
    if str_eq(t, "float32") { return "float" }
    if str_eq(t, "bool") { return "bool" }
    if str_eq(t, "byte") { return "uint8_t" }
    if str_eq(t, "rune") { return "int32_t" }
    if str_eq(t, "string") { return "DotString*" }
    if str_eq(t, "void") { return "void" }
    if str_eq(t, "never") { return "void" }
    return "void*"
}

fn int_to_str(n int) -> string {
    if n == 0 {
        return "0"
    }
    b = new_builder()
    if n < 0 {
        bwrite(b, "-")
        int_digits(b, -n)
        return bfinish(b)
    }
    int_digits(b, n)
    return bfinish(b)
}

fn int_digits(b CBuilder, n int) {
    if n >= 10 {
        int_digits(b, n / 10)
    }
    b.buf.push(((n % 10 + 48) as uint8))
}

fn c_escape_into(b CBuilder, s string) {
    i = 0
    for i < s.len {
        c = s[i]
        if c == 34 {
            bwrite(b, "\\\"")
        } else if c == 92 {
            bwrite(b, "\\\\")
        } else if c == 10 {
            bwrite(b, "\\n")
        } else if c == 13 {
            bwrite(b, "\\r")
        } else if c == 9 {
            bwrite(b, "\\t")
        } else if c < 32 or c > 126 {
            c_escape_octal(b, c as uint8)
        } else {
            b.buf.push(c as uint8)
        }
        i += 1
    }
}

fn c_escape_octal(b CBuilder, c uint8) {
    n = c as int
    b.buf.push(92 as uint8)
    b.buf.push((48 + n / 64) as uint8)
    b.buf.push((48 + (n / 8) % 8) as uint8)
    b.buf.push((48 + n % 8) as uint8)
}

fn literal_to_c(lit string, ty string) -> string {
    if str_eq(ty, "bool") {
        if str_eq(lit, "true") {
            return "true"
        }
        return "false"
    }
    if str_eq(ty, "string") {
        b = new_builder()
        c_escape_into(b, lit)
        return "dot_string_from_lit(\"" + bfinish(b) + "\", " + int_to_str(lit.len) + ")"
    }
    if str_eq(ty, "float32") {
        if lit.len > 0 {
            if lit[lit.len - 1] != 102 {
                return lit + "f"
            }
        }
    }
    return lit
}

fn binop_to_c(op string, lhs string, rhs string) -> string {
    return binop_typed_to_c(op, lhs, rhs, "", "")
}

fn binop_typed_to_c(op string, lhs string, rhs string, lty string, rty string) -> string {
    is_str = str_eq(lty, "string") or str_eq(rty, "string")
    if str_eq(op, "+") {
        if is_str {
            return "dot_string_concat(" + lhs + ", " + rhs + ")"
        }
        return "(" + lhs + " + " + rhs + ")"
    }
    if str_eq(op, "-") {
        return "(" + lhs + " - " + rhs + ")"
    }
    if str_eq(op, "*") {
        return "(" + lhs + " * " + rhs + ")"
    }
    if str_eq(op, "/") {
        return "(" + lhs + " / " + rhs + ")"
    }
    if str_eq(op, "%") {
        return "(" + lhs + " % " + rhs + ")"
    }
    if str_eq(op, "**") {
        if str_eq(lty, "float") or str_eq(lty, "float32") {
            return "dot_pow_float(" + lhs + ", " + rhs + ")"
        }
        return "dot_pow_int(" + lhs + ", " + rhs + ")"
    }
    if str_eq(op, "==") {
        if is_str {
            return "dot_string_eq(" + lhs + ", " + rhs + ")"
        }
        return "(" + lhs + " == " + rhs + ")"
    }
    if str_eq(op, "!=") {
        if is_str {
            return "!dot_string_eq(" + lhs + ", " + rhs + ")"
        }
        return "(" + lhs + " != " + rhs + ")"
    }
    if str_eq(op, "<") {
        return "(" + lhs + " < " + rhs + ")"
    }
    if str_eq(op, ">") {
        return "(" + lhs + " > " + rhs + ")"
    }
    if str_eq(op, "<=") {
        return "(" + lhs + " <= " + rhs + ")"
    }
    if str_eq(op, ">=") {
        return "(" + lhs + " >= " + rhs + ")"
    }
    if str_eq(op, "and") {
        return "(" + lhs + " && " + rhs + ")"
    }
    if str_eq(op, "or") {
        return "(" + lhs + " || " + rhs + ")"
    }
    if str_eq(op, "&") {
        return "(" + lhs + " & " + rhs + ")"
    }
    if str_eq(op, "|") {
        return "(" + lhs + " | " + rhs + ")"
    }
    if str_eq(op, "^") {
        return "(" + lhs + " ^ " + rhs + ")"
    }
    if str_eq(op, "<<") {
        return "(" + lhs + " << " + rhs + ")"
    }
    if str_eq(op, ">>") {
        return "(" + lhs + " >> " + rhs + ")"
    }
    return "(" + lhs + " " + op + " " + rhs + ")"
}

fn ifexpr_to_c(cond string, then string, els string) -> string {
    return "((" + cond + ") ? (" + then + ") : (" + els + "))"
}

fn binop_prec(op string) -> int {
    if str_eq(op, "*") or str_eq(op, "/") or str_eq(op, "%") {
        return 4
    }
    if str_eq(op, "+") or str_eq(op, "-") {
        return 5
    }
    if str_eq(op, "<<") or str_eq(op, ">>") {
        return 6
    }
    if str_eq(op, "&") {
        return 7
    }
    if str_eq(op, "^") {
        return 8
    }
    if str_eq(op, "|") {
        return 9
    }
    if str_eq(op, "==") or str_eq(op, "!=") or str_eq(op, "<") or str_eq(op, ">") or str_eq(op, "<=") or str_eq(op, ">=") {
        return 11
    }
    if str_eq(op, "and") {
        return 12
    }
    if str_eq(op, "or") {
        return 13
    }
    return 0
}

fn param_name(p string) -> string {
    b = new_builder()
    i = 0
    for i < p.len {
        if p[i] == 58 {
            break
        }
        b.buf.push(p[i] as uint8)
        i += 1
    }
    return bfinish(b)
}

fn param_type(p string) -> string {
    b = new_builder()
    i = 0
    for i < p.len {
        if p[i] == 58 {
            break
        }
        i += 1
    }
    if i >= p.len {
        return "void*"
    }
    i += 1
    for i < p.len {
        b.buf.push(p[i] as uint8)
        i += 1
    }
    return bfinish(b)
}

fn fndecl_to_c(name string, ret string, params []string) -> string {
    b = new_builder()
    bwrite(b, type_to_c(ret))
    bwrite(b, " Dot_")
    bwrite(b, name)
    bwrite(b, "(")
    if params.len == 0 {
        bwrite(b, "void")
    }
    i = 0
    for i < params.len {
        if i > 0 {
            bwrite(b, ", ")
        }
        bwrite(b, type_to_c(param_type(params[i])))
        bwrite(b, " ")
        bwrite(b, param_name(params[i]))
        i += 1
    }
    bwrite(b, ")")
    return bfinish(b)
}

fn retstmt_to_c(expr string) -> string {
    if expr.len == 0 {
        return "return;"
    }
    return "return " + expr + ";"
}

fn vardecl_to_c(name string, ty string, init string) -> string {
    if init.len == 0 {
        return type_to_c(ty) + " " + name + ";"
    }
    return type_to_c(ty) + " " + name + " = " + init + ";"
}

fn assign_to_c(target string, expr string) -> string {
    return target + " = " + expr + ";"
}

fn for_to_c(init string, cond string, post string, body string) -> string {
    b = new_builder()
    bwrite(b, "for (")
    bwrite(b, init)
    bwrite(b, "; ")
    bwrite(b, cond)
    bwrite(b, "; ")
    bwrite(b, post)
    bwrite(b, ") {{\n")
    bwrite(b, body)
    bwrite(b, "\n}}")
    return bfinish(b)
}

fn match_cond_to_c(subj string, subj_ty string, pat string) -> string {
    if str_eq(subj_ty, "string") {
        return "dot_string_eq(" + subj + ", " + literal_to_c(pat, "string") + ")"
    }
    return "(" + subj + " == " + pat + ")"
}

fn match_body_of(bodies []string, i int) -> string {
    if i < bodies.len {
        return bodies[i]
    }
    return "/* no body */"
}

fn match_to_c(subj string, subj_ty string, patterns []string, bodies []string) -> string {
    if patterns.len == 0 {
        return "{{}}"
    }
    if str_eq(patterns[0], "_") {
        return "{{ \n" + match_body_of(bodies, 0) + "\n}}"
    }
    b = new_builder()
    bwrite(b, "if (")
    bwrite(b, match_cond_to_c(subj, subj_ty, patterns[0]))
    bwrite(b, ") {{\n")
    bwrite(b, match_body_of(bodies, 0))
    bwrite(b, "\n")
    i = 1
    for i < patterns.len {
        if str_eq(patterns[i], "_") {
            bwrite(b, "}} else {{\n")
            bwrite(b, match_body_of(bodies, i))
            bwrite(b, "\n")
        } else {
            bwrite(b, "}} else if (")
            bwrite(b, match_cond_to_c(subj, subj_ty, patterns[i]))
            bwrite(b, ") {{\n")
            bwrite(b, match_body_of(bodies, i))
            bwrite(b, "\n")
        }
        i += 1
    }
    bwrite(b, "}}")
    return bfinish(b)
}

fn named_type_to_c(t string) -> string {
    c = type_to_c(t)
    if str_eq(c, "void*") {
        return "Dot" + t
    }
    return c
}

fn struct_to_c(name string, fields []string) -> string {
    b = new_builder()
    bwrite(b, "typedef struct {{\n")
    i = 0
    for i < fields.len {
        bwrite(b, "    ")
        bwrite(b, named_type_to_c(param_type(fields[i])))
        bwrite(b, " ")
        bwrite(b, param_name(fields[i]))
        bwrite(b, ";\n")
        i += 1
    }
    bwrite(b, "}} ")
    bwrite(b, name)
    bwrite(b, ";")
    return bfinish(b)
}

fn method_to_c(struct_name string, method_name string, ret string, params []string) -> string {
    b = new_builder()
    bwrite(b, named_type_to_c(ret))
    bwrite(b, " Dot_")
    bwrite(b, struct_name)
    bwrite(b, "_")
    bwrite(b, method_name)
    bwrite(b, "(Dot")
    bwrite(b, struct_name)
    bwrite(b, "* self")
    i = 0
    for i < params.len {
        bwrite(b, ", ")
        bwrite(b, named_type_to_c(param_type(params[i])))
        bwrite(b, " ")
        bwrite(b, param_name(params[i]))
        i += 1
    }
    bwrite(b, ")")
    return bfinish(b)
}

fn generic_mangle(fn_name string, type_args []string) -> string {
    b = new_builder()
    bwrite(b, fn_name)
    bwrite(b, "__")
    i = 0
    for i < type_args.len {
        if i > 0 {
            bwrite(b, "_")
        }
        bwrite(b, type_args[i])
        i += 1
    }
    return bfinish(b)
}

fn struct_literal_to_c(struct_name string, fields []string, values []string) -> string {
    b = new_builder()
    bwrite(b, "((Dot")
    bwrite(b, struct_name)
    bwrite(b, "){{ ")
    i = 0
    for i < fields.len {
        if i > 0 {
            bwrite(b, ", ")
        }
        bwrite(b, ".")
        bwrite(b, fields[i])
        bwrite(b, " = ")
        if i < values.len {
            bwrite(b, values[i])
        } else {
            bwrite(b, "0")
        }
        i += 1
    }
    bwrite(b, " }})")
    return bfinish(b)
}
