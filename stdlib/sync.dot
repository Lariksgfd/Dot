// sync module

pub struct Chan {
    items []int
}

fn create_channel[T]() -> Chan {
    return Chan { items: []int{} }
}

impl Chan {
    pub fn send(mut self, val int) {
        self.items.push(val)
    }

    pub fn try_recv(mut self) -> (int, bool) {
        if self.items.len == 0 {
            return 0, false
        }
        v = self.items[0]
        self.items = self.items[1..self.items.len]
        return v, true
    }

    pub fn close(self) {
    }
}
